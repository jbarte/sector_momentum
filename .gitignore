# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Data cache (large files)
data/cache/*
!data/cache/.gitkeep
data/cache/*.parquet

# Backtest cache (isolated long-history fetch — not committed)
data/backtest_cache/

# momentum.db is generated locally from Supabase data — not committed
data/momentum.db
data/momentum.db-wal
data/momentum.db-shm

# Dashboard assets (large downloaded binary — fetched on first run)
dashboard/assets/plotly.min.js
dashboard/assets/supabase.min.js

# Worktrees
.worktrees/

# Scan reports — generated on demand from DB, not committed
/reports/

# Published dashboard — generated by dashboard/build.py, deployed via
# GitHub Pages Actions artifact (see .github/workflows/{scan,build-docs}.yml).
# No longer committed — see design/specs/2026-07-20-pages-artifact-deploy-design.md.
/docs/

# Claude Code internal files — except commands/, which are shared and versioned
.claude/*
!.claude/commands/

# DB backups now live in Supabase Storage, not git.
backups/
.superpowers/

# Research/report script output (scripts/walkforward_weights.py,
# scripts/regime_research.py, scripts/horizon_sweep.py, scripts/ucits_tracking_monitor.py)
# -- this is a public repo; research findings live in the private notes repo instead.
# horizon_sweep.md was a pre-existing gap here (found 2026-08-30 while fixing
# this for ucits_tracking.md) -- never bitten because it has always been run
# with an explicit --out pointed elsewhere in practice, not because the default
# was safe.
/walkforward_weights.md
/regime_research.md
/horizon_sweep.md
/ucits_tracking.md

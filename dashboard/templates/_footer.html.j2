{% if health %}
<details class="health-panel"{% if health_any_warn %} open{% endif %}>
  <summary>
    {% if health_any_warn %}<span class="health-warn-dot" title="Degraded data source">&#9888;</span> {% endif %}Data Health &mdash; Last scan: {{ health.run_at[:19] }} UTC{% if health.duration_s is not none %} ({{ health.duration_s | round(0) | int }}s){% endif %}
  </summary>
  <div class="health-grid">
    <div class="health-row">
      <span class="health-label">Prices</span>
      <span class="health-values">
        yfinance {{ health.prices_yfinance or 0 }}
        &middot; cache {{ health.prices_cache or 0 }}
        &middot; failed <span class="badge-{{ health_badges.prices or 'green' }}">{{ health.prices_failed or 0 }}</span>
      </span>
    </div>
    <div class="health-row">
      <span class="health-label">Themes</span>
      <span class="health-values">
        <span class="badge-{{ health_badges.coverage or 'green' }}">{{ health.sectors_produced or '?' }}/{{ health.sectors_expected or '?' }}</span> signals produced
      </span>
    </div>
    <div class="health-row">
      <span class="health-label">Sentiment</span>
      <span class="health-values">
        {% if health.finbert_scored is not none %}
          FinBERT <span class="badge-{{ health_badges.finbert or 'green' }}">{{ health.finbert_scored }}/{{ health.finbert_total }}</span> scored
          &middot; {{ health.gdelt_articles or 0 }} GDELT articles
        {% else %}
          <span class="health-muted">Skipped</span>
        {% endif %}
      </span>
    </div>
  </div>
</details>
{% elif health is defined %}
<div class="health-panel health-muted">No health data available for this scan.</div>
{% endif %}

<footer class="site-footer">
  <span data-i18n="disclaimer">Analytical tooling, not investment advice.</span>
  <button type="button" id="methodology-link" class="footer-link">Methodology</button>
  {#- Inside {% if auth %} so guests never get a link to a dialog that cannot
      exist. It also starts `hidden` and is revealed by alert-prefs.js only once
      alerts are actually available for this reader — a signed-in user whose
      alert_prefs table is missing would otherwise open an empty dialog. -#}
  {% if auth %}
  <button type="button" id="alerts-link" class="footer-link" hidden data-i18n="alerts_title">Alerts</button>
  {% endif %}
</footer>
{% if auth %}
{#- Alerts modal.
    ------------
    Was a permanently-rendered block sitting BELOW the footer — after the
    disclaimer and Methodology link — which is an odd reading order and an odd
    home for a control only signed-in readers can use. Now a modal opened from
    the footer, mirroring the Methodology treatment beside it.

    The overlay is a NEW wrapper with #alert-prefs nested inside, deliberately:
    alert-prefs.js owns that section's `hidden` attribute to mean "alerts are
    available to this reader", while a modal overlay uses `hidden` to mean
    "closed". Collapsing the two elements would collide those meanings. -#}
<div class="methodology-overlay" id="alerts-modal" hidden>
  <div class="methodology-modal" role="dialog" aria-modal="true" aria-labelledby="alerts-title">
    <button type="button" class="methodology-close" id="alerts-close" aria-label="Close">&times;</button>
    <h2 id="alerts-title" data-i18n="alerts_title">Alerts</h2>
<section id="alert-prefs" class="alert-prefs" hidden>
  <p class="alert-prefs-intro" data-i18n="alerts_intro">Get a push notification after each scan: Exit signals for themes you hold, plus new Enter signals.</p>
  <div id="alert-prefs-off" hidden>
    <button type="button" id="alert-prefs-enable" class="lang-toggle" data-i18n="alerts_enable">Enable alerts</button>
  </div>
  <div id="alert-prefs-on" hidden>
    <div class="alert-prefs-topic">
      <code id="alert-prefs-topic"></code>
      <button type="button" id="alert-prefs-copy" class="lang-toggle" data-i18n="alerts_copy">Copy</button>
    </div>
    <p class="alert-prefs-help">
      <span data-i18n="alerts_help">Install the ntfy app and subscribe to this topic.</span>
      <a id="alert-prefs-link" href="#" target="_blank" rel="noopener noreferrer">ntfy.sh</a>
    </p>
    <p class="alert-prefs-warn" data-i18n="alerts_warn">Anyone who knows this topic name can read these notifications. Don't share it — regenerate if it leaks.</p>
    <label class="alert-prefs-toggle">
      <input type="checkbox" id="alert-prefs-enabled"> <span data-i18n="alerts_enabled_label">Alerts enabled</span>
    </label>
    <button type="button" id="alert-prefs-regen" class="lang-toggle" data-i18n="alerts_regen">Regenerate</button>
  </div>
  <p id="alert-prefs-status" class="alert-prefs-status" aria-live="polite"></p>
</section>
  </div>
</div>
<script>
{% include "_modal.js.j2" %}
(function () {
  var overlay = document.getElementById("alerts-modal");
  if (!overlay) { return; }
  var modal = window.SMModal.bind(overlay, {
    closeBtn: document.getElementById("alerts-close"),
  });
  if (!modal) { return; }
  // Exposed so alert-prefs.js can open it on #alerts once it knows alerts are
  // available — the deep link has to wait for that, since the dialog is empty
  // until then.
  window.SMAlertsModal = modal;

  function bindTrigger() {
    var link = document.getElementById("alerts-link");
    if (link) {
      link.addEventListener("click", function (e) { e.preventDefault(); modal.open(); });
    }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindTrigger);
  } else {
    bindTrigger();
  }
})();
</script>
<script>window.SUPABASE_CONFIG = {{ auth_config_json | js_json }};</script>
<script src="assets/supabase.min.js"></script>
<script src="assets/auth.js"></script>
<script src="assets/positions.js"></script>
<script src="assets/alert-prefs.js"></script>
{% endif %}

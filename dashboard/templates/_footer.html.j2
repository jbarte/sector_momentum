{% if health %}
<details class="health-panel"{% if health_any_warn %} open{% endif %}>
  <summary>
    {% if health_any_warn %}<span class="health-warn-dot" title="Degraded data source">&#9888;</span> {% endif %}Data Health &mdash; Last scan: {{ health.run_at[:19] }} UTC{% if health.duration_s is not none %} ({{ health.duration_s | round(0) | int }}s){% endif %}
  </summary>
  <div class="health-grid">
    <div class="health-row">
      <span class="health-label">Prices</span>
      <span class="health-values">
        yfinance {{ health.prices_yfinance or 0 }}
        &middot; cache {{ health.prices_cache or 0 }}
        &middot; failed <span class="badge-{{ health_badges.prices or 'unknown' }}">{{ health.prices_failed or 0 }}</span>
        {#- Guarded on prices_asof itself, not `is not none`: scan rows from
            before 2026-08-23 have the column but no value, and Jinja's
            default Undefined is falsy the same way None is, so `if
            health.prices_asof` is the one condition that is correct whether
            the key is present-and-null or genuinely absent. The weekend
            cache-staleness bug (Done, 2026-08-22) was found by hand-diffing
            the price cache; this line is what would have shown it instead —
            a scan whose run date and as-of date disagree by more than the
            calendar accounts for is visible here, not just in a log line. -#}
        {%- if health.prices_asof %}
        &middot; as of {{ health.prices_asof }}{% if health.asof_spread_days %} ({{ health.asof_spread_days }}d spread){% endif %}
        {#- The 06:00 UTC cron fires before the US close, so Sat/Sun/Mon scans
            can all resolve to Friday's bar -- correct, not a fetch failure,
            so this is informational (health-muted), never a badge color.
            same_asof_streak counts the CURRENT scan too, so 1 means "nothing
            shared" and is deliberately silent; only 2+ renders a note. -#}
        {%- if same_asof_streak and same_asof_streak > 1 %}
        <span class="health-muted">(shared with {{ same_asof_streak - 1 }} prior scan{{ 's' if same_asof_streak > 2 else '' }})</span>
        {%- endif %}
        {%- endif %}
      </span>
    </div>
    <div class="health-row">
      <span class="health-label">Themes</span>
      <span class="health-values">
        <span class="badge-{{ health_badges.coverage or 'unknown' }}">{{ health.sectors_produced or '?' }}/{{ health.sectors_expected or '?' }}</span> signals produced
        {#- `or 0` would read an unknown (None, old scan row) the same as a
            confirmed healthy 0 — exactly the false-green trap the finbert
            badge above goes out of its way to avoid. `is not none` is safe
            here specifically because `_health_row_from_df` (shared by
            get_latest_health/get_health_for_scan) always includes this key,
            NaN normalized to None — never Jinja Undefined on this path,
            unlike prices_asof's own guard above (which predates that
            normalization existing for every column and still has to allow
            for it). '?' matches the coverage badge's own convention for the
            identical "we don't know" state, two lines up. -#}
        &middot; dropped (stale as-of) <span class="badge-{{ health_badges.asof_dropped or 'unknown' }}">{{ health.asof_dropped_count if health.asof_dropped_count is not none else '?' }}</span>
      </span>
    </div>
    <div class="health-row">
      <span class="health-label">Sentiment</span>
      <span class="health-values">
        {% if health.finbert_scored is not none %}
          FinBERT <span class="badge-{{ health_badges.finbert or 'unknown' }}">{{ health.finbert_scored }}/{{ health.finbert_total }}</span> scored
          &middot; {{ health.gdelt_articles or 0 }} GDELT articles
        {% else %}
          <span class="health-muted">Skipped</span>
        {% endif %}
      </span>
    </div>
  </div>
</details>
{% elif health is defined %}
<div class="health-panel health-muted">No health data available for this scan.</div>
{% endif %}

<footer class="site-footer">
  <span data-i18n="disclaimer">Analytical tooling, not investment advice.</span>
  <button type="button" id="methodology-link" class="footer-link">Methodology</button>
  {#- Inside {% if auth %} so guests never get a link to a dialog that cannot
      exist. It also starts `hidden` and is revealed by alert-prefs.js only once
      alerts are actually available for this reader — a signed-in user whose
      alert_prefs table is missing would otherwise open an empty dialog. -#}
  {% if auth %}
  <button type="button" id="alerts-link" class="footer-link" hidden data-i18n="alerts_title">Alerts</button>
  {% endif %}
</footer>
{% if auth %}
{#- The blocked star-toggle's non-visual counterpart (positions.js:announceLive).
    Lives here, not inline on a leaderboard row, because it has to be present
    once per page regardless of which rows exist -- and this partial is
    already the shared home for every auth-gated script that needs a page-level
    hook (positions.js included, just below). Scoped inside {% if auth %} to
    match: positions.js's own blocked-click path (the only caller of
    announceLive) never runs for a guest either. -#}
<div id="sm-live-region" class="sr-only" aria-live="polite"></div>
{#- Alerts modal.
    ------------
    Was a permanently-rendered block sitting BELOW the footer — after the
    disclaimer and Methodology link — which is an odd reading order and an odd
    home for a control only signed-in readers can use. Now a modal opened from
    the footer, mirroring the Methodology treatment beside it.

    The overlay is a NEW wrapper with #alert-prefs nested inside, deliberately:
    alert-prefs.js owns that section's `hidden` attribute to mean "alerts are
    available to this reader", while a modal overlay uses `hidden` to mean
    "closed". Collapsing the two elements would collide those meanings. -#}
<div class="methodology-overlay" id="alerts-modal" hidden>
  <div class="methodology-modal" role="dialog" aria-modal="true" aria-labelledby="alerts-title">
    <button type="button" class="methodology-close" id="alerts-close" aria-label="Close">&times;</button>
    <h2 id="alerts-title" data-i18n="alerts_title">Alerts</h2>
<section id="alert-prefs" class="alert-prefs" hidden>
  <p class="alert-prefs-intro" data-i18n="alerts_intro">Get a push notification after each scan: Exit signals for themes you hold, plus new Enter signals.</p>
  {#- Which band alerts actually evaluate, and a warning when that is not the
      band the reader is looking at.

      Alerts run on the CONFIG DEFAULT horizon: detect_badge_events calls
      _compute_setup(row) with no horizon, which falls back to default_horizon().
      The selector's choice lives in localStorage and does not reach the scan, so
      switching horizon silently changes the board without changing the inbox.

      Numbers are written by script into their own nodes, with the surrounding
      words carrying data-i18n. Interpolating a whole sentence would have it
      wiped on the first language switch — applyLang() rewrites textContent from
      the SV bundle, which is why renderHorizonStats() is built the same way. -#}
  <p class="alerts-hz-note" id="alerts-hz-agree" hidden>
    <span data-i18n="alerts_hz_pre">Alerts use the</span>
    <b id="alerts-hz-name"></b>
    <span data-i18n="alerts_hz_post">band — the same one the board is showing.</span>
  </p>
  <p class="alerts-hz-warn" id="alerts-hz-differ" hidden>
    <span data-i18n="alerts_hz_warn_pre">Your board is set to</span>
    <b id="alerts-hz-sel"></b><span data-i18n="alerts_hz_warn_mid">, but alerts use</span>
    <b id="alerts-hz-alert"></b><span data-i18n="alerts_hz_warn_exit">. Alerts flag Exit past rank</span>
    <b id="alerts-hz-alert-exit"></b><span data-i18n="alerts_hz_warn_vs">, where your board waits until</span>
    <b id="alerts-hz-sel-exit"></b><span data-i18n="alerts_hz_warn_entry">, and Enter within the top</span>
    {# This fragment begins with a word, not punctuation, so it needs the space
       the newline below provides. Use the PLAIN comment delimiters here, never
       the whitespace-stripping variant: that form eats the very space being
       preserved, which is how "top4 against" shipped in the first draft. #}
    <b id="alerts-hz-alert-top"></b>
    <span data-i18n="alerts_hz_warn_vs2">against your board's</span>
    <b id="alerts-hz-sel-top"></b>.
  </p>
  <div id="alert-prefs-off" hidden>
    <button type="button" id="alert-prefs-enable" class="lang-toggle" data-i18n="alerts_enable">Enable alerts</button>
  </div>
  <div id="alert-prefs-on" hidden>
    <div class="alert-prefs-topic">
      <code id="alert-prefs-topic"></code>
      <button type="button" id="alert-prefs-copy" class="lang-toggle" data-i18n="alerts_copy">Copy</button>
    </div>
    <p class="alert-prefs-help">
      <span data-i18n="alerts_help">Install the ntfy app and subscribe to this topic.</span>
      <a id="alert-prefs-link" href="#" target="_blank" rel="noopener noreferrer">ntfy.sh</a>
    </p>
    <p class="alert-prefs-warn" data-i18n="alerts_warn">Anyone who knows this topic name can read these notifications. Don't share it — regenerate if it leaks.</p>
    <label class="alert-prefs-toggle">
      <input type="checkbox" id="alert-prefs-enabled"> <span data-i18n="alerts_enabled_label">Alerts enabled</span>
    </label>
    <button type="button" id="alert-prefs-regen" class="lang-toggle" data-i18n="alerts_regen">Regenerate</button>
  </div>
  <p id="alert-prefs-status" class="alert-prefs-status" aria-live="polite"></p>
</section>
  </div>
</div>
<script>
{#- window.SMModal is defined once, earlier in the page (both index.html.j2
    and sentiment.html.j2 include _modal.js.j2 directly, before this partial
    is included) — not re-included here. See _methodology.html.j2 for the
    same note; found together in the 2026-08-23 sweep. -#}
(function () {
  var overlay = document.getElementById("alerts-modal");
  if (!overlay) { return; }
  var modal = window.SMModal.bind(overlay, {
    closeBtn: document.getElementById("alerts-close"),
  });
  if (!modal) { return; }
  // Exposed so alert-prefs.js can open it on #alerts once it knows alerts are
  // available — the deep link has to wait for that, since the dialog is empty
  // until then.
  window.SMAlertsModal = modal;

  /* Alerts evaluate the CONFIG DEFAULT horizon; the selector's choice lives in
     localStorage and never reaches the scan. Say which band is in force, and
     spell out the disagreement when the reader has switched. */
  var ALERT_HZ = {{ horizon_default_json | js_json }};
  var ALL_HZ = {{ horizons_json | js_json }};

  function renderHorizonNote() {
    var selKey = ALERT_HZ.key;
    try {
      var saved = localStorage.getItem("sm_horizon");
      if (saved && ALL_HZ.some(function (h) { return h.key === saved; })) { selKey = saved; }
    } catch (e) { /* private mode: assume the default */ }
    var sel = ALL_HZ.filter(function (h) { return h.key === selKey; })[0] || ALERT_HZ;
    var agree = document.getElementById("alerts-hz-agree");
    var differ = document.getElementById("alerts-hz-differ");
    if (!agree || !differ) { return; }
    function put(id, v) { var el = document.getElementById(id); if (el) { el.textContent = v; } }
    if (sel.key === ALERT_HZ.key) {
      put("alerts-hz-name", ALERT_HZ.label);
      agree.hidden = false; differ.hidden = true;
      return;
    }
    put("alerts-hz-sel", sel.label);
    put("alerts-hz-alert", ALERT_HZ.label);
    put("alerts-hz-alert-exit", ALERT_HZ.top_n + ALERT_HZ.buffer);
    put("alerts-hz-sel-exit", sel.top_n + sel.buffer);
    put("alerts-hz-alert-top", ALERT_HZ.top_n);
    put("alerts-hz-sel-top", sel.top_n);
    agree.hidden = true; differ.hidden = false;
  }

  function bindTrigger() {
    var link = document.getElementById("alerts-link");
    if (link) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        // Recomputed on open, not once at load: the reader may switch horizon
        // and then open this without a page reload.
        renderHorizonNote();
        modal.open();
      });
    }
    renderHorizonNote();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindTrigger);
  } else {
    bindTrigger();
  }
})();
</script>
<script>window.SUPABASE_CONFIG = {{ auth_config_json | js_json }};</script>
<script src="assets/supabase.min.js"></script>
<script src="assets/supabase-client.js"></script>
<script src="assets/auth.js"></script>
<script src="assets/positions.js"></script>
<script src="assets/book-lock.js"></script>
<script src="assets/alert-prefs.js"></script>
{% endif %}

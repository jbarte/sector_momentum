(function () {
  var SV = {};
  var SV_HTML = {};

  {% include "i18n/_core.js.j2" %}
  {% include "i18n/_sentiment.js.j2" %}
  {% include "i18n/_backtest.js.j2" %}
  {% include "i18n/_badges.js.j2" %}
  {% include "i18n/_validation.js.j2" %}
  {% include "i18n/_macro.js.j2" %}
  {% include "i18n/_guides.js.j2" %}
  {% include "i18n/_auth.js.j2" %}

  var els = document.querySelectorAll("[data-i18n]");
  // Guarded, not unconditional: applyHorizonBadges() runs before this script
  // (see index.html.j2's ordering comment) and already sets a BARE data-en
  // on any badge that carries a data-suffix. An unconditional overwrite here
  // would re-capture data-en from the badge's current textContent -- which
  // at this point already has the suffix appended -- reintroducing the
  // double-suffix once apply() below appends data-suffix a second time on
  // top of it. Mirrors apply()'s own per-element guard just below.
  els.forEach(function (el) {
    if (!el.getAttribute("data-en")) el.setAttribute("data-en", el.textContent);
  });
  var htmlEls = document.querySelectorAll("[data-i18n-html]");
  var enHtml = new Map();
  htmlEls.forEach(function (el) { enHtml.set(el, el.innerHTML); });

  function apply(lang) {
    document.querySelectorAll("[data-i18n]").forEach(function (el) {
      if (!el.getAttribute("data-en")) el.setAttribute("data-en", el.textContent);
      var key = el.getAttribute("data-i18n");
      var base = (lang === "sv" && SV[key] != null) ? SV[key] : el.getAttribute("data-en");
      // A data-i18n element whose text carries a dynamic, non-translated
      // suffix (a date, a slot-availability note) needs that suffix
      // preserved across every language-driven rewrite of .textContent --
      // data-en alone isn't enough because it only supplies the English
      // base, not the currently-live dynamic part, and the SV[key] branch
      // above ignores data-en (and any suffix baked into it) entirely. Bug:
      // applyHorizonBadges()'s badge suffix (" · <date>" / " · no slot") was
      // being discarded on every Swedish-language render because this loop
      // overwrote textContent with the bare SV[key] string. Found 2026-08-27.
      var suffix = el.getAttribute("data-suffix");
      el.textContent = suffix ? base + suffix : base;
    });
    document.querySelectorAll("[data-i18n-html]").forEach(function (el) {
      if (!enHtml.has(el)) enHtml.set(el, el.innerHTML);
      var key = el.getAttribute("data-i18n-html");
      el.innerHTML = (lang === "sv" && SV_HTML[key] != null) ? SV_HTML[key] : enHtml.get(el);
    });
    // aria-label, for controls whose accessible name is not their text. Added
    // 2026-08-14 for the market-context chips, whose visible content is live
    // numbers. Same shape as the title arm below; without it a data-i18n-*
    // attribute is silently inert, which is how two of them were nearly shipped
    // dead.
    document.querySelectorAll("[data-i18n-aria]").forEach(function (el) {
      if (!el.getAttribute("data-en-aria")) {
        el.setAttribute("data-en-aria", el.getAttribute("aria-label") || "");
      }
      var akey = el.getAttribute("data-i18n-aria");
      el.setAttribute("aria-label",
        (lang === "sv" && SV[akey] != null) ? SV[akey] : el.getAttribute("data-en-aria"));
    });
    document.querySelectorAll("[data-i18n-title]").forEach(function (el) {
      if (!el.getAttribute("data-en-title")) el.setAttribute("data-en-title", el.getAttribute("title") || "");
      var key = el.getAttribute("data-i18n-title");
      el.setAttribute("title", (lang === "sv" && SV[key] != null) ? SV[key] : el.getAttribute("data-en-title"));
    });
    document.documentElement.lang = (lang === "sv") ? "sv" : "en";
    var btn = document.getElementById("lang-toggle");
    if (btn) btn.textContent = (lang === "sv") ? "EN" : "SV";
    try { localStorage.setItem("lang", lang); } catch (e) {}
    // The leaderboard filter count is built in JS, so it misses the static
    // data-i18n pass above — re-render it in the new language.
    if (typeof window.applyFilters === "function") window.applyFilters();
    // Same gap, same fix, for the review panel: its headline/action-list/
    // count text is built imperatively by renderReviewPanel() (index.html.j2)
    // via t(key, fallback) calls that read the current language once, at
    // render time -- there is no data-i18n* attribute on any of it for the
    // querySelectorAll passes above to find. Without this, a reader who
    // toggles language sees the panel stay in the old language until some
    // UNRELATED event (a horizon switch, a star click) happens to re-run
    // renderReviewPanel() for its own reasons. No recursion risk:
    // renderReviewPanel() does not call back into apply()/toggleLang().
    // Reached via window., not a bare call, because this script block and
    // index.html.j2's are separate <script> tags -- same reason applyFilters()
    // above is reached through window. rather than called directly.
    if (typeof window.renderReviewPanel === "function") window.renderReviewPanel();
  }

  function currentLang() {
    try { return localStorage.getItem("lang") || "en"; } catch (e) { return "en"; }
  }

  // For markup built and inserted client-side by code that reruns often
  // (applyBandBoundaries() on every sort/filter/horizon-switch, not a
  // once-per-row-rebuild case like auth.js's UNBUYABLE_BADGE) — that
  // frequency means "insert English + data-i18n, wait for the next language
  // toggle" visibly resets translated text back to English on the reader's
  // very next interaction. This bakes in the correct text for the CURRENT
  // language at insertion time; the data-i18n attribute the caller still
  // sets is what keeps a LATER language toggle able to find and retranslate
  // the element too, so both paths stay correct.
  function translate(key, fallbackEn) {
    return (currentLang() === "sv" && SV[key] != null) ? SV[key] : fallbackEn;
  }
  window.translate = translate;

  // Scoped counterpart to apply(): translates one element's title/aria-label
  // in place, instead of the four document-wide querySelectorAll passes (plus
  // the applyFilters() side effect) apply() does. For content that is
  // inserted once and never re-labeled (auth.js's UNBUYABLE_BADGE, the Live
  // chip), a data-i18n-* attribute is enough — the next apply() call (a
  // language toggle) picks it up for free. It exists for the opposite case:
  // an element whose title/aria-label is reassigned to a DIFFERENT value
  // repeatedly at runtime (positions.js's ★/☆ toggle, Held <-> Mark as held),
  // where waiting for the next apply() means staying English until the
  // reader happens to toggle language, and running the full apply() on every
  // change is a page-wide rescan for a one-element update.
  //
  // Mirrors apply()'s data-en-title/data-en-aria caching exactly (lazy-cache
  // if absent), so a caller that reassigns the element's live value must
  // clear that cache itself first (removeAttribute) — same rule as apply(),
  // just owned by one more call site. Deliberately not merged into apply()'s
  // loops: those run over a queried set for the WHOLE page every call, this
  // runs over one already-known element, and a lang argument is optional
  // (reads currentLang() itself) so callers need no i18n-plumbing of their
  // own.
  function applyToEl(el, lang) {
    if (lang == null) lang = currentLang();
    if (el.hasAttribute("data-i18n-title")) {
      if (!el.getAttribute("data-en-title")) el.setAttribute("data-en-title", el.getAttribute("title") || "");
      var tkey = el.getAttribute("data-i18n-title");
      el.setAttribute("title", (lang === "sv" && SV[tkey] != null) ? SV[tkey] : el.getAttribute("data-en-title"));
    }
    if (el.hasAttribute("data-i18n-aria")) {
      if (!el.getAttribute("data-en-aria")) {
        el.setAttribute("data-en-aria", el.getAttribute("aria-label") || "");
      }
      var akey = el.getAttribute("data-i18n-aria");
      el.setAttribute("aria-label",
        (lang === "sv" && SV[akey] != null) ? SV[akey] : el.getAttribute("data-en-aria"));
    }
  }

  window.applyLang = apply;
  window.applyLangToEl = applyToEl;
  window.toggleLang = function () {
    apply(currentLang() === "sv" ? "en" : "sv");
  };

  apply(currentLang());
})();

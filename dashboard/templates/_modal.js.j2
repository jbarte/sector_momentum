{# Shared modal behaviour: focus trap, Escape, backdrop close, focus restore.

   Extracted from _methodology.html.j2 on 2026-08-09 so the tab guides could
   reuse it rather than carry a second copy. The gate modal moved onto it on
   2026-08-12 (dashboard/assets/auth.js) — it had declared aria-modal="true"
   while implementing none of this. Every modal on the site now shares this
   behaviour; a new one should bind here rather than hand-roll it.

   Usage:
     window.SMModal.bind(overlayEl, {closeBtn, onOpen})  -> {open, close}

   `overlayEl` is the full-screen backdrop; clicking it (but not its children)
   closes. The element with role="dialog" inside it is the focus scope. #}
{# Short-circuit rather than reassign, defensively: this partial is included
   directly by index.html.j2/sentiment.html.j2 (once each, ahead of every
   consumer) and by the tab-guide script further down the same page.
   Defining it twice would work (bind() is itself idempotent) but would
   silently swap the object identity under any modal already bound.

   _footer.html.j2 and _methodology.html.j2 used to include this partial
   too — a third and fourth copy per page, ~12 KB of duplicated inline JS —
   removed 2026-08-23 once both pages already included it once directly,
   ahead of those two partials in document order. Both partials now call
   window.SMModal.bind(...) relying on that order rather than re-including
   this file; see the notes in _footer.html.j2/_methodology.html.j2 and
   test_modal_helper_include_precedes_footer_and_methodology
   (tests/test_dashboard_js.py), which pins the order this guard no longer
   makes irrelevant on its own. #}
window.SMModal = window.SMModal || (function () {
  var FOCUSABLE = 'button, a[href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

  function bind(overlay, opts) {
    opts = opts || {};
    // Idempotent: templates may include this partial more than once per page.
    if (!overlay || overlay.dataset.smModalBound) {
      return overlay && overlay._smModal;
    }
    overlay.dataset.smModalBound = "1";

    var panel = overlay.querySelector('[role="dialog"]') || overlay;
    var closeBtn = opts.closeBtn || null;
    var lastFocus = null;

    function focusables() {
      return panel.querySelectorAll(FOCUSABLE);
    }

    function onKey(e) {
      if (e.key === "Escape") { close(); return; }
      if (e.key !== "Tab") { return; }
      var f = focusables();
      if (!f.length) { return; }
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    }

    function open() {
      // Capture the trigger *before* showing, so focus returns to whatever the
      // reader was on rather than to the top of the page.
      lastFocus = document.activeElement;
      if (opts.onOpen) { opts.onOpen(); }
      overlay.hidden = false;
      // Scroll the panel back to the top: a reused modal otherwise opens
      // wherever the previous reader left it.
      if (panel.scrollTop) { panel.scrollTop = 0; }
      (closeBtn || panel).focus();
      document.addEventListener("keydown", onKey);
    }

    function close() {
      overlay.hidden = true;
      document.removeEventListener("keydown", onKey);
      if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
    }

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) { close(); }
    });
    if (closeBtn) { closeBtn.addEventListener("click", close); }

    var api = {open: open, close: close};
    overlay._smModal = api;
    return api;
  }

  return {bind: bind};
})();

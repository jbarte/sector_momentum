{# Shared rotation-arcs illustration banner for the gate + methodology modals.
   Decorative (labelled for AT); animated via CSS in css/_chrome.css.j2.
   Colours live in this file's own <style> (not attributes) so they can read
   CSS custom properties and follow the theme — an SVG fill=/stroke=
   attribute cannot reference var(). #}
<div class="modal-illo-band">
  <svg class="modal-illo" viewBox="0 0 640 128" preserveAspectRatio="xMidYMax slice"
       role="img" aria-label="Sector rotation: laggards rotating toward the leader">
    <style>
      .modal-illo .arc1 { stroke: var(--border); }
      .modal-illo .arc2 { stroke: var(--border-soft); }
      .modal-illo .arc3 { stroke: var(--fg4); }
      .modal-illo .arc4 { stroke: var(--up); }
      .modal-illo .sweep { stroke: var(--brand-strong); }
      .modal-illo .d1 { fill: var(--down); }
      .modal-illo .d2 { fill: var(--down); }
      .modal-illo .d3 { fill: var(--up); }
      .modal-illo .halo { stroke: var(--brand-strong); }
      .modal-illo .d4 { fill: var(--brand-strong); }
      .modal-illo .d5 { fill: var(--fg4); }
    </style>
    <g fill="none" stroke-linecap="round">
      <path class="arc a1 arc1" pathLength="1" d="M250 128 A70 70 0 0 1 390 128"  stroke-width="1.4"/>
      <path class="arc a2 arc2" pathLength="1" d="M200 128 A120 120 0 0 1 440 128" stroke-width="1.4" opacity="0.85"/>
      <path class="arc a3 arc3" pathLength="1" d="M150 128 A170 170 0 0 1 490 128" stroke-width="1.6" opacity="0.9"/>
      <path class="arc a4 arc4" pathLength="1" d="M100 128 A220 220 0 0 1 540 128" stroke-width="1.6" opacity="0.75"/>
    </g>
    <path class="sweep" d="M168 104 Q300 40 470 44" fill="none" stroke-width="1.2"
          stroke-dasharray="2 6" stroke-linecap="round" opacity="0.5"/>
    <circle class="dot d1" cx="168" cy="104" r="4.5" opacity="0.85"/>
    <circle class="dot d2" cx="250" cy="80"  r="5.5" opacity="0.9"/>
    <circle class="dot d3" cx="338" cy="60"  r="6.5"/>
    <circle class="halo"   cx="470" cy="44"  r="15"  fill="none" stroke-width="1.5" opacity="0.45"/>
    <circle class="dot d4" cx="470" cy="44"  r="9"/>
    <circle class="dot d5" cx="545" cy="66"  r="5"/>
  </svg>
</div>

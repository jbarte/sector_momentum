{# Forward-return validation & holding-period stats panels #}
{% if validation_min_scans_met %}
<h3 style="margin:22px 0 6px;font-family:var(--font-display);font-size:15px;color:var(--fg1)">Do the rankings predict returns?</h3>
<p class="tab-note">Excess return of the top-5 themes vs the benchmark.</p>
{% if not validation_conclusive %}
<p class="tab-note val-provisional">
  <strong>Provisional — not yet conclusive.</strong>
  <span>Based on</span>
  <strong>{{ "%.1f"|format(validation_span_days / 30.4) }}</strong>
  <span>months of scans (since</span>
  <strong>{{ validation_first_scan }}</strong><span>). Forward-return windows overlap heavily, so these observations are not independent and the sample cannot support a conclusion. The equity curves above cover multiple years; this panel reflects only live scans since tracking began. Colour-coding returns after ~12 months of history.</span>
</p>
{% endif %}
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Horizon</th>
        <th scope="col">Obs</th>
        <th scope="col">Hit rate</th>
        <th scope="col">Mean excess</th>
        <th scope="col">Median excess</th>
      </tr>
    </thead>
    <tbody>
      {% for row in validation_fwd_returns %}
      <tr>
        <td>{{ row.horizon }}</td>
        <td>{{ row.obs }}</td>
        {% if row.hit_rate is not none %}
        <td class="{% if validation_conclusive %}{% if row.hit_rate > 0.5 %}signal-hi{% elif row.hit_rate < 0.5 %}signal-lo{% endif %}{% endif %}">{{ "%.0f%%"|format(row.hit_rate * 100) }}</td>
        <td class="{% if validation_conclusive %}{% if row.mean_excess > 0 %}signal-hi{% elif row.mean_excess < 0 %}signal-lo{% endif %}{% endif %}">{{ "%+.2f%%"|format(row.mean_excess * 100) }}</td>
        <td class="{% if validation_conclusive %}{% if row.median_excess > 0 %}signal-hi{% elif row.median_excess < 0 %}signal-lo{% endif %}{% endif %}">{{ "%+.2f%%"|format(row.median_excess * 100) }}</td>
        {% else %}
        <td>—</td><td>—</td><td>—</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<h3 style="margin:22px 0 6px;font-family:var(--font-display);font-size:15px;color:var(--fg1)">How long do top-5 positions last?</h3>
<p class="tab-note">Duration of contiguous top-5 rank streaks (in market days).</p>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Runs</th>
        <th scope="col">Median</th>
        <th scope="col">Mean</th>
        <th scope="col">Min</th>
        <th scope="col">Max</th>
      </tr>
    </thead>
    <tbody>
      {% for row in validation_holding %}
      <tr>
        <td>{{ row.runs }}{% if row.ongoing %} <span style="color:var(--fg4)">({{ row.ongoing }} <span>ongoing</span>)</span>{% endif %}</td>
        {% if row.median is not none %}
        <td>{{ row.median }}</td>
        <td>{{ row.mean }}</td>
        <td>{{ row.min }}</td>
        <td>{{ row.max }}</td>
        {% else %}
        <td>—</td><td>—</td><td>—</td><td>—</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

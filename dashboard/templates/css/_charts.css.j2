/* =========================================================
   Plotly chart containers
   ========================================================= */
.chart-container {
  /* The card colour, like the Plotly paper inside it, so nothing shows a
     mismatched band before the chart paints. The plot area is the inset. */
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-lg);
  overflow: hidden;
  min-height: 420px;
}

/* =========================================================
   Cohort selector — drives RRG / Drill-down / Movers / History / Backtest
   ========================================================= */
.cohort-select-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 0 16px;
  flex-wrap: wrap;
}
.cohort-select-row label {
  color: var(--fg4);
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--ls-label);
}
.cohort-select-row select {
  background: var(--bg-inset);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  color: var(--fg1);
  font-family: var(--font-body);
  font-size: 13px;
  padding: 7px 12px;
  cursor: pointer;
  min-width: 160px;
  outline: none;
}

/* =========================================================
   Drill-down panel
   ========================================================= */
.drilldown-controls {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}
.drilldown-controls label {
  color: var(--fg4);
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--ls-label);
}
select.sector-select {
  background: var(--bg-inset);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  color: var(--fg1);
  font-family: var(--font-body);
  font-size: 13px;
  padding: 7px 12px;
  cursor: pointer;
  min-width: 220px;
  outline: none;
  transition: border-color var(--duration-fast) var(--ease-standard);
}
select.sector-select:focus {
  border-color: var(--brand-strong);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-strong) 20%, transparent);
}

.val-provisional {
  border-left: 2px solid var(--border);
  padding-left: 10px;
  color: var(--fg2);
}

/* Plotly's toolbar: out of the way until the chart is hovered or focused, and in
   the page's own colours. Its buttons set their own fill, hence !important. It
   stays visible wherever hover is unreliable (a phone, a tablet, a touch laptop),
   or it could not be reached. */
.js-plotly-plot .modebar {
  opacity: 0;
  transition: opacity var(--duration-base) var(--ease-standard);
}
.js-plotly-plot:hover .modebar,
.js-plotly-plot:focus-within .modebar { opacity: 1; }
@media (hover: none), (pointer: coarse) { .js-plotly-plot .modebar { opacity: 1; } }
.js-plotly-plot .modebar-group { background: transparent !important; }
.js-plotly-plot .modebar-btn path { fill: var(--fg4) !important; }
.js-plotly-plot .modebar-btn:hover path,
.js-plotly-plot .modebar-btn.active path { fill: var(--fg1) !important; }

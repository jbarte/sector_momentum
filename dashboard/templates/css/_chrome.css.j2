/* =========================================================
   Command bar
   ========================================================= */
.command-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 28px;
  flex-wrap: wrap;
}
.command-bar h1 {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 600;
  color: var(--fg1);
  letter-spacing: -0.02em;
  line-height: 1;
  white-space: nowrap;
}
.meta-cluster {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-left: auto;
}
.scan-meta {
  font-size: 11px;
  color: var(--fg4);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.lang-toggle {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--fg3);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  padding: 3px 12px;
  cursor: pointer;
  transition: color var(--duration-fast) var(--ease-standard),
              border-color var(--duration-fast) var(--ease-standard);
}
.lang-toggle:hover { color: var(--brand-strong); border-color: var(--brand-strong); }
.auth-root { position: relative; display: inline-flex; align-items: center; gap: 8px; }
.auth-root .lang-toggle { white-space: nowrap; }
/* Email form opens as a dropdown card anchored under the Sign in button, so
   the input/send/status group reads as one unit instead of reflowing the
   command bar. Same surface treatment as the .card shell. */
.auth-form {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  box-shadow: var(--shadow-card);
}
.auth-form[hidden] { display: none; }
.auth-form input[type="email"] {
  background: var(--bg-raised);
  color: var(--fg1);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 4px 8px;
  font: inherit;
  font-size: 0.8rem;
  width: 14em;
}
.auth-status { color: var(--fg4); font-size: 0.75rem; max-width: 16em; }
.auth-status:empty { display: none; }

/* =========================================================
   Chips (macro indicators in command bar)
   ========================================================= */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  cursor: default;
  font-variant-numeric: tabular-nums;
}
.chip-up   { background: color-mix(in srgb, var(--up) 12%, transparent); color: var(--up); }
.chip-down { background: color-mix(in srgb, var(--down) 12%, transparent); color: var(--down); }
.chip-calm      { background: color-mix(in srgb, var(--up) 12%, transparent); color: var(--up); }
.chip-elevated  { background: color-mix(in srgb, var(--fg1) 8%, transparent); color: var(--fg1); }
.chip-stressed  { background: color-mix(in srgb, var(--down) 12%, transparent); color: var(--down); }

/* =========================================================
   Card shell
   ========================================================= */
.card {
  background: var(--surface);
  border-radius: 10px;
  box-shadow: var(--shadow-card);
  margin: 16px 28px 24px;
  overflow: hidden;
}
.card > .tabs {
  background: var(--surface);
  border-bottom: 1px solid var(--border-soft);
  padding: 0 20px;
  border-radius: 10px 10px 0 0;
}
.card > .tab-panel { padding: 20px 24px; }

/* =========================================================
   Segment toggle (Sectors ⇄ Sentiment) — top-level page switcher,
   distinct from the sector tab bar below it.
   ========================================================= */
.segment-toggle {
  display: inline-flex;
  background: var(--bg-sunken);
  border-radius: var(--radius-pill);
  padding: 3px;
  gap: 2px;
}
.segment-btn {
  display: inline-flex;
  align-items: center;
  padding: 5px 14px;
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 500;
  color: var(--fg3);
  text-decoration: none;
  border-radius: var(--radius-pill);
  white-space: nowrap;
  cursor: pointer;
  /* Reset <button> UA chrome so button-based toggles match <a>/<span> ones. */
  border: none;
  background: transparent;
  -webkit-appearance: none;
  appearance: none;
  transition: color var(--duration-fast) var(--ease-standard),
              background var(--duration-fast) var(--ease-standard);
}
.segment-btn:hover { color: var(--fg1); }
.segment-btn.active {
  background: var(--bg-raised);
  color: var(--brand-strong);
  font-weight: 600;
  box-shadow: var(--shadow-xs);
  cursor: default;
}

/* =========================================================
   Theme toggle (Auto / Light / Dark) — same pill-group pattern as
   .segment-toggle above, so the two segmented controls in this codebase
   read as one visual language rather than two.
   ========================================================= */
.theme-toggle {
  display: inline-flex;
  background: var(--bg-sunken);
  border-radius: var(--radius-pill);
  padding: 3px;
  gap: 2px;
}
.theme-btn {
  display: inline-flex;
  align-items: center;
  padding: 5px 10px;
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 500;
  color: var(--fg3);
  border: none;
  background: transparent;
  border-radius: var(--radius-pill);
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
  transition: color var(--duration-fast) var(--ease-standard),
              background var(--duration-fast) var(--ease-standard);
}
.theme-btn:hover { color: var(--fg1); }
.theme-btn[aria-pressed="true"] {
  background: var(--bg-raised);
  color: var(--brand-strong);
  font-weight: 600;
  box-shadow: var(--shadow-xs);
  cursor: default;
}
.theme-btn:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
}

/* =========================================================
   Tab bar
   ========================================================= */
.tabs {
  display: flex;
  background: var(--bg-raised);
  border-bottom: 1px solid var(--border);
  overflow-x: auto;
  padding: 0 24px;
}
.tab-btn {
  text-decoration: none;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--fg4);
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  padding: 11px 16px;
  white-space: nowrap;
  transition: color var(--duration-fast) var(--ease-standard),
              border-color var(--duration-fast) var(--ease-standard);
}
.tab-btn:hover { color: var(--fg2); }
.tab-btn.active {
  color: var(--brand-strong);
  border-bottom-color: var(--brand-strong);
}

/* =========================================================
   Tab content panels
   ========================================================= */
.tab-panel { display: none; padding: 24px 28px; }
.tab-panel.active { display: block; }

/* =========================================================
   Site footer
   ========================================================= */
.site-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 28px;
  margin-top: 8px;
  border-top: 1px solid var(--border-soft);
  font-size: 12px;
  color: var(--fg4);
}
.site-footer a {
  color: var(--fg3);
  text-decoration: none;
}
.site-footer a:hover { color: var(--brand-strong); }

/* =========================================================
   Content-gating: lag-notice banner
   ========================================================= */
.lag-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  padding: 10px 16px;
  margin: 0 0 12px;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 0.85rem;
  color: var(--fg2);
}
.lag-banner[hidden] { display: none; }
.lag-banner-text strong { color: var(--fg1); }
.lag-banner-btn {
  border: 1px solid var(--brand-strong);
  color: var(--brand-strong);
  background: transparent;
  border-radius: var(--radius-sm);
  padding: 4px 12px;
  font: inherit;
  font-size: 0.875rem;
  cursor: pointer;
}
.lag-banner-btn:hover { background: var(--brand-strong); color: var(--surface); }

/* =========================================================
   Content-gating: landing modal
   ========================================================= */
.gate-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(3px);
}
.gate-modal-overlay[hidden] { display: none; }
.gate-modal {
  max-width: 420px;
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow-card);
  padding: 28px 26px;
  text-align: center;
}
.gate-modal h2 { margin: 0 0 8px; font-size: 1.3rem; color: var(--fg1); }
.gate-modal p { margin: 0 0 18px; color: var(--fg2); font-size: 0.9rem; }
/* Inside the modal the form is static (not the header dropdown), so reset the
   absolute positioning the .auth-form rule applies in the command bar. */
.gate-modal-form {
  position: static;
  justify-content: center;
  flex-wrap: wrap;
  box-shadow: none;
  padding: 0;
  border: none;
  background: transparent;
  margin-bottom: 14px;
}
.gate-modal-continue {
  border: none;
  background: transparent;
  color: var(--fg4);
  font: inherit;
  font-size: 0.875rem;
  text-decoration: underline;
  cursor: pointer;
}
.gate-modal-continue:hover { color: var(--fg2); }

/* =========================================================
   Methodology reference modal
   ========================================================= */
.methodology-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(3px);
}
.methodology-overlay[hidden] { display: none; }
.methodology-modal {
  position: relative;
  max-width: 640px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow-card);
  padding: 28px 30px;
  text-align: left;
}
.methodology-modal h2 { margin: 0 0 14px; font-size: 1.3rem; color: var(--fg1); }
.methodology-modal h3 { margin: 20px 0 6px; font-size: 1rem; color: var(--fg1); }
.methodology-body p,
.methodology-body li { color: var(--fg2); font-size: 0.9rem; line-height: 1.55; }
/* Paragraphs need air. The methodology used to be one paragraph per section, so
   zero margin read fine; it is now several per section and ran together into a
   wall of text without this. */
.methodology-body p { margin: 0 0 10px; }
.methodology-body p:last-child { margin-bottom: 0; }
.methodology-body li { margin-bottom: 4px; }
.methodology-body ul { margin: 6px 0 12px; padding-left: 20px; }
.methodology-body code { font-size: 0.85em; color: var(--fg1); }
.methodology-close {
  position: absolute;
  top: 12px;
  right: 14px;
  border: none;
  background: transparent;
  color: var(--fg4);
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
}
.methodology-close:hover { color: var(--fg1); }
/* Footer trigger styled as a link button */
.footer-link {
  border: none;
  background: transparent;
  color: inherit;
  font: inherit;
  text-decoration: underline;
  cursor: pointer;
  padding: 0;
}

/* =========================================================
   Modal illustration — rotation arcs (gate + methodology)
   ========================================================= */
.modal-illo-band {
  overflow: hidden;
  background: linear-gradient(160deg, var(--bg-raised) 0%, var(--bg-sunken) 100%);
}
.methodology-modal .modal-illo-band { margin: -28px -30px 18px; border-radius: 14px 14px 0 0; }
.gate-modal .modal-illo-band        { margin: -28px -26px 18px; border-radius: 14px 14px 0 0; }
.modal-illo { display: block; width: 100%; height: 120px; }
.gate-modal .modal-illo { height: 104px; }
/* keep the methodology close button above the band */
.methodology-close { z-index: 1; }

/* Reveal — auto-fires when the modal's display flips from none to shown.
   Arcs are normalized to pathLength="1" so all four draw at a uniform rate and
   settle together; a soft ease + overlapping delays make it read as one gesture. */
.modal-illo .arc {
  stroke-dasharray: 1; stroke-dashoffset: 1;
  animation: illo-draw 1.5s var(--illo-soft) forwards;
}
.modal-illo .a1 { animation-delay: .05s; }
.modal-illo .a2 { animation-delay: .17s; }
.modal-illo .a3 { animation-delay: .29s; }
.modal-illo .a4 { animation-delay: .40s; }
.modal-illo .sweep {
  opacity: 0;
  animation: illo-fade 1.15s ease-out .65s forwards, illo-flow 3s linear 1.7s infinite;
}
.modal-illo .dot, .modal-illo .halo {
  opacity: 0; transform: scale(.62); transform-origin: center; transform-box: fill-box;
  animation: illo-pop .8s var(--illo-soft) forwards;
}
.modal-illo .d1 { animation-delay: .68s; }
.modal-illo .d2 { animation-delay: .82s; }
.modal-illo .d3 { animation-delay: .96s; }
.modal-illo .d4 { animation-delay: 1.12s; }
.modal-illo .d5 { animation-delay: 1.26s; }
/* leader halo: reveal, then slow ambient breathe */
.modal-illo .halo {
  animation: illo-pop .8s var(--illo-soft) 1.1s forwards,
             illo-breathe 4.6s ease-in-out 2.6s infinite;
}

@keyframes illo-draw    { to { stroke-dashoffset: 0; } }
@keyframes illo-fade    { to { opacity: .5; } }
@keyframes illo-pop     { to { opacity: 1; transform: scale(1); } }
@keyframes illo-breathe { 0%, 100% { transform: scale(1); opacity: .42; } 50% { transform: scale(1.1); opacity: .2; } }
@keyframes illo-flow    { to { stroke-dashoffset: -16; } }

@media (prefers-reduced-motion: reduce) {
  .modal-illo .arc { stroke-dashoffset: 0; animation: none; }
  .modal-illo .sweep, .modal-illo .dot, .modal-illo .halo {
    opacity: 1; transform: none; animation: none;
  }
  .modal-illo .sweep { opacity: .5; }
  .modal-illo .halo  { opacity: .45; }
}

/* =========================================================
   Personalized alerts panel
   ========================================================= */
/* The panel now lives inside the alerts modal, which already supplies the
   surface, border, radius and padding. Keeping its own card chrome would draw a
   second box inside the dialog. The standalone-block rules it used to need
   (max-width, centring margin, background, border) are gone with it; only the
   type scale is still the panel's own. */
.alert-prefs {
  font-size: 0.85rem;
}
.alert-prefs[hidden] { display: none; }
.alert-prefs-intro { margin: 0 0 12px; color: var(--fg2); }
.alert-prefs-topic { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.alert-prefs-topic code {
  background: var(--bg-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 3px 8px;
  font-size: 0.8rem;
}
.alert-prefs-help { margin: 10px 0 0; color: var(--fg2); }
.alert-prefs-warn { margin: 8px 0 0; color: var(--fg4); font-size: 0.78rem; }
.alert-prefs-toggle { display: block; margin: 12px 0 8px; color: var(--fg2); }
.alert-prefs-status { margin: 8px 0 0; color: var(--fg4); font-size: 0.78rem; }
.alert-prefs-status:empty { display: none; }

/* =========================================================
   Focus indicators
   =========================================================
   Keyboard users had no visible focus anywhere: the stylesheet carried only a
   handful of :focus-visible rules and none covered the tabs, the sortable
   column headers, the leaderboard rows or the footer links. One shared ring,
   applied broadly, so a new control inherits it instead of being forgotten.

   :focus-visible (not :focus) so a mouse click does not leave a ring behind. */
:where(a, button, summary, [tabindex="0"], input, select):focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
  border-radius: 3px;
}

/* Table rows and header cells clip an offset ring, so inset it instead. */
.leaderboard-row:focus-visible,
thead th[tabindex="0"]:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: -2px;
}

/* Skip link — first focusable element in the body. Off-screen until
   keyboard focus reaches it (Tab from a fresh load), then pinned to the
   top-left corner so it never overlaps the command bar. A mouse user never
   sees it; a screen-reader or keyboard user gets a way past the header/nav
   chrome straight to <main> without tabbing through every control first. */
.skip-link {
  position: absolute;
  top: -40px;
  left: 8px;
  z-index: 1000;
  padding: 8px 14px;
  background: var(--bg-raised);
  color: var(--fg1);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 13px;
  text-decoration: none;
}
.skip-link:focus-visible {
  top: 8px;
}

/* "alpha" marker on the Sentiment segment and its page note. Deliberately the
   quietest thing in the command bar — it qualifies a nav item, it should not
   compete with it. */
.alpha-badge {
  display: inline-block;
  margin-left: 5px;
  padding: 0 4px;
  border-radius: 3px;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--fg4);
  background: var(--bg-sunken);
  border: 1px solid var(--border);
  vertical-align: 1px;
}
.alpha-note { border-left: 3px solid var(--border); padding-left: 10px; }

/* Market-context chips as one tappable control.
   Reads as a chip group, not a button: no fill, no border of its own — the
   chips already carry visual weight, and a third box around them would compete
   with the segment toggle beside it. The ⓘ is the only added affordance, and
   the whole group is one hit target, which is what makes this work on touch
   where `title` tooltips do not exist at all. */
.context-chips {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 2px 6px;
  margin: 0;
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  background: none;
  font: inherit;
  color: inherit;
  cursor: pointer;
}
.context-chips:hover { border-color: var(--border); background: var(--bg-sunken); }
.context-chips:focus-visible { outline: 2px solid var(--brand-strong); outline-offset: 1px; }
.context-chips .cc-info { font-size: 11px; color: var(--fg4); line-height: 1; }
.context-chips:hover .cc-info { color: var(--fg2); }
/* Carries the dialog heading and the accessible name; never shown. Clipped
   rather than display:none so it stays in the accessibility tree. */
.context-chips .cc-label {
  position: absolute;
  width: 1px; height: 1px;
  margin: -1px; padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* Which band alerts run on. The agreement line is a quiet confirmation; the
   disagreement one has to be noticed, so it gets the warning colour and a rule
   rather than being another paragraph of grey. */
.alerts-hz-note { margin: 0 0 12px; color: var(--fg4); font-size: 0.78rem; }
.alerts-hz-warn {
  margin: 0 0 12px;
  padding: 8px 10px;
  border-left: 3px solid var(--down);
  background: color-mix(in srgb, var(--down) 6%, transparent);
  color: var(--fg2);
  font-size: 0.78rem;
}
.alerts-hz-warn b { color: var(--fg1); }

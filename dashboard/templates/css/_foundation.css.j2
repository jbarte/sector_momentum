/* Self-hosted (dashboard/assets/fonts/, licences in FONTS.md there): no third
   party sees a reader's IP address, and no font request waits on another
   origin. URLs go through asset_url() for the content-hash cache-buster, and
   _font_preload.html.j2 preloads the same URLs. Latin subsets, upright only:
   no element sets italic in Familjen Grotesk, and Inter's italics were never
   loaded from Google either. */
@font-face {
  font-family: 'Familjen Grotesk';
  src: url("{{ asset_url('fonts/familjen-grotesk-latin-wght.woff2') }}") format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Inter';
  src: url("{{ asset_url('fonts/inter-latin-wght.woff2') }}") format('woff2');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}
/* Greek, for the Δ in the "Rank Δ" header: Google's Inter covered it, the
   latin file does not. unicode-range makes a browser fetch this file only on a
   page that draws a Greek character, so it is not preloaded either. */
@font-face {
  font-family: 'Inter';
  src: url("{{ asset_url('fonts/inter-greek-wght.woff2') }}") format('woff2');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;
}
@font-face {
  font-family: 'JetBrains Mono';
  src: url("{{ asset_url('fonts/jetbrains-mono-latin-400.woff2') }}") format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'JetBrains Mono';
  src: url("{{ asset_url('fonts/jetbrains-mono-latin-500.woff2') }}") format('woff2');
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* Screen-reader-only: content that must reach the accessibility tree without
   being visible -- e.g. a live-announcement region for a blocked action.
   Clipped, not display:none, so assistive tech still sees it. */
.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  margin: -1px; padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

:root {
  --beige-50:  #FAF7F0;
  --beige-100: #F5F0E6;
  --beige-200: #EDE6D6;
  --beige-300: #DFD5BE;
  --beige-400: #C4B89A;
  --beige-550: #6F674F;
  --beige-600: #5E5742;
  --beige-700: #3E392B;
  --beige-900: #1F1C15;

  --green-300: #A9BF95;
  --green-400: #8FA77A;
  --green-600: #5A6F49;

  --terra-400: #BF6F50;
  --terra-500: #A55A3C;

  --bg:           var(--canvas);
  --bg-inset:     #F4EFE4;   /* boxes nested inside the card */
  --bg-raised:    #FDFBF6;   /* elements that sit on top of the card */
  --bg-sunken:    var(--beige-200);
  --fg1:          var(--beige-900);
  --fg2:          var(--beige-700);
  --fg3:          var(--beige-600);
  --fg4:          var(--beige-550);
  --brand-strong: var(--green-600);
  --border:       var(--beige-300);
  --border-soft:  var(--beige-200);
  --zero-line:    var(--beige-400);
  --up:           var(--green-600);
  --down:         var(--terra-500);
  --border-hair:  color-mix(in srgb, var(--border-soft) 60%, var(--surface));
  --up-ink:       #3F4F34;
  --down-ink:     #8E4B31;
  --fg5:          #8A8068;
  --ok:    #267539;
  --warn:  #9F5209;
  --err:   #B23A2E;

  --font-display: 'Familjen Grotesk', 'Helvetica Neue', system-ui, sans-serif;
  --font-body:    'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  --font-mono:    'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;

  /* Corner radii: chips, badges, inputs / panels nested in the card / the card. */
  --radius-sm:   6px;
  --radius-md:   10px;
  --radius-lg:   14px;
  --radius-pill: 999px;

  --space-1: 4px;  --space-2: 8px;  --space-3: 12px; --space-4: 16px;
  --space-5: 20px; --space-6: 24px; --space-7: 32px; --space-8: 40px;

  --canvas:      #EFE9DC;
  --surface:     #FAF7F0;

  /* 1: contact (an active pill). 2: the card. 3: popovers and modals. */
  --shadow-1: 0 1px 2px rgba(60,55,40,0.12);
  --shadow-2: 0 0 0 1px rgba(60,55,40,0.06), 0 1px 2px rgba(60,55,40,0.06),
              0 8px 24px -12px rgba(60,55,40,0.18);
  --shadow-3: 0 0 0 1px rgba(60,55,40,0.06), 0 4px 8px rgba(60,55,40,0.06),
              0 16px 40px -8px rgba(60,55,40,0.22);

  --ease-standard: cubic-bezier(0.2,0.6,0.2,1);
  --ease-glide:    cubic-bezier(0.16,1,0.3,1);   /* quick start, soft landing */
  --illo-soft:     cubic-bezier(0.33,0.9,0.36,1);
  --duration-fast: 140ms;
  --duration-base: 200ms;
  --duration-slow: 320ms;

  /* The four letter-spacings: headings, labels (small uppercase), badges and
     tickers. Body text has none. */
  --ls-heading: -0.015em;
  --ls-label:    0.08em;
  --ls-badge:    0.04em;
}

:root[data-theme="dark"] {
  --canvas:       #17150F;
  --surface:      #201D15;
  --bg-inset:     #262218;
  --bg-raised:    #262218;
  --bg-sunken:    #2A2619;
  --fg1:          #F0EADB;
  --fg2:          #E4DDCC;
  --fg3:          #B5AB92;
  --fg4:          #A59A80;
  --border:       #34301F;
  --border-soft:  #2A2619;
  --zero-line:    #8B7F6E;
  --up:           #A9C48E;
  --down:         #D98E6B;
  --brand-strong: #A9C48E;
  --border-hair:  color-mix(in srgb, var(--border-soft) 60%, var(--surface));
  --up-ink:       var(--up);
  --down-ink:     var(--down);
  --fg5:          #9E9179;
  --ok:           #8FCB8A;
  --warn:         #E0A85E;
  --err:          #E0836E;

  --shadow-1:    0 1px 2px rgba(0,0,0,0.35);
  --shadow-2:    0 0 0 1px rgba(0,0,0,0.30), 0 1px 2px rgba(0,0,0,0.30),
                 0 8px 24px -12px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.03);
  --shadow-3:    0 0 0 1px rgba(0,0,0,0.30), 0 4px 8px rgba(0,0,0,0.30),
                 0 16px 40px -8px rgba(0,0,0,0.60);
}

/* The Auto fallback. Its token VALUES must match the block above exactly
   (indentation differs, values must not) — test_dark_tokens_are_three_way_
   consistent enforces this. The :not() guard
   stops an explicit Light choice on a dark OS from being clobbered: without
   it, a reader who picked Light while their OS is dark would see the media
   query re-apply dark anyway. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --canvas:       #17150F;
    --surface:      #201D15;
    --bg-inset:     #262218;
    --bg-raised:    #262218;
    --bg-sunken:    #2A2619;
    --fg1:          #F0EADB;
    --fg2:          #E4DDCC;
    --fg3:          #B5AB92;
    --fg4:          #A59A80;
    --border:       #34301F;
    --border-soft:  #2A2619;
    --zero-line:    #8B7F6E;
    --up:           #A9C48E;
    --down:         #D98E6B;
    --brand-strong: #A9C48E;
    --border-hair:  color-mix(in srgb, var(--border-soft) 60%, var(--surface));
    --up-ink:       var(--up);
    --down-ink:     var(--down);
    --fg5:          #9E9179;
    --ok:           #8FCB8A;
    --warn:         #E0A85E;
    --err:          #E0836E;

    --shadow-1:    0 1px 2px rgba(0,0,0,0.35);
    --shadow-2:    0 0 0 1px rgba(0,0,0,0.30), 0 1px 2px rgba(0,0,0,0.30),
                   0 8px 24px -12px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.03);
    --shadow-3:    0 0 0 1px rgba(0,0,0,0.30), 0 4px 8px rgba(0,0,0,0.30),
                   0 16px 40px -8px rgba(0,0,0,0.60);
  }
}

html, body {
  background: var(--bg);
  color: var(--fg2);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.5;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* =========================================================
   Responsive
   ========================================================= */
/* Responsive overrides moved to css/_responsive.css.j2 (included last).
   They were dead here: _chrome.css.j2 loads afterwards and re-declares
   .card / .tab-panel unconditionally, and a media query adds no specificity,
   so the desktop values won even at 375px. */

/* One switch for everything that moves (spec 2026-11-08 § 3). The three older
   reduced-motion rules stay: they also set illustrations' final state. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

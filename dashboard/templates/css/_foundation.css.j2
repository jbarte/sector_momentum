@import url('https://fonts.googleapis.com/css2?family=Familjen+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* Screen-reader-only: content that must reach the accessibility tree without
   being visible -- e.g. a live-announcement region for a blocked action.
   Clipped, not display:none, so assistive tech still sees it. Mirrors the
   scoped .context-chips .cc-label treatment (_chrome.css.j2) as the one
   reusable version. */
.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  margin: -1px; padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

:root {
  --beige-50:  #FAF7F0;
  --beige-100: #F5F0E6;
  --beige-200: #EDE6D6;
  --beige-300: #DFD5BE;
  --beige-400: #C4B89A;
  --beige-550: #6F674F;
  --beige-600: #5E5742;
  --beige-700: #3E392B;
  --beige-900: #1F1C15;

  --green-300: #A9BF95;
  --green-400: #8FA77A;
  --green-600: #5A6F49;

  --terra-400: #BF6F50;
  --terra-500: #A55A3C;

  --bg:           var(--canvas);
  --bg-raised:    var(--beige-50);
  --bg-sunken:    var(--beige-200);
  --fg1:          var(--beige-900);
  --fg2:          var(--beige-700);
  --fg3:          var(--beige-600);
  --fg4:          var(--beige-550);
  --brand-strong: var(--green-600);
  --border:       var(--beige-300);
  --border-soft:  var(--beige-200);
  --zero-line:    var(--beige-400);
  --up:           var(--green-600);
  --down:         var(--terra-500);
  --border-hair:  color-mix(in srgb, var(--border-soft) 60%, var(--surface));
  --up-ink:       #3F4F34;
  --down-ink:     #8E4B31;
  --fg5:          #8A8068;
  --ok:    #267539;
  --warn:  #9F5209;
  --err:   #B23A2E;

  --font-display: 'Familjen Grotesk', 'Helvetica Neue', system-ui, sans-serif;
  --font-body:    'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  --font-mono:    'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;

  --radius-sm:   4px;
  --radius-md:   8px;
  --radius-lg:   14px;
  --radius-pill: 999px;

  --shadow-xs: 0 1px 2px rgba(62,57,43,0.06);
  --shadow-sm: 0 1px 2px rgba(62,57,43,0.05), 0 2px 6px rgba(62,57,43,0.04);
  --canvas:      #f1ecdf;
  --surface:     #ffffff;
  --shadow-card: 0 1px 5px rgba(60,55,40,0.10);

  --ease-standard: cubic-bezier(0.2,0.6,0.2,1);
  --illo-soft:     cubic-bezier(0.33,0.9,0.36,1);
  --duration-fast: 140ms;
}

:root[data-theme="dark"] {
  --canvas:       #17150F;
  --surface:      #201D15;
  --bg-raised:    #262218;
  --bg-sunken:    #2A2619;
  --fg1:          #F0EADB;
  --fg2:          #E4DDCC;
  --fg3:          #B5AB92;
  --fg4:          #A59A80;
  --border:       #34301F;
  --border-soft:  #2A2619;
  --zero-line:    #8B7F6E;
  --up:           #A9C48E;
  --down:         #D98E6B;
  --brand-strong: #A9C48E;
  --border-hair:  color-mix(in srgb, var(--border-soft) 60%, var(--surface));
  --up-ink:       var(--up);
  --down-ink:     var(--down);
  --fg5:          #9E9179;
  --ok:           #8FCB8A;
  --warn:         #E0A85E;
  --err:          #E0836E;

  --shadow-xs:   0 1px 2px rgba(0,0,0,0.35);
  --shadow-sm:   0 1px 2px rgba(0,0,0,0.30), 0 2px 6px rgba(0,0,0,0.28);
  --shadow-card: 0 1px 5px rgba(0,0,0,0.45);
}

/* The Auto fallback. Its token VALUES must match the block above exactly
   (indentation differs, values must not) — test_dark_tokens_are_three_way_
   consistent enforces this. The :not() guard
   stops an explicit Light choice on a dark OS from being clobbered: without
   it, a reader who picked Light while their OS is dark would see the media
   query re-apply dark anyway. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --canvas:       #17150F;
    --surface:      #201D15;
    --bg-raised:    #262218;
    --bg-sunken:    #2A2619;
    --fg1:          #F0EADB;
    --fg2:          #E4DDCC;
    --fg3:          #B5AB92;
    --fg4:          #A59A80;
    --border:       #34301F;
    --border-soft:  #2A2619;
    --zero-line:    #8B7F6E;
    --up:           #A9C48E;
    --down:         #D98E6B;
    --brand-strong: #A9C48E;
    --border-hair:  color-mix(in srgb, var(--border-soft) 60%, var(--surface));
    --up-ink:       var(--up);
    --down-ink:     var(--down);
    --fg5:          #9E9179;
    --ok:           #8FCB8A;
    --warn:         #E0A85E;
    --err:          #E0836E;

    --shadow-xs:   0 1px 2px rgba(0,0,0,0.35);
    --shadow-sm:   0 1px 2px rgba(0,0,0,0.30), 0 2px 6px rgba(0,0,0,0.28);
    --shadow-card: 0 1px 5px rgba(0,0,0,0.45);
  }
}

html, body {
  background: var(--bg);
  color: var(--fg2);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.5;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* =========================================================
   Responsive
   ========================================================= */
/* Responsive overrides moved to css/_responsive.css.j2 (included last).
   They were dead here: _chrome.css.j2 loads afterwards and re-declares
   .card / .tab-panel unconditionally, and a media query adds no specificity,
   so the desktop values won even at 375px. */

/* Tab interpretation guides.
   These were inline <details> inside .utility-row until 2026-08-09. Because the
   guide was a flex sibling of the filter bar, opening one inflated the row to
   ~700px: align-items:center stranded the ⚙ mid-column and pushed the eight
   filter chips into a floating block detached from the table they filter, with
   the leaderboard shoved below the fold. At 375px the summary was squeezed to
   44x90px and rendered as a five-line vertical word-stack. They are modals now,
   on the same shared machinery as the methodology modal. */
.utility-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
  padding: 6px 0 0;
}
.tab-guide-btn {
  border: none;
  background: none;
  margin: 0;
  padding: 6px 4px;          /* a real hit area, not a 12px text run */
  cursor: pointer;
  color: var(--fg4);
  font-family: inherit;
  font-weight: 500;
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;       /* never re-wrap into a vertical word-stack */
  user-select: none;
}
.tab-guide-btn::before { content: "ⓘ"; font-size: 1em; }
.tab-guide-btn:hover { color: var(--fg2); }
/* Touch pointers get a full-size target. Kept off mouse pointers so the row
   height, which the filter chips align against, is unchanged on desktop. */
@media (pointer: coarse) {
  .tab-guide-btn { min-height: 44px; padding: 10px 6px; }
}
.tab-guide-btn:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
  border-radius: 4px;
}

.guide-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(3px);
}
.guide-overlay[hidden] { display: none; }
.guide-modal {
  position: relative;
  max-width: 640px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow-card);
  padding: 28px 30px;
  text-align: left;
}
/* Header banner. Same band treatment as the methodology modal so the two read
   as one family, but a different illustration and a different reveal verb:
   bars rise from the baseline rather than arcs drawing. */
.guide-illo-band {
  overflow: hidden;
  background: linear-gradient(160deg, var(--bg-raised) 0%, var(--bg-sunken) 100%);
  margin: -28px -30px 18px;
  border-radius: 14px 14px 0 0;
}
.guide-illo { display: block; width: 100%; height: 112px; }
.guide-close { z-index: 1; }   /* above the band */

/* Bars grow from the baseline. transform-box: fill-box makes the SVG rect obey
   transform-origin the way a DOM box would; without it the origin resolves
   against the whole viewBox and the bars slide instead of rising. */
.guide-illo .bar {
  transform: scaleY(0.04);
  transform-origin: center bottom;
  transform-box: fill-box;
  animation: guide-rise 0.72s var(--illo-soft) forwards;
}
.guide-illo .b1  { animation-delay: .04s; }
.guide-illo .b2  { animation-delay: .09s; }
.guide-illo .b3  { animation-delay: .14s; }
.guide-illo .b4  { animation-delay: .19s; }
.guide-illo .b5  { animation-delay: .24s; }
.guide-illo .b6  { animation-delay: .29s; }
.guide-illo .b7  { animation-delay: .33s; }
.guide-illo .b8  { animation-delay: .37s; }
.guide-illo .b9  { animation-delay: .41s; }
.guide-illo .b10 { animation-delay: .45s; }
.guide-illo .b11 { animation-delay: .49s; }
.guide-illo .b12 { animation-delay: .53s; }
/* The hold band arrives last and stays faint — it is the quiet zone, so it
   should not out-shout the bars it sits behind. */
.guide-illo .hold-band {
  animation: guide-band-in 0.9s ease-out .62s forwards;
}
.guide-illo .band-edges {
  animation: guide-edges-in 0.8s ease-out .70s forwards;
}
.guide-illo .baseline {
  animation: guide-baseline-in 0.7s ease-out .30s forwards;
}
/* The two badges land last — they are the conclusion the picture builds to. */
.guide-illo .mark {
  transform: translateY(3px);
  transform-box: fill-box;
  animation: guide-mark-in 0.6s var(--illo-soft) forwards;
}
.guide-illo .m-entry { animation-delay: .86s; }
.guide-illo .m-exit  { animation-delay: .98s; }

@keyframes guide-rise        { to { transform: scaleY(1); } }
@keyframes guide-band-in     { to { opacity: 0.26; } }
@keyframes guide-baseline-in { to { opacity: 0.55; } }
@keyframes guide-edges-in    { to { opacity: 0.5; } }
@keyframes guide-mark-in     { to { opacity: 0.9; transform: translateY(0); } }

@media (prefers-reduced-motion: reduce) {
  .guide-illo .bar { transform: none; animation: none; }
  .guide-illo .hold-band  { opacity: 0.26; animation: none; }
  .guide-illo .baseline   { opacity: 0.55; animation: none; }
  .guide-illo .band-edges { opacity: 0.5;  animation: none; }
  .guide-illo .mark { opacity: 0.9; transform: none; animation: none; }
}

.guide-modal h2 { margin: 0 0 14px; font-size: 1.3rem; color: var(--fg1); }
.guide-close {
  position: absolute;
  top: 12px;
  right: 14px;
  border: none;
  background: transparent;
  color: var(--fg4);
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
  padding: 4px 8px;
}
.guide-close:hover { color: var(--fg1); }

.tab-guide-body {
  color: var(--fg2);
  line-height: 1.65;
  font-size: 0.875rem;
}
.tab-guide-body[hidden] { display: none; }
.tab-guide-body h3 {
  margin: 12px 0 4px;
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--fg4);
}
.tab-guide-body ul {
  margin: 4px 0 10px 0;
  padding-left: 18px;
}
.tab-guide-body li { margin-bottom: 3px; }
/* Same reason as the methodology modal: the rewritten guides run several
   paragraphs per heading, which merge into a block without this. */
.tab-guide-body p { margin: 0 0 9px; }
.tab-guide-body p:last-child { margin-bottom: 0; }
.signal-hi { color: var(--up); font-weight: 600; }
.signal-lo { color: var(--down); font-weight: 600; }

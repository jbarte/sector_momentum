.health-panel { margin: 1rem 0 0; padding: 0.5rem 1rem; font-size: 0.875rem; border-top: 1px solid var(--border); color: var(--fg4); }
.health-panel summary { cursor: pointer; font-weight: 600; }
.health-grid { display: grid; gap: 0.3rem; margin-top: 0.5rem; }
.health-row { display: flex; gap: 0.5rem; }
.health-label { min-width: 5.5rem; font-weight: 600; }
.health-muted { opacity: 0.5; font-style: italic; }
.health-warn-dot { color: var(--warn); }
.badge-green { color: var(--ok); font-weight: 600; }
.badge-amber { color: var(--warn); font-weight: 600; }
.badge-red { color: var(--err); font-weight: 600; }
/* "cannot judge this" — _badge() returned None (missing or zero denominator).
   The template used to fall back to `badge-green`, which asserted health the
   data does not support; a 0/0 sentiment outage rendered as a green tick in a
   collapsed panel. Neutral grey states the uncertainty instead of guessing. */
.badge-unknown { color: var(--fg4); font-weight: 600; }

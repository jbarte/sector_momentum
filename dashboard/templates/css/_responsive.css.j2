/* =========================================================
   Responsive overrides — MUST be the last stylesheet included
   =========================================================
   Media queries add no specificity. A `@media (max-width: 600px)` rule for
   `.card` earlier in the cascade therefore loses to a plain `.card` rule
   later, silently: the query matches, the declaration is simply outranked.

   That is exactly what happened — the mobile block lived in _foundation
   (first include) while _chrome (second) re-declared `.card` margin and
   `.tab-panel` padding unconditionally. At 375px the query matched and the
   desktop values still applied, costing 104px of a 375px viewport and leaving
   the leaderboard 271px of a 730px table.

   Keep every responsive override here, and keep this file last in
   _style.html.j2. A new mobile rule anywhere earlier is liable to be dead on
   arrival. */

@media (max-width: 600px) {
  .command-bar { padding: 10px 16px; }
  .card { margin: 12px 8px 16px; }
  .card > .tab-panel { padding: 14px 10px; }
  .card > .tabs { padding: 0 8px; }
  /* .site-footer's desktop layout (_chrome.css.j2) is
     `justify-content: space-between` on one row — disclaimer text left,
     Methodology/Alerts buttons right. At 375px that squeezes both against
     each other with no wrap; stack them instead. */
  .site-footer {
    padding: 14px 16px;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  /* Summary strip (Stage 4): one stacked block on a phone, not three columns
     — three cells at 375px give each ~125px, narrower than a single band
     pill. Cell C (id renamed cell-market-context -> cell-track-record by the
     2026-09-05 track-record chip) stays hidden here for the same space
     reason, not the original SPY/VIX-duplication one: it no longer shows
     what .mobile-scan-meta (Stage 3) already carries at this width, but a
     third ~125px-wide cell still doesn't fit next to the other two. */
  .summary-strip {
    grid-template-columns: 1fr;
    background: var(--surface);
  }
  .strip-cell { background: var(--surface); padding: 14px 16px; }
  #cell-todays-read { padding-left: 16px; padding-right: 16px; }
  #cell-track-record { display: none; }
  /* Same reason Cell C is hidden: .mobile-scan-meta already prints the scan
     id and date a couple of hundred pixels above this, and the strip's own
     subline repeats them verbatim. Found at the 375px browser gate.
     (Written without a literal scan id: a "#" followed by three digits parses
     as a hex colour to test_no_hardcoded_hex_outside_foundation.) */
  .strip-subline { display: none; }
  .strip-eyebrow { margin-bottom: 6px; }
  .strip-headline { font-size: 17px; }
}

@media (max-width: 420px) {
  .scan-meta { display: none; }
}

/* ---------------------------------------------------------
   Scan meta: desktop indicator + mobile echo (_header.html.j2)
   ---------------------------------------------------------
   Two elements, one job (name the scan id/date), split at the SAME
   breakpoint so exactly one is ever visible. .desktop-scan-meta is new
   2026-08-23: index.html.j2's own summary strip already shows this on
   desktop (.strip-subline), but sentiment.html.j2 has no strip, so it
   showed no scan date on desktop at all once data was present (the
   2026-08-22 fix only covered the empty state). Guarded on
   `active_segment != "sectors"` in the template, so it never renders
   alongside the strip in the first place — these rules are what keep it
   from ALSO colliding with .mobile-scan-meta on a narrow viewport.

   Deliberately NOT reusing .scan-meta (the auth-email-label style): that
   class is hidden at `max-width: 420px`, a different breakpoint, so
   reusing it here would show the scan date TWICE between 421px and
   600px — once from .mobile-scan-meta, once from a wrongly-still-visible
   .scan-meta. */
@media (min-width: 601px) {
  .mobile-scan-meta { display: none; }
}
@media (max-width: 600px) {
  .mobile-scan-meta {
    width: 100%;
    font-size: 11px;
    color: var(--fg3);
  }
  .desktop-scan-meta { display: none; }
}

/* ---------------------------------------------------------
   Leaderboard: cards instead of a pinned-column table
   ---------------------------------------------------------
   Stage 3 of the leaderboard redesign (2026-08-20) replaced the pinned-first-
   two-columns table this section used to hold — it showed ~2 of 6 columns at
   a time even with sticky columns. renderMobileCards() (index.html.j2)
   builds .leaderboard-cards from the table's own live DOM state; both are
   always in the markup, this section just decides which one is visible. */
@media (min-width: 601px) {
  .leaderboard-cards { display: none; }
}

@media (max-width: 600px) {
  #leaderboard-table { display: none; }

  .leaderboard-cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px 16px;
  }

  .leaderboard-card {
    border: 1px solid var(--border-hair);
    border-radius: 12px;
    padding: 12px 14px;
    background: var(--surface);
  }
  .leaderboard-card.in-band {
    border-left: 3px solid color-mix(in srgb, var(--up) 55%, transparent);
    background: color-mix(in srgb, var(--up) 4%, transparent);
  }

  .card-line1 {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card-theme {
    flex: 1;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }

  /* .card-line2 takes over .composite-cell's flex-container role (see
     _tables.css.j2): renderMobileCards() copies compositeCell.innerHTML —
     the .cbar-wrap/.cbar-val children only, not .composite-cell itself — so
     .cbar-wrap's flex:1 has no flex parent to size against on its own.
     Found live: the bar rendered at 0 width until this was added. */
  .card-line2 {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .card-line2 .cbar-wrap { height: 20px; }
  .card-line2 .cbar-val { font-size: 14px; }

  .card-line3 {
    margin-top: 10px;
    display: flex;
    gap: 12px;
    font-size: 11px;
    color: var(--fg4);
  }
  .card-line3 span {
    color: var(--fg2);
    font-family: var(--font-mono);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .card-delta { margin-left: auto; }

  .card-badges {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--border-soft);
  }

  /* Mirrors .band-cut-row's desktop treatment (_tables.css.j2) at card
     scale — no flex-collapse trap to avoid here, .card-cut-row is a <div>,
     not a <td> sitting adjacent to another flex <td>. */
  .card-cut-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 4px 4px;
    font-size: 11px;
  }
  .card-cut-row .ccr-eyebrow {
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .card-cut-row.buy .ccr-eyebrow { color: var(--brand-strong); }
  .card-cut-row.exit .ccr-eyebrow { color: var(--down); }
  .card-cut-row .ccr-note { color: var(--fg4); }

  /* The card's own embedded breakdown copy (renderMobileCards()) — collapsed
     by default, shown when the card's tap handler toggles its 'open' class.
     Independent of the table's own .breakdown-row/.open mechanism; the
     table itself is fully hidden above, so its state is simply never seen
     on mobile, not fought with. .breakdown-grid already collapses to one
     column under 700px (existing rule, this file's "Relocated from other
     partials" section below), so the embedded copy reads correctly here
     with no further change. */
  /* overflow-x: auto is a scoped fallback, not a full fix: the embedded
     breakdown content (score tree, signal rows/bars) is intrinsically wider
     than a mobile card even in .breakdown-grid's existing single-column
     mode — found live, ~130px of horizontal overflow at 375px. Redesigning
     .breakdown-grid's internals for card width is its own task, out of
     Stage 3's scope (this stage is the leaderboard table becoming cards,
     not the breakdown panel); scrolling keeps the content reachable rather
     than silently clipping it in the meantime. */
  .card-breakdown { display: none; margin-top: 10px; overflow-x: auto; }
  .leaderboard-card.open .card-breakdown { display: block; }

  /* Mirrors .leaderboard-row.position-held/.position-warn (_tables.css.j2)
     at card scale — renderMobileCards() (index.html.j2) now copies both
     classes onto the card, but had no styling to show for them, which was
     half the "can't tell a holding from an ordinary row" report: even once
     the star glyph exists, a reader shouldn't have to spot one small
     ★ among six cards to know which they own.
     Declared AFTER .leaderboard-card.in-band (above): the two backgrounds
     are independent facts on desktop (in-band is a rank-cell rail, held is
     a whole-row tint) with no documented precedence between them, but on a
     card both are whole-card backgrounds and can genuinely co-occur (a
     holding often stays inside the buy band while you hold it) — source
     order picks a winner. Held wins: once you own it, "was it a buy
     candidate" is the less actionable fact, and the star glyph below
     stays visible either way so ownership is never ambiguous. */
  .leaderboard-card.position-held {
    background: color-mix(in srgb, var(--brand-strong) 7%, transparent);
  }
  .leaderboard-card.position-warn {
    box-shadow: inset 3px 0 0 0 var(--down);
  }
  .leaderboard-card.position-warn .card-theme::before {
    content: "⚠ ";
    color: var(--down);
  }

  /* Mirrors .leaderboard-row.position-surplus (_tables.css.j2) at card
     scale -- same fix as position-held/position-warn just above, same gap:
     renderMobileCards() now copies position-surplus onto the card, but had
     no styling for it, so the surplus holding named in the review panel
     ("Book: 5 / 4 — too many") had no visible mark among the cards on the
     one layout (<600px) where the desktop table's own rail is hidden.
     The desktop rule confines its rail to td:first-child, which has no card
     equivalent -- and RIGHT edge here, deliberately, not left: position-warn
     above already claims the left edge as a whole-card rail, and a warn
     holding can also be the surplus one (Exit-badged AND over the book's
     target at once), so the two need to stay independently visible rather
     than one overwriting the other by source order. */
  .leaderboard-card.position-surplus {
    box-shadow: inset -3px 0 0 0 var(--down);
  }

  /* .position-toggle (_tables.css.j2) was never sized for touch even on the
     desktop table — scoped to `.leaderboard-card` rather than the shared
     `@media (pointer: coarse)` touch-target block above, since cards only
     ever exist below this same 600px breakpoint: widening it there too
     would also inflate the star on a touchscreen-and-wide-enough-for-the-
     table device, inside an already-dense row, for no reason this bug
     needs. It's the one control on a card that mutates state rather than
     just navigating, so a missed tap here is a silently-failed mark/
     unmark, not just an inconvenience. Padding, not min-width: the glyph
     stays inline with the theme name; a fixed min-width would misalign it
     from every star-less line next to it. */
  .leaderboard-card .position-toggle {
    min-height: 44px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
  }
}

/* ---------------------------------------------------------
   Touch targets
   ---------------------------------------------------------
   Pointer-coarse rather than a width query: a small window on a desktop still
   has a mouse. 44px is the WCAG 2.5.5 / platform minimum. */
@media (pointer: coarse) {
  .tab-btn,
  .filter-chip,
  /* .control-chip/.more-filters summary are new (desktop controls-row chip
     curation) and were missing here in whole-branch review — every
     sibling control in the same row (.filter-chip, .rank-settings
     summary) already gets this treatment. */
  .control-chip,
  .more-filters summary,
  .segment-btn,
  .lag-banner-btn,
  .footer-link { min-height: 44px; }

  /* Footer anchors are plain links, not .footer-link buttons. */
  .site-footer a { display: inline-flex; align-items: center; min-height: 44px; }

  /* The old horizon dropdown is NOT listed here (Stage 5, 2026-08-22): it
     is permanently hidden now — .horizon-btn is the real, visible tap
     target the segmented control replaced it with, sized like .theme-btn
     below since it's the same pill-group pattern. Found in whole-branch
     review — the dropdown's rule was dead weight left behind by the swap,
     while the buttons that actually needed it were never added. */
  .theme-btn,
  .lang-toggle,
  .horizon-btn { min-height: 44px; min-width: 44px; }

  /* Inline text toggles need a box before a min-height can apply. */
  .digest-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
  }

  /* A 13px checkbox is the smallest control on the page. Enlarge the box and
     give its label a full-height hit area rather than only the glyph. */
  /* A native checkbox clamps `width` under appearance:auto, so set both the
     box and a min-width, and give the wrapping label the 44px hit area — the
     label is what a thumb actually lands on. */
  #sentiment-toggle { width: 22px; min-width: 22px; height: 22px; min-height: 22px; }
  #sentiment-weight { min-height: 44px; }
  .sentiment-control label,
  .rank-settings label { display: inline-flex; align-items: center; min-height: 44px; }

  /* Disclosure summaries are tap targets too. */
  .health-panel > summary { min-height: 44px; display: flex; align-items: center; }

  /* Sortable headers are activated by tap; give them a real target height. */
  #leaderboard-table thead th[tabindex="0"] { padding-top: 14px; padding-bottom: 14px; }
}

/* ---------------------------------------------------------
   Relocated from other partials
   ---------------------------------------------------------
   These were not dead (nothing later re-declared their properties) but they
   sat before this file, so they were one edit away from being outranked.
   Consolidated here so the convention holds without exceptions. */

/* from _tables.css.j2 */
@media (max-width: 700px) { .breakdown-grid { grid-template-columns: 1fr; } }

/* The ranking and More-filters popovers both anchor to .horizon-row (the
   merged Controls row, since the desktop controls-row-chip-curation work
   retired .utility-row) and span it below 600px, instead of running off
   the side. */
@media (max-width: 600px) {
  .horizon-row { position: relative; }
  .rank-settings,
  .more-filters { position: static; }
  .rank-settings .sentiment-control,
  .more-filters .filter-bar {
    left: 0;
    right: 0;
    min-width: 0;
    white-space: normal;
    flex-wrap: wrap;
    gap: 10px 16px;
  }
}

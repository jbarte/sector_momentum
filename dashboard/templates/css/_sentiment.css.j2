/* =========================================================
   Rank settings popover (sentiment control)
   ========================================================= */
.rank-settings {
  position: relative;
  border: none;
  background: none;
  margin: 0;
  padding: 0;
}
/* Was a bare 12px ⚙ with no padding: a 7x18px target at 3.67:1 contrast, with
   its only name in an aria-label — for the control that re-ranks the board.
   Now a labelled target on --fg3, matching the sibling guide trigger. */
.rank-settings summary {
  cursor: pointer;
  color: var(--fg3);
  font-size: 12px;
  font-weight: 500;
  list-style: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  min-height: 32px;
  border-radius: var(--radius-pill);
  user-select: none;
  white-space: nowrap;
}
.rank-settings summary::-webkit-details-marker { display: none; }
.rank-settings .rs-glyph { font-size: 13px; line-height: 1; }
.rank-settings summary:hover { color: var(--fg1); background: var(--bg-sunken); }
.rank-settings[open] summary { color: var(--fg1); background: var(--bg-sunken); }
.rank-settings summary:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
}
@media (pointer: coarse) {
  .rank-settings summary { min-height: 44px; padding: 10px; }
}
.rank-settings .sentiment-control {
  position: absolute;
  right: 0;
  top: calc(100% + 6px);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 12px 16px;
  z-index: 100;
  white-space: nowrap;
  min-width: 260px;
}

/* The panel is ~347px wide and anchored to the trigger. On a 375px viewport
   neither anchor fits: right:0 puts its left edge at -179px, and left:0 would
   run off the other side. Below 600px it anchors to the whole utility row and
   spans it instead, wrapping its two controls. */
/* The 600px block moved to css/_responsive.css.j2 (included last). */

/* =========================================================
   Sentiment toggle control
   ========================================================= */
.sentiment-control { display:flex; align-items:center; gap:16px; margin:8px 0 12px; font-size:0.9em; color:var(--fg2); }
.sentiment-control input[type=number] { width:52px; }
.sentiment-control .sw-weight[data-disabled="true"] { opacity:0.45; }
.tab-note { font-size:0.8em; color:var(--fg4); margin:0 0 8px; }

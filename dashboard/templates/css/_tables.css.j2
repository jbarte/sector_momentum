/* =========================================================
   Leaderboard table
   ========================================================= */
.table-wrap {
  overflow-x: auto;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-soft);
  background: var(--bg-raised);
  box-shadow: var(--shadow-xs);
}
.scan-index { margin-bottom: 20px; }
.scan-index .active-scan { background: color-mix(in srgb, var(--up) 12%, transparent); }
.showing-badge { color: var(--up); font-weight: 600; font-size: 1em; white-space: nowrap; }
.scan-index tr[data-scan-id] { cursor: pointer; }
.scan-index tr[data-scan-id]:not(.active-scan):hover { background: var(--bg-sunken); }
.scan-index tr[data-scan-id]:focus-visible { outline: 2px solid var(--brand-strong); outline-offset: -2px; }
#scan-history-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 16px;
  margin-bottom: 8px;
  background: var(--bg-raised);
  border-left: 3px solid var(--brand-strong);
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--fg3);
}
#scan-history-banner a {
  color: var(--brand-strong);
  font-weight: 500;
  text-decoration: none;
}
#scan-history-banner a:hover { text-decoration: underline; }
#scan-digest-banner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 16px;
  padding: 8px 16px;
  margin-bottom: 8px;
  background: var(--bg-raised);
  border-left: 3px solid var(--brand-strong);
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--fg3);
}
.digest-cluster { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.digest-chips { display: flex; gap: 8px; flex-wrap: wrap; }
.digest-chip { white-space: nowrap; }
.digest-collapsed .digest-cluster[data-cluster="up"],
.digest-collapsed .digest-cluster[data-cluster="down"] { display: none; }
.digest-toggle {
  cursor: pointer;
  color: var(--fg4);
  font-size: 12px;
  margin-left: 4px;
  user-select: none;
}
.digest-toggle:hover { color: var(--fg2); }
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
thead tr {
  background: transparent;
  border-bottom: none;
}
thead th {
  padding: 0 12px 8px;
  text-align: left;
  color: var(--fg4);
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.10em;
  cursor: pointer;
  user-select: none;
  white-space: nowrap;
}
thead th:hover { color: var(--fg2); }
thead th.sort-asc::after  { content: " ▲"; font-size: 0.75em; }
thead th.sort-desc::after { content: " ▼"; font-size: 0.75em; }
tbody td {
  padding: 10px 12px;
  vertical-align: middle;
  color: var(--fg2);
  border-top: 1px solid var(--border-hair);
}
tbody tr:first-child td { border-top: none; }
tbody tr.leaderboard-row:hover { background: var(--bg-raised); transition: background 140ms var(--ease-standard); }
tbody td:nth-child(n+4) {
  font-family: var(--font-mono);
  font-size: 12px;
}
/* The rail is 3px on EVERY rank cell, transparent when out of band, so an
   in-band row's content does not sit 3px right of an out-of-band row's. */
.rank-cell {
  border-left: 3px solid transparent;
}
.rank-cell.in-band-rail {
  border-left: 3px solid color-mix(in srgb, var(--up) 55%, transparent);
}
.rank-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28px;
  height: 28px;
  padding: 0 6px;
  border-radius: var(--radius-pill);
  background: var(--bg-sunken);
  font-family: var(--font-mono);
  font-weight: 500;
  font-size: 13px;
  color: var(--fg3);
}
.rank-badge.in-buy-band {
  background: color-mix(in srgb, var(--up) 12%, transparent);
  color: var(--up-ink);
}
.rank-badge.rank-1 {
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--up) 14%, transparent);
}
/* Deliberately NOT `display: flex` on the <td>, even though flex/gap is the
   obvious way to space these spans. A <td> whose display is flex stops being a
   table-internal box and gets wrapped in an anonymous table cell — and TWO
   ADJACENT such cells share one anonymous cell, which stacks them vertically.
   .composite-cell (the very next column) is already flex, so a flex .theme-cell
   put the theme name on top of the composite bar in one double-height column.
   Verified in the browser: the six cells' left offsets collapse to four.
   Normal inline flow gives the same baseline alignment and wrapping; the gap
   comes from the margin below. The row builders emit these spans with no
   whitespace between them, so the margin is the ONLY spacing — see the
   whitespace-control markers in index.html.j2's theme cell. */
.theme-cell > * + * {
  margin-left: 8px;
}
.theme-name {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 500;
  color: var(--fg1);
  letter-spacing: -0.01em;
}
.theme-ticker {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--fg5);
  letter-spacing: 0.04em;
}
.arrow.up   { color: var(--up-ink);   font-size: 12px; }
.arrow.down { color: var(--down-ink); font-size: 12px; }

/* Trajectory badges */
.traj-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.02em;
  padding: 3px 9px;
  border-radius: var(--radius-pill);
}
.traj-glyph {
  font-family: var(--font-mono);
  font-size: 12px;
}
/* Only the glyph (↑↑/↑/→/↓/↓↓) is meant to be monospace. Both it and the word
   ("surging", "rising", ...) sit under `tbody td:nth-child(n+4)`, which sets
   the whole cell to --font-mono — so without this, the word renders in mono
   too even though .traj-glyph's own mono rule above is the one that LOOKS
   responsible. Set the word's own span back to the body font explicitly. */
.traj-word {
  font-family: var(--font-body);
}
.traj-badge.traj-strong_up   { color: var(--up-ink);   background: color-mix(in srgb, var(--up) 14%, transparent); }
.traj-badge.traj-up          { color: var(--up-ink);   background: color-mix(in srgb, var(--up) 10%, transparent); }
.traj-badge.traj-flat        { color: var(--fg4);      background: var(--border-hair); }
.traj-badge.traj-down        { color: var(--down-ink); background: color-mix(in srgb, var(--down) 8%, transparent); }
.traj-badge.traj-strong_down { color: var(--down-ink); background: color-mix(in srgb, var(--down) 13%, transparent); }


/* =========================================================
   Leaderboard row breakdown
   ========================================================= */
/* Row hover lives with the other tbody rules above
   (`tbody tr.leaderboard-row:hover`). The `.chevron` rule that used to sit
   here went with the element: the row itself is the disclosure control now. */
.leaderboard-row { cursor: pointer; }
.breakdown-row { display: none; }
.breakdown-row.open { display: table-row; }
.breakdown-inner {
  padding: 16px 20px;
  background: var(--bg-sunken);
  border-top: 1px solid var(--border-soft);
}
.breakdown-grid {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 24px;
  align-items: start;
}
/* 700px breakdown-grid rule moved to css/_responsive.css.j2. */

/* Score tree */
.score-tree {
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 2;
}
.st-row { display: flex; align-items: baseline; gap: 4px; }
.st-top .st-label { font-weight: 600; color: var(--fg1); }
.st-top .st-val   { font-weight: 600; color: var(--brand-strong); }
.st-conn  { color: var(--fg4); white-space: pre; min-width: 2.5em; }
.st-label { color: var(--fg3); }
.st-wt    { color: var(--fg4); font-size: 0.9em; }
.st-val   { color: var(--fg2); margin-left: auto; min-width: 48px; text-align: right; }
.st-meta  { color: var(--fg4); font-size: 0.85em; margin-left: 4px; }
.bd-footer {
  margin-top: 10px;
  font-size: 11px;
  color: var(--fg4);
  border-top: 1px dashed var(--border-soft);
  padding-top: 8px;
  font-family: var(--font-mono);
}

/* Signal tables */
.sig-section { margin-bottom: 12px; }
.sig-title {
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.10em;
  color: var(--fg4);
  margin-bottom: 5px;
}
.sig-table { border-collapse: collapse; width: 100%; font-size: 12px; }
.sig-table td { padding: 3px 6px; vertical-align: middle; }
.sig-label { color: var(--fg3); white-space: nowrap; }
.sig-raw   { color: var(--fg2); font-family: var(--font-mono); text-align: right; min-width: 54px; }
.sig-bar   { padding: 0 8px; }
.sig-z     { color: var(--fg4); font-family: var(--font-mono); text-align: right; min-width: 46px; }
/* Composite cell: centre-origin diverging bar + value.
   The composite is signed, so the bar grows left or right from a zero line
   rather than filling from the left edge. */
.composite-cell { display: flex; align-items: center; gap: 10px; white-space: nowrap; }
.cbar-wrap {
  position: relative;
  flex: 1;
  height: 22px;
  border-radius: 4px;
  background: linear-gradient(
    90deg,
    color-mix(in srgb, var(--down) 5%, transparent),
    color-mix(in srgb, var(--up) 5%, transparent)
  );
  overflow: hidden;
}
.cbar-wrap::before {
  content: "";
  position: absolute;
  left: 50%; top: 3px; bottom: 3px;
  width: 1px;
  background: var(--zero-line);
}
.cbar {
  position: absolute;
  top: 4px; bottom: 4px;
  border-radius: 2px;
}
.cbar.pos { background: var(--up); }
.cbar.neg { background: var(--down); }
.cbar-val {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 500;
  color: var(--fg3);
  font-variant-numeric: tabular-nums;
  min-width: 52px;
  text-align: right;
  flex: none;
}
.cbar-val.pos { color: var(--up-ink); }
.cbar-val.neg { color: var(--down-ink); }

/* Level/Change cell: two stacked centre-origin bars, replacing the two bare
   z-score columns. Same construction as .cbar-wrap, smaller and labelled. */
.lc-cell { display: flex; flex-direction: column; gap: 5px; }
.lc-row { display: flex; align-items: center; gap: 6px; }
.lc-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--fg5);
  width: 44px;
  flex: none;
}
.lc-track {
  position: relative;
  flex: 1;
  height: 5px;
  border-radius: var(--radius-pill);
  background: var(--border-hair);
  overflow: hidden;
}
.lc-track::before {
  content: "";
  position: absolute;
  left: 50%; top: 0; bottom: 0;
  width: 1px;
  background: var(--border);
}
.lc-bar { position: absolute; top: 0; bottom: 0; border-radius: var(--radius-pill); }
.lc-bar.pos { background: var(--up); }
.lc-bar.neg { background: var(--down); }
.lc-val {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--fg3);
  font-variant-numeric: tabular-nums;
  min-width: 44px;
  text-align: right;
  flex: none;
}

.z-bar-wrap {
  position: relative;
  display: inline-block;
  width: 60px; height: 6px;
  background: var(--border);
  border-radius: var(--radius-pill);
  vertical-align: middle;
  overflow: hidden;
}
/* Zero reference: z-scores are signed, so the bar diverges from the centre. */
.z-bar-wrap::before {
  content: "";
  position: absolute;
  left: 50%; top: 0; bottom: 0;
  width: 1px;
  background: var(--fg4);
  opacity: 0.5;
}
.z-bar {
  position: absolute;
  top: 0; bottom: 0;
  border-radius: 1px;
}
.sig-chip   { font-size: 11px; }
.sig-chip.bull { color: var(--up); }
.sig-chip.bear { color: var(--down); }
.sig-chip.neut { color: var(--fg4); }
/* Signal tooltip */
.sig-tip {
  border-bottom: 1px dashed var(--fg4);
  cursor: help;
  position: relative;
}
.sig-tip::after {
  content: attr(data-tip);
  display: none;
  position: absolute;
  left: 0; top: calc(100% + 6px);
  min-width: 220px; max-width: 320px;
  background: var(--bg-raised);
  border: 1px solid var(--border);
  color: var(--fg2);
  font-size: 0.78rem;
  font-family: var(--font-body);
  line-height: 1.55;
  padding: 7px 11px;
  border-radius: var(--radius-md);
  box-shadow: 0 3px 10px rgba(0,0,0,0.12);
  white-space: normal;
  z-index: 200;
  pointer-events: none;
}
.sig-tip:hover::after, .sig-tip:focus::after { display: block; }
/* Setup badges (entry / exit) */
.setup-badge {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  margin-left: 6px;
  vertical-align: middle;
}
.setup-badge.entry {
  color: var(--up);
  background: color-mix(in srgb, var(--up) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--up) 30%, transparent);
}
.setup-badge.exit {
  color: var(--down);
  background: color-mix(in srgb, var(--down) 4%, transparent);
  border: 1px solid color-mix(in srgb, var(--down) 30%, transparent);
}
/* Mute, don't hide: between reviews the badge keeps its kind, text and
   border — only the filled background goes, so it reads as an outline
   rather than a loud pill. Text colour is untouched, so contrast against
   --bg-raised only improves (a tinted background is what made the WCAG
   fixes above necessary; no tint at all is the easy case). See
   applyHorizonBadges()/Rescore.reviewStatus in index.html.j2. */
.setup-badge.entry.muted,
.setup-badge.exit.muted {
  background: transparent;
}
/* Not a signal — a permanent property of the instrument. Deliberately the
   quietest mark on the row: it should answer "why is there no Enter badge and
   no UCITS row?" when the reader looks, not compete with the badges. */
.unbuyable-badge {
  display: inline-block;
  margin-left: 8px;
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.03em;
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  color: var(--fg4);
  background: var(--bg-sunken);
  border: 1px dashed var(--border);
  cursor: help;
  white-space: nowrap;
}
.bd-unbuyable {
  margin: 0;
  font-size: 12px;
  line-height: 1.55;
  color: var(--fg3);
  max-width: 46em;
}

/* Hold is the "do nothing" badge and by far the most common one on a populated
   book, so it is deliberately the quietest of the three — neutral rather than
   up/down, so Enter and Exit keep the eye. */
.setup-badge.hold {
  color: var(--fg3);
  background: var(--bg-sunken);
  border: 1px solid var(--border);
}
/* Position tracking (phase 1) */
.position-toggle {
  border: none;
  background: none;
  cursor: pointer;
  font-size: 0.95rem;
  line-height: 1;
  padding: 0 6px 0 0;
  color: var(--fg4);
  vertical-align: baseline;
}
.position-toggle[aria-pressed="true"] { color: var(--brand-strong); }
.position-toggle:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
  border-radius: 3px;
}
/* Band boundaries — where the active horizon cuts the leaderboard.
   ---------------------------------------------------------------
   The Horizon selector claims to "set the Enter/Exit band", but on a book held
   at the top of the table every preset renders the same badges, so the control
   looked inert (see BACKLOG). These rows make the band itself visible, so
   switching preset always moves something the eye can see.

   2026-08-20 redesign: replaced the invisible border-bottom-on-the-row-above
   approach (a coloured line only, no label — undiscoverable without already
   knowing the horizon preset's top_n/exit rank) with actual inserted, labelled
   rows. applyBandBoundaries() (index.html.j2) inserts/removes these; nothing
   here toggles visibility, the row is either in the DOM or it isn't. The old
   #band-legend swatch legend is gone too — redundant now that the rows
   self-label. */
.band-cut-row td {
  padding: 10px 12px 8px;
  border-top: none;
}
/* Flex DIV inside the <td>, not the <td> itself — see the comment on
   .band-cut-row td's markup site (insertCutRow() in index.html.j2) for why.
   .bcr-rule is the only flexible child (flex: 1), so it absorbs whatever
   width the eyebrow and note don't need instead of a guessed fixed budget —
   a calc(100% - Npx) first pass here wrapped the note onto two lines the
   first time this was measured live in the browser. */
.band-cut-row .bcr-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.band-cut-row .bcr-eyebrow {
  flex: none;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .10em;
  text-transform: uppercase;
  white-space: nowrap;
}
.band-cut-row.buy .bcr-eyebrow { color: var(--brand-strong); }
.band-cut-row.exit .bcr-eyebrow { color: var(--down); }
.band-cut-row .bcr-rule {
  flex: 1;
  height: 0;
  border-top: 2px solid;
}
.band-cut-row.buy .bcr-rule {
  border-top-color: color-mix(in srgb, var(--up) 45%, transparent);
}
.band-cut-row.exit .bcr-rule {
  border-top-color: color-mix(in srgb, var(--down) 55%, transparent);
}
.band-cut-row .bcr-note {
  flex: none;
  font-size: 11px;
  color: var(--fg4);
  white-space: nowrap;
}

.leaderboard-row.position-held {
  background: color-mix(in srgb, var(--brand-strong) 7%, transparent);
}
.leaderboard-row.position-warn {
  box-shadow: inset 3px 0 0 0 var(--down);
}
.leaderboard-row.position-warn td:nth-child(2)::before {
  content: "⚠ ";
  color: var(--down);
}
.sig-info {
  font-size: 11px;
  color: var(--fg4);
  margin-top: 8px;
  border-top: 1px dashed var(--border-soft);
  padding-top: 6px;
}
.info-lbl { font-weight: 500; }

/* Instruments table */
.bd-instruments {
  margin-top: 14px;
  border-top: 1px dashed var(--border-soft);
  padding-top: 10px;
}
.etf-table { border-collapse: collapse; width: 100%; font-size: 12px; }
.etf-table th {
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--fg4);
  border-bottom: 1px solid var(--border-soft);
  padding: 2px 8px 5px;
  text-align: left;
}
.etf-table td { padding: 4px 8px; vertical-align: middle; }
.etf-ticker { font-family: var(--font-mono); font-weight: 600; color: var(--fg2); white-space: nowrap; }
.etf-name   { color: var(--fg3); }
.etf-ter    { font-family: var(--font-mono); color: var(--fg4); text-align: right; white-space: nowrap; }
.etf-isin   { font-family: var(--font-mono); font-size: 11px; color: var(--fg4); }
.etf-match  { font-size: 11px; text-transform: capitalize; white-space: nowrap; }
.etf-match-exact   { color: var(--up); }
.etf-match-close   { color: var(--fg3); }
.etf-match-partial { color: var(--fg4); font-style: italic; }
.etf-link a { color: var(--brand-strong); text-decoration: none; }
.etf-link a:hover { color: var(--brand-strong); }

/* =========================================================
   Leaderboard filter chips
   ========================================================= */
.filter-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.filter-group { display: flex; flex-wrap: wrap; gap: 4px; }
.filter-chip {
  border: 1px solid var(--border);
  background: var(--bg-raised);
  color: var(--fg2);
  border-radius: 999px;
  padding: 3px 10px;
  font: inherit;
  font-size: 0.875rem;
  line-height: 1.6;
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--duration-fast) var(--ease-standard),
              color var(--duration-fast) var(--ease-standard),
              border-color var(--duration-fast) var(--ease-standard);
}
.filter-chip:hover { border-color: var(--brand-strong); color: var(--brand-strong); }
.filter-chip.active {
  background: var(--brand-strong);
  border-color: var(--brand-strong);
  color: var(--surface);
}
.filter-clear {
  border: none;
  background: transparent;
  color: var(--fg4);
  font: inherit;
  font-size: 0.875rem;
  text-decoration: underline;
  cursor: pointer;
}
.filter-clear:hover { color: var(--fg2); }
.filter-clear[hidden] { display: none; }

/* Curated three-chip subset in the always-visible Controls row (spec
   Screen 1 item 5) — its own values, not .filter-chip's: a more prominent
   row gets slightly larger padding (5px 12px vs. 3px 10px). */
.control-chips { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
.control-chip {
  border: 1px solid var(--border);
  background: var(--bg-raised);
  color: var(--fg2);
  border-radius: var(--radius-pill);
  padding: 5px 12px;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
  white-space: nowrap;
}
.control-chip:hover { border-color: var(--brand-strong); color: var(--brand-strong); }
.control-chip[aria-pressed="true"] {
  background: var(--brand-strong);
  border-color: var(--brand-strong);
  color: var(--surface);
}

/* Same popover shape as .rank-settings (_sentiment.css.j2) — both are
   <details> triggers in the same row, so they read as one family. */
.more-filters {
  position: relative;
  border: none;
  background: none;
  margin: 0;
  padding: 0;
}
.more-filters summary {
  cursor: pointer;
  color: var(--fg3);
  font-size: 12px;
  font-weight: 500;
  list-style: none;
  display: inline-flex;
  align-items: center;
  padding: 5px 12px;
  border-radius: var(--radius-pill);
  border: 1px dashed var(--border);
  user-select: none;
  white-space: nowrap;
}
.more-filters summary::-webkit-details-marker { display: none; }
.more-filters summary:hover { color: var(--fg1); background: var(--bg-sunken); }
.more-filters[open] summary { color: var(--fg1); background: var(--bg-sunken); }
.more-filters summary:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
}
.more-filters .filter-bar {
  position: absolute;
  right: 0;
  top: calc(100% + 6px);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 12px 16px;
  z-index: 100;
  min-width: 320px;
}
/* .filter-group sets display:flex, an AUTHOR rule, which beats the UA
   stylesheet's [hidden] { display: none } no matter the specificity. Without
   this the setup group's `hidden` property is set and the chips still render —
   and a guest clicking one filters on a data-setup that is empty on every row,
   emptying the table. */
.filter-group[hidden] { display: none; }
.filter-count { color: var(--fg4); font-size: 0.875rem; }

/* =========================================================
   Horizon selector
   ========================================================= */
.horizon-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin: 0 0 10px;
  font-size: 13px;
}
/* The <select> is source-of-truth state for switchHorizon(), not a visible
   control — display:none removes it from sight and the accessibility tree
   in one property, so the segmented buttons below are never a second,
   competing control for a screen reader to navigate past. */
.horizon-row select { display: none; }
.horizon-eyebrow {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--fg4);
  font-weight: 600;
}
/* Same pill-group pattern as .theme-toggle/.theme-btn (_chrome.css.j2),
   duplicated under its own class names rather than shared — the two
   controls are unrelated and a future .theme-btn change (e.g. glyph-only
   styling) should not silently reach the horizon buttons. */
.horizon-toggle {
  display: inline-flex;
  background: var(--bg-sunken);
  border-radius: var(--radius-pill);
  padding: 3px;
  gap: 2px;
}
.horizon-btn {
  display: inline-flex;
  align-items: center;
  padding: 5px 10px;
  font: inherit;
  font-size: 12px;
  font-weight: 500;
  color: var(--fg3);
  border: none;
  background: transparent;
  border-radius: var(--radius-pill);
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
  transition: color var(--duration-fast) var(--ease-standard),
              background var(--duration-fast) var(--ease-standard);
}
.horizon-btn:hover { color: var(--fg1); }
.horizon-btn[aria-pressed="true"] {
  background: var(--bg-raised);
  color: var(--brand-strong);
  font-weight: 600;
  box-shadow: var(--shadow-xs);
  cursor: default;
}
.horizon-btn:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
}
/* The chosen horizon's cost, beside the control. Separated by hairlines rather
   than middots so the three read as one stat group, not a run-on sentence. */
.horizon-stats {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  color: var(--fg3);
  font-size: 12px;
}
.hz-stat { white-space: nowrap; }
.hz-stat + .hz-stat {
  margin-left: 9px;
  padding-left: 9px;
  border-left: 1px solid var(--border-soft);
}
.horizon-stats b {
  color: var(--fg1);
  font-weight: 600;
  font-variant-numeric: tabular-nums;   /* numbers must not jitter on switch */
}
.horizon-note { color: var(--fg4); font-size: 12px; }
/* Review-due status. .review-next is deliberately as quiet as .horizon-note —
   it is the common, nothing-to-do state. .review-due stands out a little
   more (fg2, not fg4) because it is the one state actually asking for
   attention, without competing with the Enter/Exit badges themselves. */
.review-status { font-size: 12px; }
.review-next { color: var(--fg4); }
.review-due { color: var(--fg2); font-weight: 600; }
.review-done-btn {
  margin-left: 6px;
  font: inherit;
  font-weight: 600;
  padding: 1px 8px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  background: var(--bg-raised);
  color: var(--brand-strong);
  cursor: pointer;
}
.review-done-btn:hover { background: var(--bg-sunken); }
.review-done-btn:focus-visible {
  outline: 2px solid var(--brand-strong);
  outline-offset: 2px;
}

/* Active backtest preset row */
tr.bt-row.active td {
  background: var(--bg-sunken);
  font-weight: 600;
}

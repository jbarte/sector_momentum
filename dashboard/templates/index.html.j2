<!-- ============================================================
     JavaScript
     ============================================================ -->
<script>
{% include '_tabs.js.j2' %}

// Ordered cohort regions, from config via src/cohorts.py. Everything that
// regroups leaderboard rows must iterate THIS rather than a literal
// ["US","EU"] — a hardcoded pair silently misfiles THEME rows into the US
// group and strands the Themes header.
var COHORT_REGIONS = [{% for c in cohort_list %}"{{ c.region }}"{% if not loop.last %}, {% endif %}{% endfor %}];

// Horizon presets, from config/weights.yaml via src/horizons.py. A preset is a
// (cadence, top_n, buffer) triple; top_n/buffer are pure rank comparisons, so
// switching preset re-derives the Enter/Hold/Exit badges in the browser with no
// rebuild. Cadence only selects which precomputed backtest curve to show —
// re-simulating a different cadence needs a replay and cannot happen here.
var HORIZONS = {{ horizons_json | js_json }};
var HORIZON_DEFAULT = {{ horizon_default_json | js_json }};
window.HORIZON_DEFAULT = HORIZON_DEFAULT;
// True when auth is configured, i.e. when the baked page is the guest view and
// the Enter/Hold/Exit badge is a signed-in feature. See build.py:badges_gated.
// Written so that a MISSING context key gates rather than ungates: a plain
// `if badges_gated` would render `false` for an undefined variable, silently
// publishing the badge to guests. Failure here should cost a feature, not leak one.
var BADGES_GATED = {{ 'false' if badges_gated is defined and not badges_gated else 'true' }};
var activeHorizon = HORIZON_DEFAULT.key;

var _HORIZON_LS = "sm_horizon";
try {
  var _saved = localStorage.getItem(_HORIZON_LS);
  if (_saved && HORIZONS.some(function (h) { return h.key === _saved; })) {
    activeHorizon = _saved;
  }
} catch (e) { /* private mode: fall back to the default */ }

function currentHorizon() {
  for (var i = 0; i < HORIZONS.length; i++) {
    if (HORIZONS[i].key === activeHorizon) { return HORIZONS[i]; }
  }
  return HORIZON_DEFAULT;
}

// Per-preset "I've seen this review" acknowledgment, keyed by horizon key so
// switching preset does not carry one preset's Done click onto another's
// calendar. One object rather than one key per preset: HORIZONS can grow
// without this needing a matching localStorage migration.
var _REVIEW_ACK_LS = "sm_review_ack";

function getReviewAck(key) {
  try {
    var raw = localStorage.getItem(_REVIEW_ACK_LS);
    var map = raw ? JSON.parse(raw) : {};
    return map[key] || null;
  } catch (e) { return null; /* private mode, or corrupt JSON: fail open */ }
}

function ackReview(key) {
  try {
    var raw = localStorage.getItem(_REVIEW_ACK_LS);
    var map = raw ? JSON.parse(raw) : {};
    map[key] = window.Rescore.localISODate();
    localStorage.setItem(_REVIEW_ACK_LS, JSON.stringify(map));
  } catch (e) { /* private mode: the click still mutes this render, just not
                   a future page load — acceptable, matches every other
                   localStorage preference on this page. */ }
  renderReviewStatus();
  applyHorizonBadges();
}

// The active horizon's due/muted state, recomputed fresh on every call —
// never cached, so it is always correct relative to the reader's actual
// clock even on a page built days ago.
//
// Guarded like every other window.Rescore call site (applyHorizonBadges
// below, auth.js) — this one matters more than most: renderReviewStatus()
// calls it BEFORE applyHorizonBadges() in both initHorizonSelect() and
// switchHorizon(), so an unguarded throw here (a stale cache, a blocked
// script, a network hiccup) would abort badge rendering, band boundaries and
// the Done-button binding too, not just the review chip.
function currentReviewStatus() {
  if (!window.Rescore || !window.Rescore.reviewStatus || !window.Rescore.localISODate) {
    return { due: true, dueDate: null, nextDate: null };
  }
  var h = currentHorizon();
  return window.Rescore.reviewStatus(
    h.review_dates, window.Rescore.localISODate(), getReviewAck(h.key));
}

// The single writer of every leaderboard badge — the horizon switch, the
// signed-in rebuild, the sentiment rescore and the holdings toggle all end up
// here. They used to each emit their own badge markup, and they had already
// drifted: the rescore path was still using the pre-band trajectory heuristic
// that _compute_setup replaced.
//
// Two inputs beyond the row's own data-rank:
//   BADGES_GATED   the badge is the signed-in tier; guests get data-setup=""
//                  and no span, whichever path rendered the row.
//   holdings       Enter vs Hold. See Rescore.badgeForRank for the rule.
var BADGE_TEXT_EN = { entry: '▲ Enter', hold: '● Hold', exit: '▼ Exit' };
var BADGE_I18N = { entry: 'badge_entry', hold: 'badge_hold', exit: 'badge_exit' };

function badgesVisible() {
  return !BADGES_GATED || window.SM_SIGNED_IN === true;
}

// Draw the active horizon's two cut lines into the leaderboard.
//
// Why this exists: the Horizon control is labelled "sets the Enter/Exit band",
// but the badges only differ between presets when a row actually sits between
// two presets' thresholds. On a book held at the top of the table, every preset
// renders identical badges and the selector looks broken. The band is real
// either way — this draws it.
//
// Attached to the LAST QUALIFYING VISIBLE ROW rather than to a fixed rank, for
// two reasons:
//   - ranks tie (rankAverage yields 4.5), so `rank === top_n` can match nothing;
//   - filters hide rows, and a line anchored to a hidden row would vanish.
// Reading "everything above this line is inside the band" stays true under any
// filter, which a fixed-rank line would not.
//
// Mobile cards — a read-only projection of the table's live DOM state, not a
// fourth independently-built row format (alongside dashboard/rows.py,
// auth.js's renderLatestRows(), scan-history.js). It reads whatever
// .leaderboard-row / .band-cut-row elements currently exist in the table
// (already correctly sorted, filtered, banded, and badged by the functions
// below) and rebuilds .leaderboard-cards to match — so cards stay in sync
// with every table interaction with no card-specific reimplementation of
// sorting, filtering, band cuts, or badges. Called from applyBandBoundaries()
// below (which itself is already called by sortTable(), applyFilters(), and
// applyHorizonBadges() — verified, not assumed, before writing this) and
// directly from scan-history.js's showScan(), the one path that genuinely
// bypasses applyBandBoundaries() entirely (its rows carry no data-rank).
function _renderMobileCardsNow() {
  var container = document.getElementById('leaderboard-cards');
  var tbody = document.querySelector('#leaderboard-table tbody');
  if (!container || !tbody) return;

  // This function has always rebuilt every card from scratch
  // (container.innerHTML below), which was safe because nothing INSIDE a
  // card could previously trigger a rebuild -- only sort/filter/badge-
  // refresh did, none of which fire while a user has a card open or
  // focused. The position-toggle click delegation further down is the
  // first thing that can trigger a rebuild FROM INSIDE a card: without
  // this capture/restore, tapping the star silently collapsed every open
  // card's breakdown (every rebuilt card hardcodes aria-expanded="false")
  // and dropped keyboard/AT focus to <body> with no restoration, since the
  // focused button is destroyed and replaced mid-click. Found in code
  // review, 2026-08-24 -- confirmed independently by four of the eight
  // review angles.
  var openSectorIds = {};
  Array.prototype.forEach.call(container.querySelectorAll('.leaderboard-card.open'), function (c) {
    if (c.dataset.sectorId) { openSectorIds[c.dataset.sectorId] = true; }
  });
  var activeEl = document.activeElement;
  var focusSectorId = null;
  var focusWasToggle = false;
  if (activeEl && container.contains(activeEl)) {
    var activeCard = activeEl.closest('.leaderboard-card');
    if (activeCard && activeCard.dataset.sectorId) {
      focusSectorId = activeCard.dataset.sectorId;
      focusWasToggle = activeEl.classList.contains('position-toggle');
    }
  }

  var html = '';
  Array.prototype.forEach.call(tbody.children, function (tr) {
    if (tr.style.display === 'none') { return; }

    if (tr.classList.contains('band-cut-row')) {
      var eyebrow = tr.querySelector('.bcr-eyebrow');
      var note = tr.querySelector('.bcr-note');
      html += '<div class="card-cut-row ' + (tr.classList.contains('buy') ? 'buy' : 'exit') + '">'
        + '<span class="ccr-eyebrow">' + (eyebrow ? eyebrow.innerHTML : '') + '</span>'
        + '<span class="ccr-note">' + (note ? note.innerHTML : '') + '</span>'
        + '</div>';
      return;
    }

    if (!tr.classList.contains('leaderboard-row')) { return; }

    var rankBadge = tr.querySelector('.rank-badge');
    var themeName = tr.querySelector('.theme-name');
    var unbuyableBadge = tr.querySelector('.unbuyable-badge');
    var setupBadge = tr.querySelector('.setup-badge');
    var compositeCell = tr.querySelector('.composite-cell');
    var deltaCell = tr.querySelector('.delta-cell');
    var trendBadge = tr.querySelector('.traj-badge');
    var isInBand = tr.cells[0] && tr.cells[0].classList.contains('in-band-rail');
    // positions.js's decorateRow() inserts .position-toggle as .theme-name's
    // SIBLING inside the theme-cell <td> (nameCell.insertBefore(btn,
    // nameCell.firstChild)) -- not inside .theme-name itself -- so reading
    // themeName.innerHTML above never picks it up. Cards had no star toggle
    // and no held/warn styling at all until this was added: the star exists
    // nowhere but the (mobile-hidden) table, so a signed-in mobile reader
    // could not mark or see holdings. Found live, 2026-08-24.
    var positionBtn = tr.querySelector('.position-toggle');
    var isHeld = tr.classList.contains('position-held');
    var isWarn = tr.classList.contains('position-warn');

    // .lc-row order (LEVEL first, CHANGE second) is already pinned by
    // test_level_change_bars_python_and_js_agree — no data-lc-kind attribute
    // needed, positional indexing is as safe as that test makes it.
    var lcRows = tr.querySelectorAll('.lc-row');
    var levelVal = lcRows[0] ? lcRows[0].querySelector('.lc-val') : null;
    var changeVal = lcRows[1] ? lcRows[1].querySelector('.lc-val') : null;

    // The card embeds its OWN copy of the breakdown content, read from the
    // table's <tr class="breakdown-row" id="bd-...">, rather than reusing
    // toggleBreakdown(): that function only toggles a CSS class on the
    // table's own breakdown row, and the table is fully hidden on mobile
    // (#leaderboard-table { display: none }), so a class toggle inside it
    // has no visible effect. A card-local copy, toggled by the card's own
    // class, sidesteps that — see the click handler below.
    var sectorId = tr.dataset.sectorId || '';
    var bdRow = sectorId ? document.getElementById('bd-' + sectorId) : null;
    var bdContent = bdRow ? bdRow.querySelector('td').innerHTML : '';
    // A card is a disclosure only when it has something to disclose.
    // scan-history.js's past-scan rows are built as a bare leaderboard-row
    // <tr> carrying no data-sector-id, with no .breakdown-row sibling, so
    // bdContent is always '' on that path — the one
    // path this stage newly wired renderMobileCards() into. Advertising those
    // cards as role="button"/aria-expanded made every card on a past scan
    // announce itself as an expandable disclosure and then reveal a 0px-tall
    // empty panel. Found in review at a 375px viewport, on scan #159.
    var expandable = bdContent !== '';

    html += '<div class="leaderboard-card'
      + (isInBand ? ' in-band' : '')
      + (isHeld ? ' position-held' : '')
      + (isWarn ? ' position-warn' : '')
      + '"'
      + (expandable ? ' role="button" tabindex="0" aria-expanded="false"' : '')
      + ' data-sector-id="' + sectorId + '">'
      + '<div class="card-line1">'
      + (rankBadge ? '<span class="card-rank">' + rankBadge.outerHTML + '</span>' : '')
      {#- .outerHTML: the button carries its own attributes (aria-pressed,
          title, data-i18n-*) that a plain re-creation would have to restate
          by hand and could drift from decorateRow()'s own markup. It has no
          user-supplied content (just a static ★/☆ glyph), so unlike
          themeName below there is no escaping concern either way -- outerHTML
          is simply the least code, not a second escaping fix. -#}
      + (positionBtn ? positionBtn.outerHTML : '')
      {#- .innerHTML, not .textContent: this function re-derives cards from
          the table's own rendered DOM, and .textContent DECODES entities
          back to plain text ("&lt;img..." -> literal "<img..."), which then
          gets concatenated unescaped into the new `html` string below and
          assigned via container.innerHTML — silently undoing whatever
          escaping the table builder (auth.js/scan-history.js's escapeHtml())
          already did, on every card. .innerHTML instead returns the SAME
          text RE-SERIALIZED with entities intact, safe to reinject. Confirmed
          live: auth.js/scan-history.js's escapeHtml() was verified correct
          in isolation, yet an injected theme name still executed as HTML —
          on the mobile card view, through this exact read-projection.
          .theme-name holds only a single text node (the table builders never
          nest elements inside it), so this is a pure fix, not a behavior
          change for real data. Found in code review, 2026-08-23. -#}
      + '<span class="card-theme">' + (themeName ? themeName.innerHTML : '') + '</span>'
      + (trendBadge ? trendBadge.outerHTML : '')
      + '</div>'
      + '<div class="card-line2">'
      + (compositeCell ? compositeCell.innerHTML : '')
      + '</div>'
      + '<div class="card-line3">'
      + (levelVal ? '<span>Level ' + levelVal.textContent + '</span>' : '')
      + (changeVal ? '<span>Change ' + changeVal.textContent + '</span>' : '')
      + (deltaCell ? '<span class="card-delta">' + deltaCell.innerHTML + '</span>' : '')
      + '</div>'
      + (unbuyableBadge || setupBadge
          ? '<div class="card-badges">'
            + (unbuyableBadge ? unbuyableBadge.outerHTML : '')
            + (setupBadge ? setupBadge.outerHTML : '')
            + '</div>'
          : '')
      + (expandable ? '<div class="card-breakdown">' + bdContent + '</div>' : '')
      + '</div>';
  });

  container.innerHTML = html;
  container.setAttribute('aria-hidden', 'false');

  // Restore what the capture above saved, now that the new cards exist.
  // Re-open by data-sector-id, not position: sort/filter can reorder cards
  // between rebuilds, so index-based restoration would reopen the wrong
  // card.
  if (Object.keys(openSectorIds).length) {
    Array.prototype.forEach.call(container.querySelectorAll('.leaderboard-card'), function (c) {
      if (c.dataset.sectorId && openSectorIds[c.dataset.sectorId]) {
        c.classList.add('open');
        c.setAttribute('aria-expanded', 'true');
      }
    });
  }
  if (focusSectorId) {
    var refocusCard = container.querySelector('.leaderboard-card[data-sector-id="' + focusSectorId + '"]');
    var refocusTarget = refocusCard
      && (focusWasToggle ? refocusCard.querySelector('.position-toggle') : refocusCard);
    if (refocusTarget && typeof refocusTarget.focus === 'function') { refocusTarget.focus(); }
  }

  // Tapping a card toggles ITS OWN embedded breakdown copy (a card-local
  // 'open' class), independent of the table's toggleBreakdown()/'open'
  // state. The two are never visible at the same time (table hidden on
  // mobile, cards hidden on desktop), so independent state causes no
  // visible inconsistency.
  // [role="button"], not every card: a non-expandable card (see `expandable`
  // above) has no breakdown to toggle, so a handler on it would only add an
  // 'open' class nothing reads.
  Array.prototype.forEach.call(container.querySelectorAll('.leaderboard-card[role="button"]'), function (card) {
    card.addEventListener('click', function () {
      var open = card.classList.toggle('open');
      card.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  // The card's .position-toggle button is a fresh element parsed from
  // outerHTML above -- it carries the right attributes but no listener
  // (those never survive innerHTML/outerHTML serialization). Forward the
  // tap to the corresponding TABLE row's real button rather than
  // reimplementing positions.js's held/persist/revert state machine here —
  // same "no card-specific reimplementation" rule this whole function
  // follows for sorting/filtering/badges. That real click runs the actual
  // toggle, then announce() -> sm:positions-changed -> applyHorizonBadges()
  // -> applyBandBoundaries() -> renderMobileCards() again, which rebuilds
  // this card from the now-updated table row (new glyph, position-held/
  // position-warn classes) -- so the star flip and the shading are just
  // this function re-running, not a second state machine to keep in sync.
  Array.prototype.forEach.call(container.querySelectorAll('.position-toggle'), function (btn) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();   // don't also trigger the card's own open/breakdown toggle
      var card = btn.closest('.leaderboard-card');
      var sectorId = card && card.dataset.sectorId;
      var tableBtn = sectorId
        && document.querySelector('.leaderboard-row[data-sector-id="' + sectorId + '"] .position-toggle');
      if (tableBtn) { tableBtn.click(); }
    });
  });
}

// Coalesces repeated calls within one synchronous tick (a click handler, an
// event-dispatch chain, a .then() callback body -- exactly the shape of
// every entry point in BACKLOG.md's "Mobile card list still double/triple-
// renders from several other entry points", 2026-08-24 review) into a single
// real rebuild. Every existing caller (applyBandBoundaries()'s tail call
// below, and scan-history.js's direct call) keeps calling renderMobileCards()
// exactly as before -- this wrapper is the only thing that changed.
//
// renderMobileCards() is therefore NOT synchronous with its caller any more.
// Nothing today reads the card DOM immediately after triggering a change
// (checked: no reference to #leaderboard-cards / .leaderboard-card anywhere
// outside this function and its own click-delegation setup) -- but that is
// now a standing constraint, not just an implementation detail. A future
// caller that needs the rebuild to have happened before it continues should
// await the same microtask queue, not add a synchronous guard here.
var _mobileCardsRenderScheduled = false;
function renderMobileCards() {
  if (_mobileCardsRenderScheduled) return;
  _mobileCardsRenderScheduled = true;
  Promise.resolve().then(function () {
    _mobileCardsRenderScheduled = false;
    _renderMobileCardsNow();
  });
}

// Cell B of the summary strip — the themes currently inside the buy band.
// A read-projection of the table, like renderMobileCards(): a row is in the
// band when its rank cell carries .in-band-rail, which applyHorizonBadges()
// writes from the ACTIVE horizon's top_n. Reading that class rather than
// recomputing the band is what keeps this correct across a horizon switch
// without a second source of truth to keep in step.
function renderBuyBand() {
  var host = document.getElementById('band-pills');
  var tbody = document.querySelector('#leaderboard-table tbody');
  if (!host || !tbody) return;

  var band = [];
  Array.prototype.forEach.call(tbody.querySelectorAll('tr.leaderboard-row'), function (tr) {
    if (tr.style.display === 'none') { return; }
    if (!tr.cells[0] || !tr.cells[0].classList.contains('in-band-rail')) { return; }
    var rankBadge = tr.querySelector('.rank-badge');
    var themeName = tr.querySelector('.theme-name');
    band.push({
      rank: parseFloat(tr.dataset.rank),
      badge: rankBadge ? rankBadge.textContent : '',
      // .innerHTML, not .textContent — same read-projection bug as
      // renderMobileCards() above, and the same fix: .textContent decodes
      // entities back to plain text, which `html += ... + b.name + ...`
      // below then reinjects unescaped via host.innerHTML = html, undoing
      // the table builder's own escaping. Found alongside it in the same
      // review round, 2026-08-23.
      name: themeName ? themeName.innerHTML : ''
    });
  });

  // Rank order, not table order. The band is a set, and every pill prints its
  // own rank — so following a Theme or Composite sort would show "1 2 4 3",
  // which reads as a bug rather than as the table's sort. Found in review at
  // the browser gate. NaN ranks (auth.js writes data-rank="" for a null rank)
  // sort last rather than scrambling the rest.
  band.sort(function (a, b) {
    if (isNaN(a.rank)) { return isNaN(b.rank) ? 0 : 1; }
    if (isNaN(b.rank)) { return -1; }
    return a.rank - b.rank;
  });

  var html = '';
  band.forEach(function (b) {
    html += '<span class="band-pill">'
      + '<span class="bp-rank">' + b.badge + '</span>'
      + '<span>' + b.name + '</span>'
      + '</span>';
  });

  // Empty is a real state, not a bug — a filter can hide every in-band theme.
  // The note is baked in the template and toggled here rather than injected:
  // injecting it needs applyLang() to translate it, and applyLang() re-enters
  // applyFilters() -> applyBandBoundaries() -> renderBuyBand(), which recurses
  // until the stack blows. Found at the browser gate by filtering the band
  // empty; nothing else reaches that path.
  host.innerHTML = html;
  var empty = document.getElementById('band-empty');
  if (empty) { empty.hidden = !!html; }
}

// Per region: cohorts are ranked independently, so each gets its own pair.
function applyBandBoundaries() {
  var h = currentHorizon();
  var table = document.getElementById('leaderboard-table');
  var tbody = table ? table.querySelector('tbody') : null;
  if (!tbody) return;

  // Idempotent: every sort/filter/horizon-switch calls this again. Remove any
  // rows this function inserted last time before computing fresh positions —
  // otherwise repeated calls accumulate duplicate cut rows.
  Array.prototype.forEach.call(
    tbody.querySelectorAll('.band-cut-row'),
    function (r) { r.remove(); }
  );

  var rows = tbody.querySelectorAll('tr.leaderboard-row');
  // A cut line only means anything while the table is in rank order. Sort by
  // Theme or by Composite descending and the band stops being contiguous — the
  // rows inside it scatter, so a single line cannot separate "in" from "out"
  // and would just be a rule under an arbitrary row. Column 0 ascending is the
  // rank sort (see _sortCol/_sortDir defaults).
  //
  // Guards the rest of this function rather than an early return: cards
  // (renderMobileCards() at the very end) must still run when NOT in rank
  // order — sorting by Theme correctly clears band-cut rows above, and cards
  // need to reflect that "no band cut" state too, not just skip the rebuild
  // entirely and go stale. An early return here would have made that call
  // unreachable on every non-rank sort — caught before shipping by tracing
  // this path, not by the substring-only test written for the call itself.
  var rankOrder = (typeof _sortCol === 'undefined') || (_sortCol === 0 && _sortDir === 1);
  if (rankOrder) {

  var lastBuy = {}, lastHold = {};
  Array.prototype.forEach.call(rows, function (tr) {
    if (tr.style.display === 'none') { return; }
    var rank = parseFloat(tr.dataset.rank);
    if (isNaN(rank)) { return; }
    var region = tr.dataset.region || '';
    if (rank <= h.top_n) { lastBuy[region] = tr; }
    if (rank <= h.top_n + h.buffer) { lastHold[region] = tr; }
  });

  function nextVisibleLeaderboardRow(tr) {
    var next = tr.nextElementSibling;
    while (next && (next.style.display === 'none'
                    || !next.classList.contains('leaderboard-row'))) {
      next = next.nextElementSibling;
    }
    return next;
  }

  // Exposed as window.buildBandCutRowHtml — scan-history.js's showScan() also
  // needs this markup. Its rows deliberately carry no data-rank attribute
  // (see the comment on railClass in that file), which is exactly what this
  // function's callers below rely on to find a row at all, so scan-history.js
  // computes its own cut positions from its in-memory rank data and calls
  // this for the markup only, rather than sharing the DOM-attribute-driven
  // pass below.
  //
  // data-i18n, English text, no translation call: matches auth.js's
  // UNBUYABLE_BADGE, this codebase's established pattern for content
  // inserted after the page's initial i18n pass has already run — "the next
  // apply() call (a language toggle) picks it up for free" (see
  // _i18n.html.j2's applyToEl() docstring). applyLangToEl() does not apply
  // here: it only translates data-i18n-title/data-i18n-aria, not plain
  // data-i18n text content — and calling the full window.applyLang() here
  // would recurse (applyBandBoundaries() is itself called from
  // applyFilters(), which applyLang() calls at the end of every run).
  // noteParts: array of {key, en} for a translatable segment, or {text} for
  // a literal one that is never translated (the interpolated rank number).
  // Bakes in the correct text for the CURRENT language via window.translate
  // (from _i18n.html.j2) at build time — this function is called on every
  // sort/filter/horizon-switch, unlike a once-per-row-rebuild case, so
  // "insert English + data-i18n, wait for the next language toggle" would
  // visibly reset already-translated text back to English on the reader's
  // very next interaction (found live, browser-verified, by whole-branch
  // review). window.translate may not exist yet on the very first
  // applyHorizonBadges() call at initial page load — it runs before
  // _i18n.html.j2's script does — so this falls back to the plain English
  // text, same as every other data-i18n element does until that script runs.
  function buildBandCutRowHtml(kind, eyebrowKey, eyebrowText, noteParts) {
    var t = window.translate || function (key, en) { return en; };
    var noteHtml = noteParts.map(function (p) {
      return p.key
        ? '<span data-i18n="' + p.key + '">' + t(p.key, p.en) + '</span>'
        : p.text;
    }).join(' ');
    // .bcr-row is a flex DIV inside the <td>, not the <td> itself — Stage 1
    // already hit the bug this avoids: two ADJACENT flex table cells merge
    // into one anonymous cell (see .lc-cell's identical wrapper pattern).
    // flex:1 on .bcr-rule lets it absorb whatever width the eyebrow/note
    // don't need, rather than a guessed calc() budget that wrapped the note
    // onto two lines the first time this was measured live.
    return '<tr class="band-cut-row ' + kind + '"><td colspan="5">'
      + '<div class="bcr-row">'
      + '<span class="bcr-eyebrow" data-i18n="' + eyebrowKey + '">' + t(eyebrowKey, eyebrowText) + '</span>'
      + '<span class="bcr-rule"></span>'
      + '<span class="bcr-note">' + noteHtml + '</span>'
      + '</div></td></tr>';
  }
  window.buildBandCutRowHtml = buildBandCutRowHtml;

  function insertCutRow(afterTr, kind, eyebrowKey, eyebrowText, noteParts) {
    afterTr.insertAdjacentHTML('afterend',
      buildBandCutRowHtml(kind, eyebrowKey, eyebrowText, noteParts));
  }

  Object.keys(lastBuy).forEach(function (region) {
    var tr = lastBuy[region];
    // Only a cut if something is actually below it; a line under the final row
    // separates nothing and reads as a stray border.
    if (!nextVisibleLeaderboardRow(tr)) { return; }
    insertCutRow(tr, 'buy', 'band_buy_ends', 'BUY BAND ENDS',
      [{key: 'band_buy_note', en: 'below this line: not a new buy'}]);
  });

  Object.keys(lastHold).forEach(function (region) {
    var tr = lastHold[region];
    if (!nextVisibleLeaderboardRow(tr)) { return; }
    // The exit cut is the more consequential of the two, so if the buffer left
    // no gap between them (both fall on the same last-visible row), remove any
    // buy-band row that insertion already placed here and let the exit row win.
    var existingBuy = tr.nextElementSibling;
    if (existingBuy && existingBuy.classList.contains('band-cut-row')
        && existingBuy.classList.contains('buy')) {
      existingBuy.remove();
    }
    var exitRank = h.top_n + h.buffer;
    insertCutRow(tr, 'exit', 'band_sell_line', 'SELL LINE', [
      {key: 'band_sell_note_prefix', en: 'a holding that falls past rank'},
      {text: String(exitRank)},
      {key: 'band_sell_note_suffix', en: 'is sold'}
    ]);
  });

  } // if (rankOrder)

  // One call here covers every caller of applyBandBoundaries() —
  // sortTable(), applyFilters(), applyHorizonBadges() (and everything that
  // triggers it: page load, switchHorizon(), ackReview(), the sm:* events
  // including the signed-in upgrade) — so cards stay in sync with the table
  // with no separate wiring in any of those places.
  if (typeof renderMobileCards === 'function') { renderMobileCards(); }
  if (typeof renderBuyBand === 'function') { renderBuyBand(); }
}

function applyHorizonBadges() {
  var h = currentHorizon();
  var visible = badgesVisible();
  var pos = window.SMPositions;
  var rows = document.querySelectorAll('#leaderboard-table tr.leaderboard-row');
  // Computed once per call, not per row: it depends only on the active
  // horizon's calendar and the reader's ack, never on a row's own data.
  // Hold never mutes (see reviewStatus's docstring: "do nothing" has no
  // action to hold back), so this only ever gates entry/exit below.
  // currentReviewStatus() guards window.Rescore itself, so no need to repeat
  // that check here.
  var reviewDue = currentReviewStatus().due;
  // Read once per call, not once per use site: this used to be read again at
  // the per-row suffix branch below AND again at this function's tail (for
  // the window.applyLang() call) -- two localStorage reads of the same value
  // in one pass. Same try/catch fallback ('en' on failure) as before.
  var lang = 'en';
  try { lang = localStorage.getItem('lang') || 'en'; } catch (e) { /* ignore */ }
  // Whether the badge may be personalised at all. Without holdings the
  // action-aware rule would silently delete every Exit badge (nothing is held,
  // so nothing can be exited) — including on an ungated build, where the server
  // baked those Exit badges and this pass runs over them.
  var holdings = (pos && pos.holdingsState) ? pos.holdingsState() : 'unknown';
  // Computed once per pass, not per row: the book is a property of the whole
  // table. Null when holdings are unknown (guest, or the read failed), in
  // which case no suffix is added and behaviour is exactly as before.
  var _bookState = null;
  if (holdings === 'ready' && window.Rescore && window.Rescore.selectBook) {
    var _rankedKeys = [], _heldKeys = [], _unbuyableKeys = [];
    Array.prototype.forEach.call(rows, function (tr) {
      var k = tr.dataset.sectorKey || tr.dataset.sectorId;
      if (!k || !tr.hasAttribute('data-rank')) { return; }
      _rankedKeys.push(k);
      if (pos.isHeld(tr)) { _heldKeys.push(k); }
      if (tr.dataset.unbuyable === '1') { _unbuyableKeys.push(k); }
    });
    _bookState = window.Rescore.selectBook(_rankedKeys, _heldKeys, h, _unbuyableKeys);
  }
  window.SM_BOOK_STATE = _bookState;   // read by the review panel (Task 3)
  Array.prototype.forEach.call(rows, function (tr) {
    var kind = null;
    var rank = parseFloat(tr.dataset.rank);
    // Rows rebuilt by scan-history.js for a PAST scan carry no data-rank
    // ATTRIBUTE at all: that view deliberately shows no action badges, because a
    // ranking from three weeks ago is not something to act on today. Leave those
    // rows alone — otherwise this pass strips their rank-badge highlight, which
    // the old hardcoded class survived only because nothing ever rewrote it.
    // scan-history.js writes that highlight itself, from the active horizon.
    //
    // Tested on the attribute, not on isNaN(rank): auth.js sets data-rank=""
    // for a row whose rank is null, and those rows must keep going through the
    // pass below so any stale badge is cleared, exactly as before.
    if (!tr.hasAttribute('data-rank')) { return; }
    if (visible && window.Rescore && window.Rescore.badgeFor) {
      kind = window.Rescore.badgeFor(
        rank, h, holdings, holdings === 'ready' && pos.isHeld(tr),
        tr.dataset.unbuyable === '1');
    }
    tr.dataset.setup = kind || '';
    // The ⚠ marker is the same fact as the Exit badge, so it is written here
    // rather than derived a second time in positions.js from the DOM the
    // previous pass happened to leave. Only when holdings are known, though:
    // in the band fallback an Exit badge says nothing about ownership.
    tr.classList.toggle('position-warn', kind === 'exit' && holdings === 'ready');

    // The highlighted rank badge follows the ACTIVE horizon's top_n. Written
    // here rather than in applyBandBoundaries() because it is a per-row property,
    // not a boundary: it must stay correct when the table is sorted by Theme or
    // Composite, where the cut lines are deliberately withdrawn. Ungated on
    // purpose — it marks where a rank sits, which top_n already makes public,
    // rather than telling a signed-in reader what to do.
    // The rank cell's left rail is the same fact as the badge tint, so it is
    // toggled from the same already-computed condition. The template bakes an
    // initial `in-band-rail` for the default horizon; without this the rail
    // would go stale the moment a reader switches horizon while the badge
    // beside it re-tinted.
    var rankBadge = tr.cells[0] ? tr.cells[0].querySelector('.rank-badge') : null;
    if (rankBadge && window.Rescore && window.Rescore.inBuyBand) {
      var inBand = window.Rescore.inBuyBand(rank, h);
      rankBadge.classList.toggle('in-buy-band', inBand);
      if (tr.cells[0]) { tr.cells[0].classList.toggle('in-band-rail', inBand); }
    }

    var nameCell = tr.cells[1];
    if (!nameCell) return;
    var badge = nameCell.querySelector('.setup-badge');
    if (!kind) { if (badge) badge.remove(); return; }
    if (!badge) {
      badge = document.createElement('span');
      // Before the Trend badge, not appended: on the build that ships,
      // `badges_gated` bakes no setup badge at all, so this function is the
      // only writer and appending would put the action badge AFTER the health
      // check — the reverse of the order the template bakes when ungated, and
      // the reverse of the sentence the methodology asks readers to construct
      // ("Enter, but falling"). insertBefore(x, null) appends, so a row whose
      // Trend badge is missing still behaves.
      nameCell.insertBefore(badge, nameCell.querySelector('.traj-badge'));
    }
    // Mute, don't hide: the badge KIND and TEXT stay exactly what they were —
    // only the styling class changes. A reader who checks daily still sees
    // the correct call, just visually quiet until it is actually due.
    var isMuted = !reviewDue && (kind === 'entry' || kind === 'exit');
    badge.className = 'setup-badge ' + kind + (isMuted ? ' muted' : '');
    badge.setAttribute('data-i18n', BADGE_I18N[kind]);
    // Self-describing suffix. The badge used to state only WHAT (Enter/Exit)
    // and relied on .muted to convey WHEN -- a signal only detectable by
    // comparison against an active badge that is not on screen. It failed:
    // the reader traded on every rank change for weeks. The suffix states the
    // timing (and the no-slot case) on the badge itself.
    var suffix = "";
    if (kind === 'entry' && _bookState && _bookState.freeSlots === 0) {
      suffix = ' · ' + (window.translate
        ? window.translate('badge_no_slot', 'no slot') : 'no slot');
    } else if (!reviewDue && (kind === 'entry' || kind === 'exit')) {
      var nextISO = currentReviewStatus().nextDate;
      if (nextISO && window.Rescore && window.Rescore.shortDate) {
        suffix = ' · ' + window.Rescore.shortDate(nextISO, lang);
      }
    }
    badge.textContent = BADGE_TEXT_EN[kind] + suffix;
    // data-en must be rewritten, not left to _i18n.html.j2's first-sight
    // capture: this span is REUSED across kinds, and applyLang() restores
    // English from data-en. A span that went Enter -> Hold would otherwise
    // carry data-en="▲ Enter" and snap back to Enter on the next EN pass.
    // Bare kind text ONLY -- no suffix -- because data-en is now the "en"
    // base that _i18n.html.j2's apply() reads before appending data-suffix
    // itself; a suffix baked into data-en would get double-appended (English
    // base with the suffix already on it, then apply() appends it again).
    badge.setAttribute('data-en', BADGE_TEXT_EN[kind]);
    // The dynamic, untranslated part (a date, "no slot"), read by apply()'s
    // [data-i18n] loop in BOTH languages so a language toggle after this
    // render doesn't drop it (see the bug this fixes, documented in
    // _i18n.html.j2's apply()). Must be removed, not left stale, when this
    // render has no suffix -- otherwise a badge that goes from
    // "Enter · no slot" to a plain "Enter" keeps showing the old suffix on
    // the next language toggle, since apply() only reads data-suffix, it
    // doesn't know this render's suffix went away.
    if (suffix) {
      badge.setAttribute('data-suffix', suffix);
    } else {
      badge.removeAttribute('data-suffix');
    }
  });

  // applyFilters() (below) ends with its own applyBandBoundaries() call
  // (guarded only on that function existing, which it always does here --
  // both are declared in this same script block), so calling it here too
  // would run applyBandBoundaries()'s cut-row recompute and renderBuyBand()
  // TWICE in the same tick for no benefit. Call it directly only in the
  // fallback branch, where applyFilters() itself is unavailable and nothing
  // else in this function will call it.
  //
  // NOT load-bearing for the double/triple-render bug any more: since
  // renderMobileCards() itself coalesces repeated calls within one tick
  // (see its own comment), removing this guard would no longer bring that
  // bug back -- it would only make applyBandBoundaries()'s cheaper cut-row/
  // renderBuyBand() work run twice. Kept as a minor efficiency, not a
  // correctness requirement. See sector_momentum-notes/specs/2026-08-25-
  // mobile-render-coalescing-design.md.
  if (typeof applyFilters !== 'function') { applyBandBoundaries(); }

  var setupFilters = document.getElementById('filter-group-setup');
  if (setupFilters && setupFilters.hidden !== !visible) {
    setupFilters.hidden = !visible;
    // Dropping the chips without dropping the state they set would leave an
    // invisible filter pinning the table to zero rows. The guard is for the
    // init call, which can run before _filterState's `var` is evaluated.
    if (!visible && typeof _filterState !== 'undefined' && _filterState) {
      _filterState.setup = [];
    }
    Array.prototype.forEach.call(
      setupFilters.querySelectorAll('.filter-chip'), function (c) {
        if (visible) return;
        c.classList.remove('active');
        c.setAttribute('aria-pressed', 'false');
      });
  }

  // Badge text is written in English above; without this a Swedish reader got
  // English badges from every path except the initial page load.
  //
  // window.applyLang() (_i18n.html.j2's apply()) ends with its OWN
  // window.applyFilters() call (guarded only on that function existing,
  // which it always does on a real page) — "the leaderboard filter count is
  // built in JS... re-render it in the new language", its own comment says
  // — so calling applyFilters() again right after, unconditionally, would
  // run applyBandBoundaries()'s cut-row recompute and renderBuyBand() twice
  // for no benefit. Only take the explicit branch when applyLang() did not
  // already run — real page loads always have window.applyLang, so in
  // practice this makes the choice once, deterministically, not a runtime
  // toggle between the two.
  //
  // NOT load-bearing for the double/triple-render bug any more, same as the
  // guard above: renderMobileCards() itself now coalesces repeated calls
  // within one tick, so this guard is a minor efficiency, not a correctness
  // requirement. See sector_momentum-notes/specs/2026-08-25-mobile-render-
  // coalescing-design.md.
  if (window.applyLang) {
    window.applyLang(lang);
  } else if (typeof applyFilters === 'function') {
    applyFilters();
  }
}

// Anything that changes gating, holdings, or the rendered rows re-runs the
// single pass rather than patching badges itself.
document.addEventListener('sm:auth-changed', applyHorizonBadges);
document.addEventListener('sm:positions-changed', applyHorizonBadges);
document.addEventListener('sm:leaderboard-upgraded', applyHorizonBadges);
// No separate listener needed for applyBandBoundaries() here: applyHorizonBadges()
// already calls it unconditionally at its own end, so the signed-in path was
// never actually missing a band cut of any kind — that was a research error
// in the Stage 2 plan, caught by whole-branch review and reverted. Only
// scan-history.js's showScan() genuinely needed new wiring (see that file) —
// it never called applyHorizonBadges() (or applyBandBoundaries()) at all, and
// couldn't rely on either even if it did, since its rows deliberately carry
// no data-rank attribute.

// Sync the <select> to the restored state. Without this the control shows the
// first option while activeHorizon is whatever localStorage (or the config
// default) says — the page would render one band and label it another.
// The selected horizon's cost, rendered beside the control. Only the numbers
// are written here; the unit words are i18n-managed nodes and must not be
// touched, or a language switch would blank them.
function renderHorizonStats(key) {
  var h = null;
  for (var i = 0; i < HORIZONS.length; i++) {
    if (HORIZONS[i].key === key) { h = HORIZONS[i]; break; }
  }
  if (!h) { return; }
  function set(id, value) {
    var el = document.getElementById(id);
    if (el) { el.textContent = value; }
  }
  // trades_per_year / median_holding_days are optional in config — a preset
  // with no recorded backtest shows an em dash rather than "NaN".
  set('hz-held', h.top_n);
  set('hz-exit', h.exit_rank);
  set('hz-hold', h.median_holding_days == null
      ? '—' : '~' + Math.round(h.median_holding_days) + 'd');
  set('hz-trades', h.trades_per_year == null
      ? '—' : Math.round(h.trades_per_year));
}

// Which of "Review due [Done ✓]" / "Next review: <date>" is showing. Reads
// currentHorizon() itself rather than taking one as a parameter, matching
// applyHorizonBadges() — both are "recompute from the active horizon" passes
// callers just invoke after anything that could change it.
function renderReviewStatus() {
  var dueEl = document.getElementById('review-due');
  var nextEl = document.getElementById('review-next');
  if (!dueEl || !nextEl) { return; }
  var status = currentReviewStatus();
  dueEl.hidden = !status.due;
  nextEl.hidden = status.due;
  var dateEl = document.getElementById('review-next-date');
  if (dateEl) { dateEl.textContent = status.nextDate || '—'; }
}

// Mirrors theme.js's updateControlUI(): reflect `key` on every button's
// aria-pressed, called both on init and from switchHorizon() so a
// programmatic call (a deep link, a test, the hidden <select>'s own
// onchange) keeps the visible control in step, not only the state.
function updateHorizonToggleUI(key) {
  Array.prototype.forEach.call(document.querySelectorAll('.horizon-btn'), function (b) {
    b.setAttribute('aria-pressed', b.getAttribute('data-horizon-choice') === key ? 'true' : 'false');
  });
}

function initHorizonSelect() {
  var sel = document.getElementById('horizon-select');
  if (sel) { sel.value = activeHorizon; }
  updateHorizonToggleUI(activeHorizon);
  Array.prototype.forEach.call(document.querySelectorAll('.horizon-btn'), function (b) {
    b.addEventListener('click', function () { switchHorizon(b.getAttribute('data-horizon-choice')); });
  });
  renderHorizonStats(activeHorizon);
  renderReviewStatus();
  var doneBtn = document.getElementById('review-done-btn');
  if (doneBtn) {
    doneBtn.addEventListener('click', function () { ackReview(currentHorizon().key); });
  }
  Array.prototype.forEach.call(document.querySelectorAll('.bt-row'), function (tr) {
    tr.classList.toggle('active', tr.dataset.horizon === activeHorizon);
  });
  // Always, not only when the restored horizon differs from the baked one:
  // this pass also hides the Enter/Hold/Exit filter chips for guests, and a
  // guest who never touched the horizon selector would otherwise keep a chip
  // group that can only empty the table.
  applyHorizonBadges();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initHorizonSelect);
} else {
  initHorizonSelect();
}

function switchHorizon(key) {
  activeHorizon = key;
  // Keep the control in step. The usual path is the <select>'s own onchange, so
  // it already matches — but a programmatic call (a deep link, a test) would
  // otherwise leave the dropdown displaying one horizon while the board, the
  // stats strip, the band lines and the alerts notice all describe another.
  var _sel = document.getElementById('horizon-select');
  if (_sel && _sel.value !== key) { _sel.value = key; }
  updateHorizonToggleUI(key);
  try { localStorage.setItem(_HORIZON_LS, key); } catch (e) { /* ignore */ }
  renderHorizonStats(key);
  renderReviewStatus();
  applyHorizonBadges();
  // A past scan's rows bake their band highlight at render time and are skipped
  // by applyHorizonBadges (no data-rank), so re-render to pick up the new band.
  if (window.SM_ACTIVE_SCAN_ID != null && typeof window.showScan === 'function') {
    window.showScan(window.SM_ACTIVE_SCAN_ID);
  }
  // Highlight the matching backtest row and redraw its curve.
  Array.prototype.forEach.call(document.querySelectorAll('.bt-row'), function (tr) {
    tr.classList.toggle('active', tr.dataset.horizon === key);
  });
  _rendered.backtest = false;
  renderBacktest();
}

// {region, label} pairs — a companion to COHORT_REGIONS rather than a
// widened version of it. COHORT_REGIONS is consumed in many places above
// as a plain array of region strings (`.forEach(function(region) {...})`);
// changing its element shape would break every one of those call sites.
// External assets (auth.js, scan-history.js) that also need the
// human-readable label read this instead.
var COHORTS = {{ cohorts_json | js_json }};   // [{region, label}, ...]

// Theme names with no route to purchase (config/themes.yaml `unbuyable: true`).
// Read by auth.js, which rebuilds the leaderboard from v_recent_scores and so
// has no other way to know.
var UNBUYABLE = {{ unbuyable_json | js_json }};
window.UNBUYABLE = UNBUYABLE;

// Theme name -> US ETF ticker (config/themes.yaml). Same reason as UNBUYABLE
// above: auth.js rebuilds the leaderboard from v_recent_scores, which carries
// no ticker column.
var THEME_TICKERS = {{ theme_tickers_json | js_json }};
window.THEME_TICKERS = THEME_TICKERS;

// Light->dark hex map for the baked Plotly figures (Task 7 consumes this).
var CHART_DARK = {{ chart_dark_json | js_json }};
window.CHART_DARK = CHART_DARK;

// ----- Plotly data (injected by build.py) -----
// COHORT_CHARTS is keyed by cohort region ("US"/"EU"/"THEME"); each entry
// holds that cohort's own rrg/movers/history/drilldown figures plus the
// list of sector keys the Drill-down dropdown should offer. Cohorts are
// never merged onto one figure — see the cohort-select-row comment above.
var COHORT_CHARTS = {{ cohort_charts_json | js_json }};
var activeCohort = COHORT_REGIONS.length ? COHORT_REGIONS[0] : null;
var RESCORE_DATA = {{ rescore_data_json | js_json }};
var SCAN_HISTORY = {{ scan_history_json | js_json }};
var BACKTEST_DATA = {{ backtest_json | js_json }};
{% if correlation_fig_json %}
var CORRELATION_DATA = {{ correlation_fig_json | js_json }};
{% endif %}

// ----- Render helpers -----
var _rendered = {};

function renderRRG() {
  if (_rendered.rrg) return;
  _rendered.rrg = true;
  var chart = COHORT_CHARTS[activeCohort];
  if (!chart) return;
  SMTheme.smPlot('rrg-chart', chart.rrg);
}

function renderMovers() {
  if (_rendered.movers) return;
  _rendered.movers = true;
  var chart = COHORT_CHARTS[activeCohort];
  if (!chart) return;
  SMTheme.smPlot('movers-chart', chart.movers);
}

function renderHistory() {
  if (_rendered.history) return;
  _rendered.history = true;
  var chart = COHORT_CHARTS[activeCohort];
  if (!chart) return;
  SMTheme.smPlot('history-chart', chart.history);
}

// One container for the active cohort's track. This used to iterate a
// hardcoded ['US', 'EU'] against per-cohort container ids, which meant that
// after the sector cohorts were retired it looked up backtest-chart-US/EU
// while activeCohort was THEME — and rendered nothing at all.
function renderBacktest() {
  if (_rendered.backtest) return;
  _rendered.backtest = true;
  var el = document.getElementById('backtest-chart');
  var f = el && BACKTEST_DATA[activeHorizon];
  if (el) {
    el.style.display = f ? '' : 'none';
    if (f) SMTheme.smPlot(el, f);
  }
}

function renderCorrelation() {
  if (_rendered.correlation) return;
  _rendered.correlation = true;
  if (typeof CORRELATION_DATA !== 'undefined') {
    SMTheme.smPlot('correlation-chart', CORRELATION_DATA);
  }
}

function renderDrilldown() {
  _rendered.drilldown = false; // always re-render on sector change
  updateDrilldown();
}

// Rebuilds the Drill-down sector <select> from the active cohort's own key
// list. Cohorts don't share sector keys (US|Energy vs THEME|Space), so the
// dropdown must be repopulated on every cohort switch rather than filtered.
function _populateDrilldownSelect() {
  var sel = document.getElementById('sector-select');
  if (!sel) return;
  var chart = COHORT_CHARTS[activeCohort];
  var keys = (chart && chart.keys) || [];
  sel.innerHTML = '';
  keys.forEach(function (k) {
    var opt = document.createElement('option');
    opt.value = k;
    opt.textContent = k;
    sel.appendChild(opt);
  });
}

function updateDrilldown() {
  var sel = document.getElementById('sector-select');
  if (!sel) return;
  var key = sel.value;
  var chart = COHORT_CHARTS[activeCohort];
  var fig = chart && chart.drilldown ? chart.drilldown[key] : null;
  if (!fig) {
    document.getElementById('drilldown-chart').innerHTML =
      '<p style="padding:24px;color:var(--fg4)">No data for ' + key + '</p>';
    return;
  }
  SMTheme.smPlot('drilldown-chart', fig);
}

// ----- Cohort switching -----
// Drives RRG / Drill-down / Movers / History / Backtest. Clears the render
// memo and re-renders whichever chart tab is currently visible; other tabs
// pick up the new activeCohort lazily the next time they're activated.
function switchCohort(region) {
  activeCohort = region;
  _rendered = {};
  _populateDrilldownSelect();
  var active = document.querySelector('.tab-panel.active');
  if (!active) return;
  var name = active.id.replace('tab-', '');
  if (name === 'rrg')       renderRRG();
  if (name === 'movers')    renderMovers();
  if (name === 'history')   renderHistory();
  if (name === 'drilldown') renderDrilldown();
  if (typeof renderBacktest === 'function' && name === 'backtest') renderBacktest();
}
window.switchCohort = switchCohort;

// Re-skin whichever chart tab is currently visible when the theme changes —
// via the manual control, or the OS flipping under a reader on Auto. Mirrors
// switchCohort()'s own "find the active tab, re-render only that one" shape;
// every other tab picks up the new theme lazily via smPlot() the next time
// it's opened, same as switchCohort's own comment already explains.
document.addEventListener('sm:theme-changed', function () {
  _rendered = {};
  var active = document.querySelector('.tab-panel.active');
  if (!active) return;
  var name = active.id.replace('tab-', '');
  if (name === 'rrg')       renderRRG();
  if (name === 'movers')    renderMovers();
  if (name === 'history')   renderHistory();
  if (name === 'drilldown') renderDrilldown();
  if (typeof renderBacktest === 'function' && name === 'backtest') renderBacktest();
  if (name === 'correlation') renderCorrelation();
});

_populateDrilldownSelect();
if (window.SMTheme) { window.SMTheme.initControl(); }

// ----- Breakdown toggle -----
function toggleBreakdown(id) {
  var bdRow = document.getElementById('bd-' + id);
  var row   = document.querySelector('.leaderboard-row[data-sector-id="' + id + '"]');
  if (!bdRow) return;
  bdRow.classList.toggle('open');
  if (row) row.setAttribute('aria-expanded', bdRow.classList.contains('open') ? 'true' : 'false');
}

// ----- Sortable table -----
var _sortCol = 0, _sortDir = 1; // dir: 1=asc, -1=desc

// ----- Leaderboard filtering -----
// Visibility-only: filters decide which rows show, sortTable decides order.
var _filterState = { setup: [], trend: [], thresholds: [] };

var _TREND_GROUPS = {
  rising:  ['up', 'strong_up'],
  flat:    ['flat'],
  falling: ['down', 'strong_down']
};

// Dynamic string (count), so it carries its own EN/SV pair rather than
// going through the static data-i18n pass.
var _FILTER_MSG = { showing: { en: 'Showing %X of %N', sv: 'Visar %X av %N' } };

function _filterLang() {
  try { return localStorage.getItem('lang') === 'sv' ? 'sv' : 'en'; }
  catch (e) { return 'en'; }
}

function _filterAnyActive() {
  return !!(_filterState.setup.length || _filterState.trend.length
            || _filterState.thresholds.length);
}

function _matchesSetup(r) {
  if (!_filterState.setup.length) return true;
  return _filterState.setup.indexOf(r.dataset.setup || '') !== -1;
}

function _matchesTrend(r) {
  if (!_filterState.trend.length) return true;
  var state = r.dataset.trend || '';
  for (var i = 0; i < _filterState.trend.length; i++) {
    var grp = _TREND_GROUPS[_filterState.trend[i]] || [];
    if (grp.indexOf(state) !== -1) return true;
  }
  return false;
}

function _matchesThresholds(r) {
  // Each active threshold is an independent AND predicate. A missing attribute
  // parses to NaN, and every comparison with NaN is false — so it fails, which
  // is what we want (an unscored/unranked row is not "> 0" or "top 5").
  var t = _filterState.thresholds;
  for (var i = 0; i < t.length; i++) {
    if (t[i] === 'composite_pos' && !(parseFloat(r.dataset.composite) > 0)) return false;
    if (t[i] === 'change_pos'    && !(parseFloat(r.dataset.change) > 0))    return false;
    if (t[i] === 'top5'          && !(parseInt(r.dataset.rank, 10) <= 5))   return false;
  }
  return true;
}

function _collapseBreakdown(sectorId) {
  // Breakdown rows show via the `open` class, so remove the class instead of
  // setting an inline display (an inline style would override `.open` and keep
  // the row collapsed even after the filter is cleared).
  if (!sectorId) return;
  var bd = document.getElementById('bd-' + sectorId);
  if (bd) bd.classList.remove('open');
  // Keep the row's disclosure state in step, exactly as toggleBreakdown() does
  // — a filter that collapses the panel must not leave aria-expanded="true".
  var row = document.querySelector('.leaderboard-row[data-sector-id="' + sectorId + '"]');
  if (row) row.setAttribute('aria-expanded', 'false');
}

function _updateFilterCount(shown, total) {
  var el = document.getElementById('filter-count');
  if (!el) return;
  el.textContent = _filterAnyActive()
    ? _FILTER_MSG.showing[_filterLang()]
        .replace('%X', shown).replace('%N', total)
    : '';
}

function applyFilters() {
  var tbody = document.querySelector('#leaderboard-table tbody');
  if (!tbody) return;
  var rows = tbody.querySelectorAll('tr.leaderboard-row');
  var shown = 0;
  Array.prototype.forEach.call(rows, function (r) {
    var ok = _matchesSetup(r) && _matchesTrend(r) && _matchesThresholds(r);
    r.style.display = ok ? '' : 'none';
    if (ok) { shown++; } else { _collapseBreakdown(r.dataset.sectorId); }
  });
  // The cut lines anchor to the last VISIBLE row inside each band, so they have
  // to be redrawn whenever visibility changes or they stay on a hidden row.
  if (typeof applyBandBoundaries === 'function') { applyBandBoundaries(); }
  _updateFilterCount(shown, rows.length);
  var nm = document.getElementById('filter-no-match');
  if (nm) nm.style.display = (shown === 0 && rows.length > 0) ? '' : 'none';
  var clear = document.getElementById('filter-clear');
  if (clear) clear.hidden = !_filterAnyActive();
}

function clearFilters() {
  _filterState = { setup: [], trend: [], thresholds: [] };
  // NOT scoped to the disclosed filter bar's id — .control-chip lives
  // outside it and must be reset too, or Clear would leave a curated chip
  // pressed. Shares _setChipPressed with _syncChipState below rather than
  // toggling classList/aria-pressed inline a second time — found in
  // whole-branch review, this used to be its own independent copy of the
  // same two-line toggle.
  var chips = document.querySelectorAll('[data-filter-group][data-filter-value]');
  Array.prototype.forEach.call(chips, function (c) { _setChipPressed(c, false); });
  applyFilters();
}

function setFilterBarVisible(visible) {
  // Both halves of the split filter UI: the disclosed full set AND the
  // always-visible curated chips — a past scan's rows carry no filter
  // data-attributes, so both must disappear together or a reader could
  // tap a curated chip that silently does nothing.
  var bar = document.getElementById('leaderboard-filter-bar');
  if (bar) bar.style.display = visible ? '' : 'none';
  var controlChips = document.querySelector('.control-chips');
  if (controlChips) controlChips.style.display = visible ? '' : 'none';
}

// Every element sharing a data-filter-group/data-filter-value pair reflects
// the SAME toggle — a curated .control-chip in the always-visible row and
// its counterpart .filter-chip inside the disclosed full set. Called after
// state changes so neither view can show a pressed state the other
// disagrees with.
// The one place that toggles a chip's own visual pressed state — both
// _syncChipState (a single group/value pair) and clearFilters (every
// chip at once) call this rather than each keeping an independent copy
// of the same classList/aria-pressed toggle.
function _setChipPressed(el, active) {
  el.classList.toggle('active', active);
  el.setAttribute('aria-pressed', active ? 'true' : 'false');
}

function _syncChipState(group, value, active) {
  var selector = '[data-filter-group="' + group + '"][data-filter-value="' + value + '"]';
  Array.prototype.forEach.call(document.querySelectorAll(selector), function (c) {
    _setChipPressed(c, active);
  });
}

(function _wireFilterChips() {
  // NOT scoped to the disclosed filter bar's id — .control-chip lives
  // outside it, in the always-visible row, and needs the same click wiring.
  var chips = document.querySelectorAll('[data-filter-group][data-filter-value]');
  Array.prototype.forEach.call(chips, function (chip) {
    chip.addEventListener('click', function () {
      var group = chip.dataset.filterGroup;
      var arr = _filterState[group];
      if (!arr) return;
      var val = chip.dataset.filterValue;
      var i = arr.indexOf(val);
      var active = i === -1;
      if (active) { arr.push(val); } else { arr.splice(i, 1); }
      _syncChipState(group, val, active);
      applyFilters();
    });
  });
  var clearBtn = document.getElementById('filter-clear');
  if (clearBtn) clearBtn.addEventListener('click', clearFilters);
})();

// MUST run before _i18n.html.j2's include below. applyHorizonBadges()'s
// exactly-once applyBandBoundaries() guarantee (see its own comments) relies
// on window.applyFilters already being assigned by the time _i18n.html.j2's
// apply() checks `typeof window.applyFilters` -- move this include later (or
// _i18n.html.j2 earlier) without also moving this line, and BOTH of
// applyHorizonBadges()'s guards can end up skipping in the same call: not a
// double-render any more, but a render that never happens at all. Code
// review, 2026-08-24, flagged this ordering as "true today, not enforced" --
// test_apply_filters_assigned_before_i18n_include (test_dashboard_js.py)
// pins it.
window.applyFilters = applyFilters;
window.clearFilters = clearFilters;
window.setFilterBarVisible = setFilterBarVisible;

function sortTable(col) {
  if (window._leaderboardUpgraded) return;
  var table   = document.getElementById('leaderboard-table');
  var tbody   = table.querySelector('tbody');
  var headers = table.querySelectorAll('thead th');
  var rows = Array.from(tbody.querySelectorAll('tr.leaderboard-row'));

  if (_sortCol === col) {
    _sortDir *= -1;
  } else {
    _sortCol = col;
    _sortDir = 1;
  }

  headers.forEach(function(h, i) {
    h.classList.remove('sort-asc', 'sort-desc');
    if (i === col) h.classList.add(_sortDir === 1 ? 'sort-asc' : 'sort-desc');
  });

  rows.sort(function(a, b) {
    var aCell = a.querySelectorAll('td')[col];
    var bCell = b.querySelectorAll('td')[col];

    // Column 3 (Level / Change) holds two numbers in one cell's text, which
    // the generic innerText-parse below cannot disambiguate — read the
    // explicit sort key instead (decided: sorts by Level).
    if (col === 3) {
      var aVal = aCell ? parseFloat(aCell.dataset.sortValue) : NaN;
      var bVal = bCell ? parseFloat(bCell.dataset.sortValue) : NaN;
      if (!isNaN(aVal) && !isNaN(bVal)) return (aVal - bVal) * _sortDir;
      if (isNaN(aVal) && isNaN(bVal)) return 0;
      return (isNaN(aVal) ? -1 : 1) * _sortDir;
    }

    var aText = aCell ? aCell.innerText.trim() : '';
    var bText = bCell ? bCell.innerText.trim() : '';

    aText = aText.replace(/[▲▼]/g, '').trim();
    bText = bText.replace(/[▲▼]/g, '').trim();

    // U+2212 back to an ASCII minus first: the signed format the composite and
    // Level/Change cells use renders negatives with a real minus sign, which
    // parseFloat does not understand.
    var aNum = parseFloat(aText.replace(/[+,−]/g, function(m) { return m === '−' ? '-' : ''; }));
    var bNum = parseFloat(bText.replace(/[+,−]/g, function(m) { return m === '−' ? '-' : ''; }));

    if (!isNaN(aNum) && !isNaN(bNum)) return (aNum - bNum) * _sortDir;
    return aText.localeCompare(bText) * _sortDir;
  });

  // Re-append sorted rows, each followed by its own breakdown panel.
  rows.forEach(function(r) {
    tbody.appendChild(r);
    var sectorId = r.dataset.sectorId;
    if (sectorId) {
      var bd = document.getElementById('bd-' + sectorId);
      if (bd) tbody.appendChild(bd);
    }
  });

  // The rows just moved. Without this the band cut lines stay on whichever rows
  // happened to hold them before the sort, landing mid-table under arbitrary
  // themes; applyBandBoundaries() also clears them entirely once the order is
  // no longer by rank.
  if (typeof applyBandBoundaries === 'function') { applyBandBoundaries(); }
}

// Keyboard support for interactive table elements
document.getElementById('leaderboard-table')?.addEventListener('keydown', function(e) {
  if (e.key !== 'Enter' && e.key !== ' ') return;
  var t = e.target;
  if (t.matches('th[onclick]') || t.matches('.leaderboard-row')) {
    e.preventDefault();
    t.click();
  }
});

// Same treatment for the mobile cards, which get role="button"/tabindex="0"
// (renderMobileCards() above) but only a click listener — found in review,
// same class of gap the table's own delegated handler above already exists
// to close. Delegated on the container rather than attached per-card: cards
// are fully rebuilt by renderMobileCards() on every sort/filter/horizon-
// switch, so a per-card listener would need re-adding on every render for
// no benefit over one delegated listener that survives all of them.
document.getElementById('leaderboard-cards')?.addEventListener('keydown', function(e) {
  if (e.key !== 'Enter' && e.key !== ' ') return;
  var t = e.target;
  if (t.matches('.leaderboard-card')) {
    e.preventDefault();
    t.click();
  }
});

// ----- Sentiment toggle wiring -----
(function () {
  var LS_ENABLED = "sentimentEnabled", LS_WEIGHT = "sentimentWeight";
  var toggle = document.getElementById("sentiment-toggle");
  var weightInput = document.getElementById("sentiment-weight");
  var table = document.getElementById("leaderboard-table");
  var weightWrap = weightInput ? weightInput.closest(".sw-weight") : null;
  if (!toggle || !weightInput || !table || typeof Rescore === "undefined") { return; }

  function fmt(n, d) { return (n === null || n === undefined) ? "—" : Number(n).toFixed(d); }

  function updateTrees(scored, W) {
    var dataPct = Math.round((1 - W) * 100), sentPct = Math.round(W * 100);
    Object.keys(scored).forEach(function (key) {
      var sel = '.score-tree[data-sector-key="' + (window.CSS && CSS.escape ? CSS.escape(key) : key) + '"]';
      document.querySelectorAll(sel).forEach(function (tree) {
        var cv = tree.querySelector(".st-composite-val");
        if (cv) { cv.textContent = fmt(scored[key].composite, 3); }
        var dwt = tree.querySelector(".st-data-wt"); if (dwt) { dwt.textContent = "(" + dataPct + "%)"; }
        var swt = tree.querySelector(".st-sent-wt"); if (swt) { swt.textContent = "(" + sentPct + "%)"; }
      });
    });
  }

  // Update the visible leaderboard rows' cells from `scored`.
  function updateRows(rows, scored) {
    rows.forEach(function (tr) {
      var r = scored[tr.getAttribute("data-sector-key")];
      if (!r) { return; }
      var badge = tr.querySelector(".rank-cell .rank-badge");
      // The highlight is applyHorizonBadges()'s to write (it runs at the end
      // of this function and knows the active horizon); only the number here.
      if (badge) { badge.textContent = r.rank; }
      var compCell = tr.querySelector(".composite-cell");
      if (compCell) { compCell.textContent = fmt(r.composite, 3); }
      var deltaCell = tr.querySelector(".delta-cell");
      if (deltaCell) {
        var arrow = r.delta_rank > 0 ? "▲" : (r.delta_rank < 0 ? "▼" : "");
        var cls = r.delta_rank > 0 ? "up" : (r.delta_rank < 0 ? "down" : "");
        var dtxt = r.delta_rank === 0 ? "—" : (r.delta_rank > 0 ? "+" : "") + r.delta_rank.toFixed(1);
        deltaCell.innerHTML = '<span class="arrow ' + cls + '">' + arrow + '</span> ' + dtxt;
      }
      var traj = tr.querySelector(".traj-badge");
      if (traj) { traj.className = "traj-badge traj-" + r.trajectory_state; traj.textContent = r.trajectory_label; }
      // Rescoring changes the rank, and the rank is what the badge is derived
      // from — so data-rank has to move with it or the next badge pass (and the
      // Top 5 filter) would still be reading pre-rescore ranks.
      tr.dataset.rank = r.rank;
    });
    // Badges are not patched here. This path used to carry its own rule — the
    // trajectory + change-score heuristic that _compute_setup replaced with the
    // rank band — so toggling the sentiment weight silently re-badged the board
    // by a rule no other path had used since. One writer now.
    applyHorizonBadges();
  }

  function sortVisibleByRank(rows, scored, tbody) {
    rows.sort(function (a, b) {
      var ra = scored[a.getAttribute("data-sector-key")];
      var rb = scored[b.getAttribute("data-sector-key")];
      return (ra ? ra.rank : 1e9) - (rb ? rb.rank : 1e9);
    });
    rows.forEach(function (tr) {
      tbody.appendChild(tr);
      var sid = tr.getAttribute("data-sector-id");
      var bd = sid ? document.getElementById("bd-" + sid) : null;
      if (bd) { tbody.appendChild(bd); }
    });
  }

  function applyRanking() {
    if (window._leaderboardUpgraded) return;
    var enabled = toggle.checked;
    var weight = Math.min(100, Math.max(0, parseInt(weightInput.value, 10) || 0));
    var W = enabled ? weight / 100 : 0;
    try {
      localStorage.setItem(LS_ENABLED, enabled ? "true" : "false");
      localStorage.setItem(LS_WEIGHT, String(weight));
    } catch (e) {}
    weightInput.disabled = !enabled;
    if (weightWrap) { weightWrap.setAttribute("data-disabled", String(!enabled)); }

    var scored = Rescore.rescore(RESCORE_DATA, W);
    updateTrees(scored, W);

    var tbody = table.querySelector("tbody");
    var rows = Array.prototype.slice.call(
      tbody.querySelectorAll('tr.leaderboard-row'));
    updateRows(rows, scored);
    sortVisibleByRank(rows, scored, tbody);
    // AFTER the re-sort, not before: updateRows() -> applyHorizonBadges() has
    // already drawn the cuts once, but against the pre-rescore DOM order. The
    // rows then move underneath them, so without this pass the lines sit on the
    // wrong themes until some unrelated event happens to redraw them.
    if (typeof applyBandBoundaries === 'function') { applyBandBoundaries(); }
  }

  // Init from persisted state.
  var enabled0 = false, weight0 = 30;
  try {
    enabled0 = localStorage.getItem(LS_ENABLED) === "true";
    var w = parseInt(localStorage.getItem(LS_WEIGHT), 10);
    if (!isNaN(w)) { weight0 = Math.min(100, Math.max(0, w)); }
  } catch (e) {}
  toggle.checked = enabled0;
  weightInput.value = weight0;
  toggle.addEventListener("change", applyRanking);
  weightInput.addEventListener("input", applyRanking);
  if (enabled0) { applyRanking(); }
})();

// Delegated click handler for leaderboard row expansion
document.getElementById('leaderboard-table')?.addEventListener('click', function(e) {

<!DOCTYPE html>
<html lang="en">
<head>
{% include "_theme_init.html.j2" %}
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>ETF Momentum</title>
<link rel="alternate" type="application/atom+xml" title="ETF Momentum Feed" href="feed.xml"/>
<script src="{{ plotly_bundle }}"></script>
<script src="assets/rescore.js"></script>
<script src="assets/theme.js"></script>
<style>
{% include "_style.html.j2" %}
</style>
</head>
<body>

<!-- Header -->
{% set active_segment = "sectors" %}
{% include '_header.html.j2' %}

{% if auth and lag_banner_date %}
<div class="lag-banner" id="lag-banner" role="status">
  <span class="lag-banner-text">
    <span data-i18n="gate_banner_prefix">You're viewing data from</span>
    <strong>{{ lag_banner_date }}</strong><span data-i18n="gate_banner_suffix">. Sign in for the latest data and all features.</span>
  </span>
  <button type="button" class="lag-banner-btn" onclick="document.getElementById('auth-signin').click()" data-i18n="gate_banner_signin">Sign in</button>
</div>
{% endif %}

{% if auth %}
<div class="gate-modal-overlay" id="gate-modal" hidden>
  <div class="gate-modal" role="dialog" aria-modal="true" aria-labelledby="gate-modal-title">
    {% include "_rotation_illo.html.j2" %}
    <h2 id="gate-modal-title" data-i18n="gate_modal_title">ETF Momentum</h2>
    <p data-i18n="gate_modal_body">Sign in for the latest data, or continue browsing with data from last week.</p>
    <form class="auth-form gate-modal-form">
      <input type="email" class="auth-email" required autocomplete="email"
             placeholder="you@example.com" aria-label="Email">
      <button type="submit" class="lang-toggle auth-send" data-i18n="auth_send_link">Send link</button>
      <span class="auth-status" aria-live="polite"></span>
    </form>
    <button type="button" class="gate-modal-continue" id="gate-continue" data-i18n="gate_modal_continue">Continue as guest</button>
  </div>
</div>
{% endif %}

<div class="card">
<!-- Tab bar -->
<nav class="tabs" role="tablist">
  <button class="tab-btn active" onclick="switchTab('leaderboard', this)" role="tab" aria-selected="true" aria-controls="tab-leaderboard" data-i18n="tab_leaderboard">Leaderboard</button>
  <button class="tab-btn" onclick="switchTab('rrg', this)" role="tab" aria-selected="false" aria-controls="tab-rrg" data-i18n="tab_rrg">RRG</button>
  <button class="tab-btn" onclick="switchTab('drilldown', this)" role="tab" aria-selected="false" aria-controls="tab-drilldown" data-i18n="tab_drilldown">Drill-down</button>
  <button class="tab-btn" onclick="switchTab('movers', this)" role="tab" aria-selected="false" aria-controls="tab-movers" data-i18n="tab_movers">Movers</button>
  <button class="tab-btn" onclick="switchTab('history', this)" role="tab" aria-selected="false" aria-controls="tab-history" data-i18n="tab_history">History</button>
  <button class="tab-btn" onclick="switchTab('backtest', this)" role="tab" aria-selected="false" aria-controls="tab-backtest" data-i18n="tab_backtest">Backtest</button>
  <button class="tab-btn" onclick="switchTab('correlation', this)" role="tab" aria-selected="false" aria-controls="tab-correlation" data-i18n="tab_correlation">Correlation</button>
</nav>

<!-- Cohort selector — drives RRG / Drill-down / Movers / History / Backtest.
     rs_ratio/rs_momentum are computed against each cohort's own benchmark
     (THEME vs ACWI), so those tabs render one cohort at a time rather than
     mixing benchmarks on one chart. The Leaderboard (grouped by cohort
     already) and Correlation (one combined heatmap) tabs are unaffected.

     Hidden when only one cohort is configured — a select with a single option
     is a control that cannot do anything. The markup stays so a second cohort
     brings it back with no template change. -->
{% if cohort_list | length > 1 %}
<div class="cohort-select-row">
  <label for="cohort-select" data-i18n="cohort_label">Cohort:</label>
  <select id="cohort-select" onchange="switchCohort(this.value)">
    {% for cohort in cohort_list %}
    <option value="{{ cohort.region }}">{{ cohort.label }}</option>
    {% endfor %}
  </select>
</div>
{% endif %}

<!-- ============================================================
     Tab: Leaderboard
     ============================================================ -->
<section id="tab-leaderboard" class="tab-panel active" role="tabpanel">
  <div class="horizon-row">
    <label for="horizon-select" data-i18n="horizon_label">Horizon:</label>
    <select id="horizon-select" onchange="switchHorizon(this.value)">
      {% for h in horizon_list %}
      <option value="{{ h.key }}">{{ h.label }}</option>
      {% endfor %}
    </select>
    {#- The cost of the chosen horizon, beside the control rather than crammed
        into every option label. Numbers live in their own elements and the unit
        words carry data-i18n: applyLang() rewrites [data-i18n] textContent, so
        putting both in one node would wipe the figures on a language switch.
        The full three-way comparison lives in the Backtest tab, which already
        tabulates every preset and highlights the active row. -#}
    <span class="horizon-stats" id="horizon-stats">
      <span class="hz-stat"><b id="hz-held">—</b> <span data-i18n="hz_held">held</span></span>
      <span class="hz-stat"><b id="hz-hold">—</b> <span data-i18n="hz_hold">median hold</span></span>
      <span class="hz-stat"><b id="hz-trades">—</b> <span data-i18n="hz_trades">trades/yr</span></span>
    </span>
    <span class="horizon-note" data-i18n="horizon_note">Sets the Enter/Exit band. Backtested figures, not predictions.</span>
  </div>
  <div class="utility-row">
    <div class="filter-bar" id="leaderboard-filter-bar">
      {#- Hidden for guests when the badge is gated: these chips filter on
          data-setup, which is empty on every guest row, so leaving them up
          would offer a control that can only ever empty the table.
          applyHorizonBadges() owns the toggle. -#}
      <div class="filter-group" role="group" aria-label="Setup" id="filter-group-setup">
        <button type="button" class="filter-chip" data-filter-group="setup" data-filter-value="entry" aria-pressed="false" data-i18n="filter_entry">▲ Enter</button>
        <button type="button" class="filter-chip" data-filter-group="setup" data-filter-value="hold" aria-pressed="false" data-i18n="filter_hold">● Hold</button>
        <button type="button" class="filter-chip" data-filter-group="setup" data-filter-value="exit" aria-pressed="false" data-i18n="filter_exit">▼ Exit</button>
      </div>
      <div class="filter-group" role="group" aria-label="Trend">
        <button type="button" class="filter-chip" data-filter-group="trend" data-filter-value="rising" aria-pressed="false" data-i18n="filter_rising">↑ Rising</button>
        <button type="button" class="filter-chip" data-filter-group="trend" data-filter-value="flat" aria-pressed="false" data-i18n="filter_flat">→ Flat</button>
        <button type="button" class="filter-chip" data-filter-group="trend" data-filter-value="falling" aria-pressed="false" data-i18n="filter_falling">↓ Falling</button>
      </div>
      <div class="filter-group" role="group" aria-label="Threshold">
        <button type="button" class="filter-chip" data-filter-group="thresholds" data-filter-value="composite_pos" aria-pressed="false" data-i18n="filter_composite_pos">Composite &gt; 0</button>
        <button type="button" class="filter-chip" data-filter-group="thresholds" data-filter-value="top5" aria-pressed="false" data-i18n="filter_top5">Top 5</button>
        <button type="button" class="filter-chip" data-filter-group="thresholds" data-filter-value="change_pos" aria-pressed="false" data-i18n="filter_change_pos">Positive change</button>
      </div>
      <button type="button" class="filter-clear" id="filter-clear" hidden data-i18n="filter_clear">Clear</button>
      <span class="filter-count" id="filter-count"></span>
    </div>
    {#- Visible text rather than aria-label on a bare glyph: an aria-label would
        override the visible name for AT, and a control that silently re-ranks
        the board should say so on its face. -#}
    <details class="rank-settings">
      <summary><span class="rs-glyph" aria-hidden="true">⚙</span><span data-i18n="rank_settings">Ranking</span></summary>
      <div id="sentiment-control" class="sentiment-control">
        <label>
          <input type="checkbox" id="sentiment-toggle"> <span data-i18n="includeSentiment">Include sentiment in ranking</span>
        </label>
        <span class="sw-weight">
          <span data-i18n="weight">Weight:</span> <input type="number" id="sentiment-weight" min="0" max="100" step="1" value="30" disabled>%
        </span>
      </div>
    </details>
    <button type="button" class="tab-guide-btn" data-guide="guide_body_leaderboard" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div id="scan-digest-banner" class="digest-collapsed" style="display:none">
    <span class="digest-cluster" data-cluster="entries">
      <span data-i18n="digest_new_top5">New in Top 5:</span>
      <span class="digest-chips" id="digest-chips-entries"></span>
    </span>
    <span class="digest-toggle" role="button" tabindex="0" onclick="this.closest('#scan-digest-banner').classList.toggle('digest-collapsed'); this.textContent = this.textContent === 'more ▾' ? 'less ▴' : 'more ▾'" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}">more ▾</span>
    <span class="digest-cluster" data-cluster="up">
      <span data-i18n="digest_gains">Biggest gains:</span>
      <span class="digest-chips" id="digest-chips-up"></span>
    </span>
    <span class="digest-cluster" data-cluster="down">
      <span data-i18n="digest_drops">Biggest drops:</span>
      <span class="digest-chips" id="digest-chips-down"></span>
    </span>
  </div>
  <div id="scan-history-banner" style="display:none">
    <span class="scan-history-text" data-i18n="scan_viewing" data-en-prefix="Viewing scan #">Viewing scan #</span>
    <a href="javascript:void(0)" onclick="restoreLatest()" data-i18n="scan_back_to_latest">Back to latest</a>
  </div>
  <div class="table-wrap">
    <table id="leaderboard-table">
      <thead>
        <tr>
          <th onclick="sortTable(0)" data-col="0" tabindex="0" data-i18n="col_rank">#</th>
          <th onclick="sortTable(1)" data-col="1" tabindex="0" data-i18n="col_sector">Theme</th>
          <th onclick="sortTable(2)" data-col="2" tabindex="0" data-i18n="col_composite">Composite</th>
          <th onclick="sortTable(3)" data-col="3" tabindex="0" data-i18n="col_level">Level</th>
          <th onclick="sortTable(4)" data-col="4" tabindex="0" data-i18n="col_change">Change</th>
          {#- "Data" was dropped 2026-08-12: with sentiment weighted 0 by default
              the composite IS the data score, so the column repeated its
              neighbour verbatim in every row. -#}
          <th onclick="sortTable(5)" data-col="5" tabindex="0" data-i18n="col_sentiment">Sentiment</th>
          <th onclick="sortTable(6)" data-col="6" tabindex="0" data-i18n="col_rankdelta">Rank Δ</th>
          <th data-col="7" title="Rank slope over last 3–5 scans" data-i18n="col_trend">Trend</th>
        </tr>
      </thead>
      <tbody>
        {% for row in leaderboard_rows %}
        <tr class="leaderboard-row" data-sector-key="{{ row.key }}" data-sector-id="{{ row.sector_id }}" data-region="{{ row.region }}" data-sector="{{ row.sector }}" data-setup="{{ row.setup or '' }}" data-trend="{{ row.trajectory_state }}"{% if row.unbuyable %} data-unbuyable="1"{% endif %}
            data-composite="{{ row._raw_composite if row._raw_composite is not none else '' }}"
            data-change="{{ row._raw_change if row._raw_change is not none else '' }}"
            data-rank="{{ row.rank }}"
            tabindex="0">
          <td class="rank-cell">
            <span class="rank-badge{% if row.rank is number and row.rank <= 3 %} top3{% endif %}">{{ row.rank }}</span>
            <span class="chevron" id="chev-{{ row.sector_id }}">▶</span>
          </td>
          {#- Never "hold": the build has no reader and so no holdings. When the
              badge is gated, row.setup is None for everyone and applyHorizonBadges()
              writes the real badge once the session and holdings are known. -#}
          <td>{{ row.sector }}{% if row.unbuyable %}<span class="unbuyable-badge" data-i18n="badge_unbuyable" data-i18n-title="unbuyable_tip" title="No UCITS equivalent exists, so this cannot be bought from an EU account. It is still scored because it shapes how every other theme ranks.">⊘ Not buyable</span>{% endif %}{% if row.setup == "entry" %}<span class="setup-badge entry" data-i18n="badge_entry">▲ Enter</span>{% elif row.setup == "exit" %}<span class="setup-badge exit" data-i18n="badge_exit">▼ Exit</span>{% endif %}</td>
          <td class="composite-cell">{{ row.composite_bar | safe }}</td>
          <td>{{ row.level_score }}</td>
          <td>{{ row.change_score }}</td>
          <td class="sentiment-cell">{{ row.sentiment_score }}</td>
          <td class="delta-cell">
            {% if row.arrow %}<span class="arrow {{ row.arrow_class }}">{{ row.arrow }}</span> {% endif %}{{ row.delta_rank }}
          </td>
          <td>
            <span class="traj-badge traj-{{ row.trajectory_state }}">{{ row.trajectory_label }}</span>
          </td>
        </tr>
        <tr class="breakdown-row" id="bd-{{ row.sector_id }}">
          <td colspan="8">{{ row.breakdown_html | safe }}</td>
        </tr>
        {% endfor %}
        {% if not has_any_rows %}
        <tr><td colspan="8" style="text-align:center;padding:24px;color:var(--fg4)" data-i18n="leaderboard_empty">No data available yet.</td></tr>
        {% endif %}
        <tr id="filter-no-match" style="display:none">
          <td colspan="8" style="text-align:center;padding:24px;color:var(--fg4)" data-i18n="filter_no_match">No themes match the filters.</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ============================================================
     Tab: RRG
     ============================================================ -->
<section id="tab-rrg" class="tab-panel" role="tabpanel">
  <p class="tab-note" data-i18n="note_sentiment">Sentiment weighting affects the leaderboard ranking only.</p>
  <div class="utility-row">
    <button type="button" class="tab-guide-btn" data-guide="guide_body_rrg" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div class="chart-container" id="rrg-chart" style="height:520px"></div>
</section>

<!-- ============================================================
     Tab: Drill-down
     ============================================================ -->
<section id="tab-drilldown" class="tab-panel" role="tabpanel">
  <div class="utility-row">
    <button type="button" class="tab-guide-btn" data-guide="guide_body_drilldown" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div class="drilldown-controls">
    <label for="sector-select">Theme:</label>
    <!-- Options are populated by JS (_populateDrilldownSelect) from
         COHORT_CHARTS[activeCohort].keys — the set of sector keys is
         per-cohort now, so a static Jinja loop can only ever render one
         cohort's options. -->
    <select class="sector-select" id="sector-select" onchange="updateDrilldown()"></select>
  </div>
  <div class="chart-container" id="drilldown-chart" style="height:460px"></div>
</section>

<!-- ============================================================
     Tab: Movers
     ============================================================ -->
<section id="tab-movers" class="tab-panel" role="tabpanel">
  <p class="tab-note" data-i18n="note_sentiment">Sentiment weighting affects the leaderboard ranking only.</p>
  <div class="utility-row">
    <button type="button" class="tab-guide-btn" data-guide="guide_body_movers" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div class="chart-container" id="movers-chart"></div>
</section>

<!-- ============================================================
     Tab: History
     ============================================================ -->
<section id="tab-history" class="tab-panel" role="tabpanel">
  <p class="tab-note" data-i18n="note_sentiment">Sentiment weighting affects the leaderboard ranking only.</p>
  <div class="utility-row">
    <button type="button" class="tab-guide-btn" data-guide="guide_body_history" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div class="table-wrap scan-index">
    <table>
      <thead>
        <tr><th></th><th data-i18n="si_scan">Scan</th><th data-i18n="si_run">Run (UTC)</th><th data-i18n="si_sectors">Themes</th><th data-i18n="si_top">Top theme</th><th data-i18n="si_report">Report</th></tr>
      </thead>
      <tbody>
        {% for s in scan_index %}
        <tr data-scan-id="{{ s.scan_id }}" tabindex="0" role="button" aria-label="View scan #{{ s.scan_id }}"{% if s.scan_id == active_scan_id %} class="active-scan"{% endif %}>
          <td>{% if s.scan_id == active_scan_id %}<span class="showing-badge">● Showing</span>{% endif %}</td>
          <td>#{{ s.scan_id }}</td>
          <td>{{ s.run_at_display }}</td>
          <td>{{ s.sector_count }}</td>
          <td>{{ s.top_sector }}</td>
          <td><a href="reports/report_{{ s.scan_id }}.md" data-i18n="si_download">download</a></td>
        </tr>
        {% else %}
        <tr><td colspan="6" style="text-align:center;padding:16px;color:var(--fg4)" data-i18n="scans_empty">No scans yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="chart-container" id="history-chart" style="height:520px"></div>
</section>

<!-- ============================================================
     Tab: Backtest
     ============================================================ -->
<section id="tab-backtest" class="tab-panel" role="tabpanel">
  <p class="tab-note" data-i18n-html="note_backtest">Equal-weight, long-only, <strong>net of {{ round_trip_bps | round | int }} bps round-trip trading costs</strong>. Price-based signals only (breadth &amp; sentiment excluded). Each horizon is a rebalance cadence plus a hysteresis band: a holding is kept while its rank stays within top-N + buffer, so a one-rank wobble is not a trade.</p>
  <p class="tab-note" data-i18n-html="note_backtest_caveat"><strong>These are precomputed operating points from one sweep over one market history (2008–2026), not a live optimiser.</strong> The universe is replayed as it stands today, so themes that launched later are simply absent from the early years. Read the trades/year column next to the return, not instead of it.</p>
  {% if has_backtest %}
  <div class="table-wrap">
    <table>
      <thead><tr><th data-i18n="bt_horizon">Horizon</th><th data-i18n="bt_policy">Policy</th><th data-i18n="bt_window">Window</th><th data-i18n="bt_stratcagr">Strategy CAGR</th><th data-i18n="bt_benchcagr">Bench CAGR</th><th data-i18n="bt_sharpe">Sharpe (rf=0)</th><th data-i18n="bt_maxdd">Max DD</th><th data-i18n="bt_trades">Trades/yr</th><th data-i18n="bt_hold">Median hold</th></tr></thead>
      <tbody>
        {% for r in backtest_metrics %}
        <tr class="bt-row" data-horizon="{{ r.region }}">
          <td>{{ r.label }}</td>
          <td>top {{ r.top_n }}, buffer {{ r.buffer }}, {{ r.rebalance }}</td>
          <td>{{ r.start }} → {{ r.end }}</td>
          <td>{{ r.cagr }}</td><td>{{ r.benchmark_cagr }}</td><td>{{ r.sharpe }}</td>
          <td>{{ r.max_drawdown }}</td>
          <td>{{ r.trades_per_year }}</td><td>{{ r.median_holding_days }} d</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="chart-container" id="backtest-chart" style="height:420px"></div>
  <button type="button" class="tab-guide-btn" data-guide="guide_body_backtest" data-i18n="guide_summary">How to read this tab</button>
  {% if badge_scorecard %}
  <h3 style="margin:22px 0 6px;font-family:var(--font-display);font-size:15px;color:var(--fg1)" data-i18n="badge_scorecard_title">Badge scorecard</h3>
  <p class="tab-note" data-i18n="badge_scorecard_desc">5-day forward return after each badge appeared.</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th data-i18n="badge_sc_badge">Badge</th>
          <th data-i18n="badge_sc_count">Count</th>
          <th data-i18n="badge_sc_hit_rate">Hit rate</th>
          <th data-i18n="badge_sc_mean">Mean</th>
          <th data-i18n="badge_sc_median">Median</th>
        </tr>
      </thead>
      <tbody>
        {% for row in badge_scorecard %}
        <tr>
          <td><span data-i18n="badge_{{ row.badge_key }}">{{ row.badge }}</span></td>
          <td>{{ row.count }}</td>
          {% if row.hit_rate is not none %}
          <td>{{ "%.0f%%"|format(row.hit_rate * 100) }}</td>
          <td class="{% if row.mean_return > 0 %}signal-hi{% elif row.mean_return < 0 %}signal-lo{% endif %}">{{ "%+.1f%%"|format(row.mean_return * 100) }}</td>
          <td class="{% if row.median_return > 0 %}signal-hi{% elif row.median_return < 0 %}signal-lo{% endif %}">{{ "%+.1f%%"|format(row.median_return * 100) }}</td>
          {% else %}
          <td>—</td><td>—</td><td>—</td>
          {% endif %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% include '_validation.html.j2' %}
  {% else %}
  <p style="text-align:center;padding:24px;color:var(--fg4)">No backtest run yet. Run <code>python backtest.py</code>.</p>
  {% endif %}
</section>

<!-- ============================================================
     Tab: Correlation
     ============================================================ -->
<section id="tab-correlation" class="tab-panel" role="tabpanel">
  {% if correlation_fig_json %}
  <p class="tab-note" data-i18n="note_correlation">60-trading-day rolling pairwise return correlations. Top-5 themes in bold. Red = moving together; blue = moving independently.</p>
  <div class="chart-container" id="correlation-chart" style="min-height:500px"></div>
  {% else %}
  <p class="leaderboard-empty" data-i18n="correlation_no_data">Not enough price history for a 60-day correlation matrix.</p>
  {% endif %}
  <button type="button" class="tab-guide-btn" data-guide="guide_body_correlation" data-i18n="guide_summary">How to read this tab</button>
</section>
</div>

<!-- ============================================================
     JavaScript
     ============================================================ -->
<script>
{% include '_tabs.js.j2' %}

// Ordered cohort regions, from config via src/cohorts.py. Everything that
// regroups leaderboard rows must iterate THIS rather than a literal
// ["US","EU"] — a hardcoded pair silently misfiles THEME rows into the US
// group and strands the Themes header.
var COHORT_REGIONS = [{% for c in cohort_list %}"{{ c.region }}"{% if not loop.last %}, {% endif %}{% endfor %}];

// Horizon presets, from config/weights.yaml via src/horizons.py. A preset is a
// (cadence, top_n, buffer) triple; top_n/buffer are pure rank comparisons, so
// switching preset re-derives the Enter/Hold/Exit badges in the browser with no
// rebuild. Cadence only selects which precomputed backtest curve to show —
// re-simulating a different cadence needs a replay and cannot happen here.
var HORIZONS = {{ horizons_json | js_json }};
var HORIZON_DEFAULT = {{ horizon_default_json | js_json }};
window.HORIZON_DEFAULT = HORIZON_DEFAULT;
// True when auth is configured, i.e. when the baked page is the guest view and
// the Enter/Hold/Exit badge is a signed-in feature. See build.py:badges_gated.
// Written so that a MISSING context key gates rather than ungates: a plain
// `if badges_gated` would render `false` for an undefined variable, silently
// publishing the badge to guests. Failure here should cost a feature, not leak one.
var BADGES_GATED = {{ 'false' if badges_gated is defined and not badges_gated else 'true' }};
var activeHorizon = HORIZON_DEFAULT.key;

var _HORIZON_LS = "sm_horizon";
try {
  var _saved = localStorage.getItem(_HORIZON_LS);
  if (_saved && HORIZONS.some(function (h) { return h.key === _saved; })) {
    activeHorizon = _saved;
  }
} catch (e) { /* private mode: fall back to the default */ }

function currentHorizon() {
  for (var i = 0; i < HORIZONS.length; i++) {
    if (HORIZONS[i].key === activeHorizon) { return HORIZONS[i]; }
  }
  return HORIZON_DEFAULT;
}

// The single writer of every leaderboard badge — the horizon switch, the
// signed-in rebuild, the sentiment rescore and the holdings toggle all end up
// here. They used to each emit their own badge markup, and they had already
// drifted: the rescore path was still using the pre-band trajectory heuristic
// that _compute_setup replaced.
//
// Two inputs beyond the row's own data-rank:
//   BADGES_GATED   the badge is the signed-in tier; guests get data-setup=""
//                  and no span, whichever path rendered the row.
//   holdings       Enter vs Hold. See Rescore.badgeForRank for the rule.
var BADGE_TEXT_EN = { entry: '▲ Enter', hold: '● Hold', exit: '▼ Exit' };
var BADGE_I18N = { entry: 'badge_entry', hold: 'badge_hold', exit: 'badge_exit' };

function badgesVisible() {
  return !BADGES_GATED || window.SM_SIGNED_IN === true;
}

function applyHorizonBadges() {
  var h = currentHorizon();
  var visible = badgesVisible();
  var pos = window.SMPositions;
  var rows = document.querySelectorAll('#leaderboard-table tr.leaderboard-row');
  // Whether the badge may be personalised at all. Without holdings the
  // action-aware rule would silently delete every Exit badge (nothing is held,
  // so nothing can be exited) — including on an ungated build, where the server
  // baked those Exit badges and this pass runs over them.
  var holdings = (pos && pos.holdingsState) ? pos.holdingsState() : 'unknown';
  Array.prototype.forEach.call(rows, function (tr) {
    var kind = null;
    var rank = parseFloat(tr.dataset.rank);
    if (visible && window.Rescore && window.Rescore.badgeFor) {
      kind = window.Rescore.badgeFor(
        rank, h, holdings, holdings === 'ready' && pos.isHeld(tr),
        tr.dataset.unbuyable === '1');
    }
    tr.dataset.setup = kind || '';
    // The ⚠ marker is the same fact as the Exit badge, so it is written here
    // rather than derived a second time in positions.js from the DOM the
    // previous pass happened to leave. Only when holdings are known, though:
    // in the band fallback an Exit badge says nothing about ownership.
    tr.classList.toggle('position-warn', kind === 'exit' && holdings === 'ready');

    var nameCell = tr.cells[1];
    if (!nameCell) return;
    var badge = nameCell.querySelector('.setup-badge');
    if (!kind) { if (badge) badge.remove(); return; }
    if (!badge) {
      badge = document.createElement('span');
      nameCell.appendChild(badge);
    }
    badge.className = 'setup-badge ' + kind;
    badge.setAttribute('data-i18n', BADGE_I18N[kind]);
    badge.textContent = BADGE_TEXT_EN[kind];
    // data-en must be rewritten, not left to _i18n.html.j2's first-sight
    // capture: this span is REUSED across kinds, and applyLang() restores
    // English from data-en. A span that went Enter -> Hold would otherwise
    // carry data-en="▲ Enter" and snap back to Enter on the next EN pass.
    badge.setAttribute('data-en', BADGE_TEXT_EN[kind]);
  });

  var setupFilters = document.getElementById('filter-group-setup');
  if (setupFilters && setupFilters.hidden !== !visible) {
    setupFilters.hidden = !visible;
    // Dropping the chips without dropping the state they set would leave an
    // invisible filter pinning the table to zero rows. The guard is for the
    // init call, which can run before _filterState's `var` is evaluated.
    if (!visible && typeof _filterState !== 'undefined' && _filterState) {
      _filterState.setup = [];
    }
    Array.prototype.forEach.call(
      setupFilters.querySelectorAll('.filter-chip'), function (c) {
        if (visible) return;
        c.classList.remove('active');
        c.setAttribute('aria-pressed', 'false');
      });
  }

  // Badge text is written in English above; without this a Swedish reader got
  // English badges from every path except the initial page load.
  if (window.applyLang) {
    var lang = 'en';
    try { lang = localStorage.getItem('lang') || 'en'; } catch (e) { /* ignore */ }
    window.applyLang(lang);
  }
  if (typeof applyFilters === 'function') applyFilters();
}

// Anything that changes gating, holdings, or the rendered rows re-runs the
// single pass rather than patching badges itself.
document.addEventListener('sm:auth-changed', applyHorizonBadges);
document.addEventListener('sm:positions-changed', applyHorizonBadges);
document.addEventListener('sm:leaderboard-upgraded', applyHorizonBadges);

// Sync the <select> to the restored state. Without this the control shows the
// first option while activeHorizon is whatever localStorage (or the config
// default) says — the page would render one band and label it another.
// The selected horizon's cost, rendered beside the control. Only the numbers
// are written here; the unit words are i18n-managed nodes and must not be
// touched, or a language switch would blank them.
function renderHorizonStats(key) {
  var h = null;
  for (var i = 0; i < HORIZONS.length; i++) {
    if (HORIZONS[i].key === key) { h = HORIZONS[i]; break; }
  }
  if (!h) { return; }
  function set(id, value) {
    var el = document.getElementById(id);
    if (el) { el.textContent = value; }
  }
  // trades_per_year / median_holding_days are optional in config — a preset
  // with no recorded backtest shows an em dash rather than "NaN".
  set('hz-held', h.top_n);
  set('hz-hold', h.median_holding_days == null
      ? '—' : '~' + Math.round(h.median_holding_days) + 'd');
  set('hz-trades', h.trades_per_year == null
      ? '—' : Math.round(h.trades_per_year));
}

function initHorizonSelect() {
  var sel = document.getElementById('horizon-select');
  if (sel) { sel.value = activeHorizon; }
  renderHorizonStats(activeHorizon);
  Array.prototype.forEach.call(document.querySelectorAll('.bt-row'), function (tr) {
    tr.classList.toggle('active', tr.dataset.horizon === activeHorizon);
  });
  // Always, not only when the restored horizon differs from the baked one:
  // this pass also hides the Enter/Hold/Exit filter chips for guests, and a
  // guest who never touched the horizon selector would otherwise keep a chip
  // group that can only empty the table.
  applyHorizonBadges();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initHorizonSelect);
} else {
  initHorizonSelect();
}

function switchHorizon(key) {
  activeHorizon = key;
  try { localStorage.setItem(_HORIZON_LS, key); } catch (e) { /* ignore */ }
  renderHorizonStats(key);
  applyHorizonBadges();
  // Highlight the matching backtest row and redraw its curve.
  Array.prototype.forEach.call(document.querySelectorAll('.bt-row'), function (tr) {
    tr.classList.toggle('active', tr.dataset.horizon === key);
  });
  _rendered.backtest = false;
  renderBacktest();
}

// {region, label} pairs — a companion to COHORT_REGIONS rather than a
// widened version of it. COHORT_REGIONS is consumed in many places above
// as a plain array of region strings (`.forEach(function(region) {...})`);
// changing its element shape would break every one of those call sites.
// External assets (auth.js, scan-history.js) that also need the
// human-readable label read this instead.
var COHORTS = {{ cohorts_json | js_json }};   // [{region, label}, ...]

// Theme names with no route to purchase (config/themes.yaml `unbuyable: true`).
// Read by auth.js, which rebuilds the leaderboard from v_recent_scores and so
// has no other way to know.
var UNBUYABLE = {{ unbuyable_json | js_json }};
window.UNBUYABLE = UNBUYABLE;

// Light->dark hex map for the baked Plotly figures (Task 7 consumes this).
var CHART_DARK = {{ chart_dark_json | js_json }};
window.CHART_DARK = CHART_DARK;

// ----- Plotly data (injected by build.py) -----
// COHORT_CHARTS is keyed by cohort region ("US"/"EU"/"THEME"); each entry
// holds that cohort's own rrg/movers/history/drilldown figures plus the
// list of sector keys the Drill-down dropdown should offer. Cohorts are
// never merged onto one figure — see the cohort-select-row comment above.
var COHORT_CHARTS = {{ cohort_charts_json | js_json }};
var activeCohort = COHORT_REGIONS.length ? COHORT_REGIONS[0] : null;
var RESCORE_DATA = {{ rescore_data_json | js_json }};
var SCAN_HISTORY = {{ scan_history_json | js_json }};
var BACKTEST_DATA = {{ backtest_json | js_json }};
{% if correlation_fig_json %}
var CORRELATION_DATA = {{ correlation_fig_json | js_json }};
{% endif %}

// ----- Render helpers -----
var _rendered = {};

function renderRRG() {
  if (_rendered.rrg) return;
  _rendered.rrg = true;
  var chart = COHORT_CHARTS[activeCohort];
  if (!chart) return;
  SMTheme.smPlot('rrg-chart', chart.rrg);
}

function renderMovers() {
  if (_rendered.movers) return;
  _rendered.movers = true;
  var chart = COHORT_CHARTS[activeCohort];
  if (!chart) return;
  SMTheme.smPlot('movers-chart', chart.movers);
}

function renderHistory() {
  if (_rendered.history) return;
  _rendered.history = true;
  var chart = COHORT_CHARTS[activeCohort];
  if (!chart) return;
  SMTheme.smPlot('history-chart', chart.history);
}

// One container for the active cohort's track. This used to iterate a
// hardcoded ['US', 'EU'] against per-cohort container ids, which meant that
// after the sector cohorts were retired it looked up backtest-chart-US/EU
// while activeCohort was THEME — and rendered nothing at all.
function renderBacktest() {
  if (_rendered.backtest) return;
  _rendered.backtest = true;
  var el = document.getElementById('backtest-chart');
  var f = el && BACKTEST_DATA[activeHorizon];
  if (el) {
    el.style.display = f ? '' : 'none';
    if (f) SMTheme.smPlot(el, f);
  }
}

function renderCorrelation() {
  if (_rendered.correlation) return;
  _rendered.correlation = true;
  if (typeof CORRELATION_DATA !== 'undefined') {
    SMTheme.smPlot('correlation-chart', CORRELATION_DATA);
  }
}

function renderDrilldown() {
  _rendered.drilldown = false; // always re-render on sector change
  updateDrilldown();
}

// Rebuilds the Drill-down sector <select> from the active cohort's own key
// list. Cohorts don't share sector keys (US|Energy vs THEME|Space), so the
// dropdown must be repopulated on every cohort switch rather than filtered.
function _populateDrilldownSelect() {
  var sel = document.getElementById('sector-select');
  if (!sel) return;
  var chart = COHORT_CHARTS[activeCohort];
  var keys = (chart && chart.keys) || [];
  sel.innerHTML = '';
  keys.forEach(function (k) {
    var opt = document.createElement('option');
    opt.value = k;
    opt.textContent = k;
    sel.appendChild(opt);
  });
}

function updateDrilldown() {
  var sel = document.getElementById('sector-select');
  if (!sel) return;
  var key = sel.value;
  var chart = COHORT_CHARTS[activeCohort];
  var fig = chart && chart.drilldown ? chart.drilldown[key] : null;
  if (!fig) {
    document.getElementById('drilldown-chart').innerHTML =
      '<p style="padding:24px;color:var(--fg4)">No data for ' + key + '</p>';
    return;
  }
  SMTheme.smPlot('drilldown-chart', fig);
}

// ----- Cohort switching -----
// Drives RRG / Drill-down / Movers / History / Backtest. Clears the render
// memo and re-renders whichever chart tab is currently visible; other tabs
// pick up the new activeCohort lazily the next time they're activated.
function switchCohort(region) {
  activeCohort = region;
  _rendered = {};
  _populateDrilldownSelect();
  var active = document.querySelector('.tab-panel.active');
  if (!active) return;
  var name = active.id.replace('tab-', '');
  if (name === 'rrg')       renderRRG();
  if (name === 'movers')    renderMovers();
  if (name === 'history')   renderHistory();
  if (name === 'drilldown') renderDrilldown();
  if (typeof renderBacktest === 'function' && name === 'backtest') renderBacktest();
}
window.switchCohort = switchCohort;

// Re-skin whichever chart tab is currently visible when the theme changes —
// via the manual control, or the OS flipping under a reader on Auto. Mirrors
// switchCohort()'s own "find the active tab, re-render only that one" shape;
// every other tab picks up the new theme lazily via smPlot() the next time
// it's opened, same as switchCohort's own comment already explains.
document.addEventListener('sm:theme-changed', function () {
  _rendered = {};
  var active = document.querySelector('.tab-panel.active');
  if (!active) return;
  var name = active.id.replace('tab-', '');
  if (name === 'rrg')       renderRRG();
  if (name === 'movers')    renderMovers();
  if (name === 'history')   renderHistory();
  if (name === 'drilldown') renderDrilldown();
  if (typeof renderBacktest === 'function' && name === 'backtest') renderBacktest();
  if (name === 'correlation') renderCorrelation();
});

_populateDrilldownSelect();
if (window.SMTheme) { window.SMTheme.initControl(); }

// ----- Breakdown toggle -----
function toggleBreakdown(id) {
  var bdRow = document.getElementById('bd-' + id);
  var chev  = document.getElementById('chev-' + id);
  if (!bdRow) return;
  bdRow.classList.toggle('open');
  if (chev) chev.textContent = bdRow.classList.contains('open') ? '▼' : '▶';
}

// ----- Sortable table -----
var _sortCol = 0, _sortDir = 1; // dir: 1=asc, -1=desc

// ----- Leaderboard filtering -----
// Visibility-only: filters decide which rows show, sortTable decides order.
var _filterState = { setup: [], trend: [], thresholds: [] };

var _TREND_GROUPS = {
  rising:  ['up', 'strong_up'],
  flat:    ['flat'],
  falling: ['down', 'strong_down']
};

// Dynamic string (count), so it carries its own EN/SV pair rather than
// going through the static data-i18n pass.
var _FILTER_MSG = { showing: { en: 'Showing %X of %N', sv: 'Visar %X av %N' } };

function _filterLang() {
  try { return localStorage.getItem('lang') === 'sv' ? 'sv' : 'en'; }
  catch (e) { return 'en'; }
}

function _filterAnyActive() {
  return !!(_filterState.setup.length || _filterState.trend.length
            || _filterState.thresholds.length);
}

function _matchesSetup(r) {
  if (!_filterState.setup.length) return true;
  return _filterState.setup.indexOf(r.dataset.setup || '') !== -1;
}

function _matchesTrend(r) {
  if (!_filterState.trend.length) return true;
  var state = r.dataset.trend || '';
  for (var i = 0; i < _filterState.trend.length; i++) {
    var grp = _TREND_GROUPS[_filterState.trend[i]] || [];
    if (grp.indexOf(state) !== -1) return true;
  }
  return false;
}

function _matchesThresholds(r) {
  // Each active threshold is an independent AND predicate. A missing attribute
  // parses to NaN, and every comparison with NaN is false — so it fails, which
  // is what we want (an unscored/unranked row is not "> 0" or "top 5").
  var t = _filterState.thresholds;
  for (var i = 0; i < t.length; i++) {
    if (t[i] === 'composite_pos' && !(parseFloat(r.dataset.composite) > 0)) return false;
    if (t[i] === 'change_pos'    && !(parseFloat(r.dataset.change) > 0))    return false;
    if (t[i] === 'top5'          && !(parseInt(r.dataset.rank, 10) <= 5))   return false;
  }
  return true;
}

function _collapseBreakdown(sectorId) {
  // Breakdown rows show via the `open` class, so remove the class instead of
  // setting an inline display (an inline style would override `.open` and keep
  // the row collapsed even after the filter is cleared).
  if (!sectorId) return;
  var bd = document.getElementById('bd-' + sectorId);
  if (bd) bd.classList.remove('open');
  var chev = document.getElementById('chev-' + sectorId);
  if (chev) chev.textContent = '▶';
}

function _updateFilterCount(shown, total) {
  var el = document.getElementById('filter-count');
  if (!el) return;
  el.textContent = _filterAnyActive()
    ? _FILTER_MSG.showing[_filterLang()]
        .replace('%X', shown).replace('%N', total)
    : '';
}

function applyFilters() {
  var tbody = document.querySelector('#leaderboard-table tbody');
  if (!tbody) return;
  var rows = tbody.querySelectorAll('tr.leaderboard-row');
  var shown = 0;
  Array.prototype.forEach.call(rows, function (r) {
    var ok = _matchesSetup(r) && _matchesTrend(r) && _matchesThresholds(r);
    r.style.display = ok ? '' : 'none';
    if (ok) { shown++; } else { _collapseBreakdown(r.dataset.sectorId); }
  });
  _updateFilterCount(shown, rows.length);
  var nm = document.getElementById('filter-no-match');
  if (nm) nm.style.display = (shown === 0 && rows.length > 0) ? '' : 'none';
  var clear = document.getElementById('filter-clear');
  if (clear) clear.hidden = !_filterAnyActive();
}

function clearFilters() {
  _filterState = { setup: [], trend: [], thresholds: [] };
  var chips = document.querySelectorAll('#leaderboard-filter-bar .filter-chip');
  Array.prototype.forEach.call(chips, function (c) {
    c.classList.remove('active');
    c.setAttribute('aria-pressed', 'false');
  });
  applyFilters();
}

function setFilterBarVisible(visible) {
  var bar = document.getElementById('leaderboard-filter-bar');
  if (bar) bar.style.display = visible ? '' : 'none';
}

(function _wireFilterChips() {
  var chips = document.querySelectorAll('#leaderboard-filter-bar .filter-chip');
  Array.prototype.forEach.call(chips, function (chip) {
    chip.addEventListener('click', function () {
      var arr = _filterState[chip.dataset.filterGroup];
      if (!arr) return;
      var val = chip.dataset.filterValue;
      var i = arr.indexOf(val);
      if (i === -1) {
        arr.push(val);
        chip.classList.add('active');
        chip.setAttribute('aria-pressed', 'true');
      } else {
        arr.splice(i, 1);
        chip.classList.remove('active');
        chip.setAttribute('aria-pressed', 'false');
      }
      applyFilters();
    });
  });
  var clearBtn = document.getElementById('filter-clear');
  if (clearBtn) clearBtn.addEventListener('click', clearFilters);
})();

window.applyFilters = applyFilters;
window.clearFilters = clearFilters;
window.setFilterBarVisible = setFilterBarVisible;

function sortTable(col) {
  if (window._leaderboardUpgraded) return;
  var table   = document.getElementById('leaderboard-table');
  var tbody   = table.querySelector('tbody');
  var headers = table.querySelectorAll('thead th');
  var rows = Array.from(tbody.querySelectorAll('tr.leaderboard-row'));

  if (_sortCol === col) {
    _sortDir *= -1;
  } else {
    _sortCol = col;
    _sortDir = 1;
  }

  headers.forEach(function(h, i) {
    h.classList.remove('sort-asc', 'sort-desc');
    if (i === col) h.classList.add(_sortDir === 1 ? 'sort-asc' : 'sort-desc');
  });

  rows.sort(function(a, b) {
    var aCell = a.querySelectorAll('td')[col];
    var bCell = b.querySelectorAll('td')[col];
    var aText = aCell ? aCell.innerText.trim() : '';
    var bText = bCell ? bCell.innerText.trim() : '';

    aText = aText.replace(/[▲▼▶]/g, '').trim();
    bText = bText.replace(/[▲▼▶]/g, '').trim();

    var aNum = parseFloat(aText.replace(/[+,]/g, ''));
    var bNum = parseFloat(bText.replace(/[+,]/g, ''));

    if (!isNaN(aNum) && !isNaN(bNum)) return (aNum - bNum) * _sortDir;
    return aText.localeCompare(bText) * _sortDir;
  });

  // Re-append sorted rows, each followed by its own breakdown panel.
  rows.forEach(function(r) {
    tbody.appendChild(r);
    var sectorId = r.dataset.sectorId;
    if (sectorId) {
      var bd = document.getElementById('bd-' + sectorId);
      if (bd) tbody.appendChild(bd);
    }
  });
}

// Keyboard support for interactive table elements
document.getElementById('leaderboard-table')?.addEventListener('keydown', function(e) {
  if (e.key !== 'Enter' && e.key !== ' ') return;
  var t = e.target;
  if (t.matches('th[onclick]') || t.matches('.leaderboard-row')) {
    e.preventDefault();
    t.click();
  }
});

// ----- Sentiment toggle wiring -----
(function () {
  var LS_ENABLED = "sentimentEnabled", LS_WEIGHT = "sentimentWeight";
  var toggle = document.getElementById("sentiment-toggle");
  var weightInput = document.getElementById("sentiment-weight");
  var table = document.getElementById("leaderboard-table");
  var weightWrap = weightInput ? weightInput.closest(".sw-weight") : null;
  if (!toggle || !weightInput || !table || typeof Rescore === "undefined") { return; }

  function fmt(n, d) { return (n === null || n === undefined) ? "—" : Number(n).toFixed(d); }

  function updateTrees(scored, W) {
    var dataPct = Math.round((1 - W) * 100), sentPct = Math.round(W * 100);
    Object.keys(scored).forEach(function (key) {
      var sel = '.score-tree[data-sector-key="' + (window.CSS && CSS.escape ? CSS.escape(key) : key) + '"]';
      document.querySelectorAll(sel).forEach(function (tree) {
        var cv = tree.querySelector(".st-composite-val");
        if (cv) { cv.textContent = fmt(scored[key].composite, 3); }
        var dwt = tree.querySelector(".st-data-wt"); if (dwt) { dwt.textContent = "(" + dataPct + "%)"; }
        var swt = tree.querySelector(".st-sent-wt"); if (swt) { swt.textContent = "(" + sentPct + "%)"; }
      });
    });
  }

  // Update the visible leaderboard rows' cells from `scored`.
  function updateRows(rows, scored) {
    rows.forEach(function (tr) {
      var r = scored[tr.getAttribute("data-sector-key")];
      if (!r) { return; }
      var badge = tr.querySelector(".rank-cell .rank-badge");
      if (badge) { badge.textContent = r.rank; badge.classList.toggle("top3", r.rank <= 3); }
      var compCell = tr.querySelector(".composite-cell");
      if (compCell) { compCell.textContent = fmt(r.composite, 3); }
      var deltaCell = tr.querySelector(".delta-cell");
      if (deltaCell) {
        var arrow = r.delta_rank > 0 ? "▲" : (r.delta_rank < 0 ? "▼" : "");
        var cls = r.delta_rank > 0 ? "up" : (r.delta_rank < 0 ? "down" : "");
        var dtxt = r.delta_rank === 0 ? "—" : (r.delta_rank > 0 ? "+" : "") + r.delta_rank.toFixed(1);
        deltaCell.innerHTML = '<span class="arrow ' + cls + '">' + arrow + '</span> ' + dtxt;
      }
      var traj = tr.querySelector(".traj-badge");
      if (traj) { traj.className = "traj-badge traj-" + r.trajectory_state; traj.textContent = r.trajectory_label; }
      // Rescoring changes the rank, and the rank is what the badge is derived
      // from — so data-rank has to move with it or the next badge pass (and the
      // Top 5 filter) would still be reading pre-rescore ranks.
      tr.dataset.rank = r.rank;
    });
    // Badges are not patched here. This path used to carry its own rule — the
    // trajectory + change-score heuristic that _compute_setup replaced with the
    // rank band — so toggling the sentiment weight silently re-badged the board
    // by a rule no other path had used since. One writer now.
    applyHorizonBadges();
  }

  function sortVisibleByRank(rows, scored, tbody) {
    rows.sort(function (a, b) {
      var ra = scored[a.getAttribute("data-sector-key")];
      var rb = scored[b.getAttribute("data-sector-key")];
      return (ra ? ra.rank : 1e9) - (rb ? rb.rank : 1e9);
    });
    rows.forEach(function (tr) {
      tbody.appendChild(tr);
      var sid = tr.getAttribute("data-sector-id");
      var bd = sid ? document.getElementById("bd-" + sid) : null;
      if (bd) { tbody.appendChild(bd); }
    });
  }

  function applyRanking() {
    if (window._leaderboardUpgraded) return;
    var enabled = toggle.checked;
    var weight = Math.min(100, Math.max(0, parseInt(weightInput.value, 10) || 0));
    var W = enabled ? weight / 100 : 0;
    try {
      localStorage.setItem(LS_ENABLED, enabled ? "true" : "false");
      localStorage.setItem(LS_WEIGHT, String(weight));
    } catch (e) {}
    weightInput.disabled = !enabled;
    if (weightWrap) { weightWrap.setAttribute("data-disabled", String(!enabled)); }

    var scored = Rescore.rescore(RESCORE_DATA, W);
    updateTrees(scored, W);

    var tbody = table.querySelector("tbody");
    var rows = Array.prototype.slice.call(
      tbody.querySelectorAll('tr.leaderboard-row'));
    updateRows(rows, scored);
    sortVisibleByRank(rows, scored, tbody);
  }

  // Init from persisted state.
  var enabled0 = false, weight0 = 30;
  try {
    enabled0 = localStorage.getItem(LS_ENABLED) === "true";
    var w = parseInt(localStorage.getItem(LS_WEIGHT), 10);
    if (!isNaN(w)) { weight0 = Math.min(100, Math.max(0, w)); }
  } catch (e) {}
  toggle.checked = enabled0;
  weightInput.value = weight0;
  toggle.addEventListener("change", applyRanking);
  weightInput.addEventListener("input", applyRanking);
  if (enabled0) { applyRanking(); }
})();

// Delegated click handler for leaderboard row expansion
document.getElementById('leaderboard-table')?.addEventListener('click', function(e) {
  var row = e.target.closest('.leaderboard-row');
  if (row) {
    var id = row.getAttribute('data-sector-id');
    if (id) toggleBreakdown(id);
  }
});

{% include "_i18n.html.j2" %}
</script>

<!DOCTYPE html>
<html lang="en">
<head>
{% include "_theme_init.html.j2" %}
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>ETF Momentum</title>
<script src="{{ plotly_bundle }}"></script>
<script src="assets/rescore.js"></script>
<script src="assets/theme.js"></script>
<style>
{% include "_style.html.j2" %}
</style>
</head>
<body>

<a href="#main-content" class="skip-link" data-i18n="skip_to_content">Skip to content</a>

<!-- Header -->
{% set active_segment = "sectors" %}
{% include '_header.html.j2' %}

{% if auth and lag_banner_date %}
<div class="lag-banner" id="lag-banner" role="status">
  <span class="lag-banner-text">
    <span data-i18n="gate_banner_prefix">You're viewing data from</span>
    <strong>{{ lag_banner_date }}</strong><span data-i18n="gate_banner_suffix">. Sign in for the latest data and all features.</span>
  </span>
  <button type="button" class="lag-banner-btn" onclick="document.getElementById('auth-signin').click()" data-i18n="gate_banner_signin">Sign in</button>
</div>
{% endif %}

{% if auth %}
<div class="gate-modal-overlay" id="gate-modal" hidden>
  <div class="gate-modal" role="dialog" aria-modal="true" aria-labelledby="gate-modal-title">
    {% include "_rotation_illo.html.j2" %}
    <h2 id="gate-modal-title" data-i18n="gate_modal_title">ETF Momentum</h2>
    <p data-i18n="gate_modal_body">Sign in for the latest data, or continue browsing with data from last week.</p>
    <form class="auth-form gate-modal-form">
      <input type="email" class="auth-email" required autocomplete="email"
             placeholder="you@example.com" aria-label="Email">
      <button type="submit" class="lang-toggle auth-send" data-i18n="auth_send_link">Send link</button>
      <span class="auth-status" aria-live="polite"></span>
    </form>
    <button type="button" class="gate-modal-continue" id="gate-continue" data-i18n="gate_modal_continue">Continue as guest</button>
  </div>
</div>
{% endif %}

<main id="main-content" tabindex="-1">
{#- Summary strip (Stage 4). Three cells framing the board before the reader
    reaches the table. Cell B is EMPTY here on purpose: buy-band membership
    depends on the active horizon, which is client-side state, so it is filled
    by renderBuyBand() from the table's live DOM — the same read-projection
    pattern Stage 3's renderMobileCards() uses, for the same reason. -#}
<section class="summary-strip" aria-label="Scan summary">
  {% if todays_read %}
  <div class="strip-cell" id="cell-todays-read">
    <p class="strip-eyebrow" data-i18n="strip_eyebrow_read">Today's read</p>
    <p class="strip-headline">
      {{ todays_read.lead_theme }} <span data-i18n="read_leads">leads the board.</span>
      {% if todays_read.drift == "rising" %}
      <span data-i18n="read_bottom_rising">The bottom half is picking up.</span>
      {% elif todays_read.drift == "falling" %}
      <span data-i18n="read_bottom_falling">The bottom half keeps sliding.</span>
      {% else %}
      <span data-i18n="read_bottom_flat">The bottom half is holding flat.</span>
      {% endif %}
    </p>
    {% if scan_date %}
    <p class="strip-subline">
      <span data-i18n="scan_prefix">Scan</span> #{{ active_scan_id }}
      <span aria-hidden="true">&middot;</span> {{ scan_date[:10] }}
    </p>
    {% endif %}
  </div>
  {% endif %}

  <div class="strip-cell" id="cell-buy-band">
    <p class="strip-eyebrow" data-i18n="strip_eyebrow_band">In the buy band</p>
    <div class="band-pills" id="band-pills"></div>
    {#- Baked, not injected by renderBuyBand(). Injecting it meant calling
        applyLang() at runtime to translate it, and applyLang() re-enters
        applyFilters() -> applyBandBoundaries() -> renderBuyBand(): infinite
        recursion, reachable only when a filter empties the band. Baking it
        lets the normal i18n pass translate it once, with no runtime call. -#}
    <p class="band-note" id="band-empty" data-i18n="band_empty" hidden>No themes in the band on this view.</p>
  </div>

  {#- Same guard the old header block had (_header.html.j2, pre-Stage 4):
      render when EITHER macro data exists (real numbers to show) OR auth is
      configured — a build with no FRED data still needs this DOM host to
      exist, because markLive() (auth.js) targets #market-context-chips
      after a signed-in upgrade, which can happen on exactly that build.
      Without this outer guard the eyebrow button rendered unconditionally —
      an "what these mean" trigger with nothing beside it to explain on a
      build with neither. Found in whole-branch review. -#}
  {% if macro or auth %}
  <div class="strip-cell" id="cell-market-context">
    {#- The eyebrow is the guide trigger, replacing the header's #context-chips
        button. .cc-label so the shared dispatch uses it as the dialog heading
        rather than the live numbers beside it. -#}
    <button type="button" class="strip-eyebrow tab-guide-btn"
            data-guide="guide_body_market_context"
            aria-label="Market context — what these mean"
            data-i18n-aria="market_context_aria">
      <span class="cc-label" data-i18n="strip_eyebrow_market">Market context</span>
      <span class="cc-info" aria-hidden="true">&#9432;</span>
    </button>
    <div class="market-chips" id="market-context-chips">
      {% if macro %}
      <span class="chip {{ 'chip-up' if macro.spy_above else 'chip-down' }}">SPY {{ "%+.1f"|format(macro.spy_distance_pct) }}%</span>
      <span class="chip-word" data-i18n="{{ 'macro_chip_spy_above' if macro.spy_above else 'macro_chip_spy_below' }}">{{ 'above 200-DMA' if macro.spy_above else 'below 200-DMA' }}</span>
      <span class="chip chip-{{ macro.vix_band|lower }}">VIX {{ "%.1f"|format(macro.vix_last) }}</span>
      <span class="chip-word" data-i18n="macro_vix_{{ macro.vix_band|lower }}">{{ macro.vix_band|lower }}</span>
      {% endif %}
    </div>
  </div>
  {% endif %}
</section>
<div class="card">
<!-- Tab bar. A plain div, not <nav>: role="tablist" is an explicit ARIA role
     and always wins over an element's implicit one, so a <nav role="tablist">
     is never exposed as a navigation landmark to assistive tech — it becomes
     a tablist with no navigation landmark at all. This was also the page's
     ONLY <nav>, so the whole page lost its navigation landmark to a role
     conflict. A tablist isn't page navigation in the landmark sense anyway;
     ARIA's own authoring practices don't nest it in <nav>. -->
<div class="tabs" role="tablist">
  <button class="tab-btn active" onclick="switchTab('leaderboard', this)" role="tab" aria-selected="true" aria-controls="tab-leaderboard" data-i18n="tab_leaderboard">Leaderboard</button>
  <button class="tab-btn" onclick="switchTab('rrg', this)" role="tab" aria-selected="false" aria-controls="tab-rrg" data-i18n="tab_rrg">RRG</button>
  <button class="tab-btn" onclick="switchTab('drilldown', this)" role="tab" aria-selected="false" aria-controls="tab-drilldown" data-i18n="tab_drilldown">Drill-down</button>
  <button class="tab-btn" onclick="switchTab('movers', this)" role="tab" aria-selected="false" aria-controls="tab-movers" data-i18n="tab_movers">Movers</button>
  <button class="tab-btn" onclick="switchTab('history', this)" role="tab" aria-selected="false" aria-controls="tab-history" data-i18n="tab_history">History</button>
  <button class="tab-btn" onclick="switchTab('backtest', this)" role="tab" aria-selected="false" aria-controls="tab-backtest" data-i18n="tab_backtest">Backtest</button>
  <button class="tab-btn" onclick="switchTab('correlation', this)" role="tab" aria-selected="false" aria-controls="tab-correlation" data-i18n="tab_correlation">Correlation</button>
</div>

<!-- Cohort selector — drives RRG / Drill-down / Movers / History / Backtest.
     rs_ratio/rs_momentum are computed against each cohort's own benchmark
     (THEME vs ACWI), so those tabs render one cohort at a time rather than
     mixing benchmarks on one chart. The Leaderboard (grouped by cohort
     already) and Correlation (one combined heatmap) tabs are unaffected.

     Hidden when only one cohort is configured — a select with a single option
     is a control that cannot do anything. The markup stays so a second cohort
     brings it back with no template change. -->
{% if cohort_list | length > 1 %}
<div class="cohort-select-row">
  <label for="cohort-select" data-i18n="cohort_label">Cohort:</label>
  <select id="cohort-select" onchange="switchCohort(this.value)">
    {% for cohort in cohort_list %}
    <option value="{{ cohort.region }}">{{ cohort.label }}</option>
    {% endfor %}
  </select>
</div>
{% endif %}

<!-- ============================================================
     Tab: Leaderboard
     ============================================================ -->
<section id="tab-leaderboard" class="tab-panel active" role="tabpanel">
  <div class="horizon-row">
    <span class="horizon-eyebrow" data-i18n="horizon_label">Horizon</span>
    {#- The segmented buttons are the real control now — keyboard, screen
        reader, everything. The <select> beneath stays in the DOM purely as
        switchHorizon()'s internal source of truth (it reads
        getElementById('horizon-select') back at two points, not just via
        onchange) — display:none removes it from both sight and the
        accessibility tree, so it is never a second, competing control. -#}
    <div class="horizon-toggle" role="group" aria-label="Horizon">
      {% for h in horizon_list %}
      <button type="button" class="horizon-btn" data-horizon-choice="{{ h.key }}" aria-pressed="false">{{ h.label }}</button>
      {% endfor %}
    </div>
    <select id="horizon-select" onchange="switchHorizon(this.value)">
      {% for h in horizon_list %}
      <option value="{{ h.key }}">{{ h.label }}</option>
      {% endfor %}
    </select>
    {#- The cost of the chosen horizon, beside the control rather than crammed
        into every option label. Numbers live in their own elements and the unit
        words carry data-i18n: applyLang() rewrites [data-i18n] textContent, so
        putting both in one node would wipe the figures on a language switch.
        The full three-way comparison lives in the Backtest tab, which already
        tabulates every preset and highlights the active row. -#}
    <span class="horizon-stats" id="horizon-stats">
      <span class="hz-stat"><b id="hz-held">—</b> <span data-i18n="hz_held">held</span></span>
      <span class="hz-stat"><span data-i18n="hz_exit_prefix">sell past rank</span> <b id="hz-exit">—</b></span>
      <span class="hz-stat"><b id="hz-trades">—</b> <span data-i18n="hz_trades">trades/yr</span></span>
      <span class="hz-stat"><b id="hz-hold">—</b> <span data-i18n="hz_hold">median hold</span></span>
    </span>
    <span class="horizon-note" data-i18n="horizon_note">Sets the Enter/Exit band. Backtested figures, not predictions.</span>
    {#- Review-due status: which of the two states below is showing is decided
        entirely client-side (renderReviewStatus(), from Rescore.reviewStatus) —
        never baked, so it stays correct on a page built days ago. Both start
        hidden so neither flashes before JS decides which applies. See
        BACKLOG.md "Badges don't say whether today is an actionable day". -#}
    <span class="review-status" id="review-status">
      <span class="review-due" id="review-due" hidden>
        <span data-i18n="review_due">Review due</span>
        <button type="button" class="review-done-btn" id="review-done-btn" data-i18n="review_done">Done ✓</button>
      </span>
      <span class="review-next" id="review-next" hidden>
        <span data-i18n="review_next_label">Next review:</span> <b id="review-next-date">—</b>
      </span>
    </span>

    {#- Right-aligned controls (spec: "Controls row", Screen 1 item 5).
        These three carry the SAME data-filter-group/data-filter-value as
        their counterparts inside the disclosed full set below — clicking
        either updates both (_wireFilterChips()/_syncChipState below), the
        same shared-state pattern the horizon segmented control uses over
        the hidden <select>. A physical move (deleting them from their
        filter-groups) was considered and rejected: it would leave the
        Trend group showing only Flat/Falling and the Threshold group
        showing only Positive change once disclosed — reads as broken. -#}
    <div class="control-chips">
      <button type="button" class="control-chip" data-filter-group="thresholds" data-filter-value="top5" aria-pressed="false" data-i18n="filter_top5">Top 5</button>
      <button type="button" class="control-chip" data-filter-group="trend" data-filter-value="rising" aria-pressed="false" data-i18n="filter_rising">↑ Rising</button>
      <button type="button" class="control-chip" data-filter-group="thresholds" data-filter-value="composite_pos" aria-pressed="false" data-i18n="filter_composite_pos">Composite &gt; 0</button>
      {#- filter-clear/filter-count live here, not inside the disclosure
          below: a reader who picks a full-set-only chip (e.g. Enter) then
          collapses More filters must still see that a filter is active
          and have a way to clear it. Their ids are unchanged, so
          _updateFilterCount()/_wireFilterChips()'s getElementById lookups
          need no changes — only their position moved. -#}
      <button type="button" class="filter-clear" id="filter-clear" hidden data-i18n="filter_clear">Clear</button>
      <span class="filter-count" id="filter-count"></span>
      {#- Native <details>, matching .rank-settings right beside it — same
          popover positioning (_sentiment.css.j2), same mobile full-width
          override (_responsive.css.j2), no new toggle JS needed. -#}
      <details class="more-filters">
        <summary data-i18n="more_filters">More filters</summary>
        <div class="filter-bar" id="leaderboard-filter-bar">
          {#- Hidden for guests when the badge is gated: these chips filter on
              data-setup, which is empty on every guest row, so leaving them up
              would offer a control that can only ever empty the table.
              applyHorizonBadges() owns the toggle. -#}
          <div class="filter-group" role="group" aria-label="Setup" id="filter-group-setup">
            <button type="button" class="filter-chip" data-filter-group="setup" data-filter-value="entry" aria-pressed="false" data-i18n="filter_entry">▲ Enter</button>
            <button type="button" class="filter-chip" data-filter-group="setup" data-filter-value="hold" aria-pressed="false" data-i18n="filter_hold">● Hold</button>
            <button type="button" class="filter-chip" data-filter-group="setup" data-filter-value="exit" aria-pressed="false" data-i18n="filter_exit">▼ Exit</button>
          </div>
          <div class="filter-group" role="group" aria-label="Trend">
            <button type="button" class="filter-chip" data-filter-group="trend" data-filter-value="rising" aria-pressed="false" data-i18n="filter_rising">↑ Rising</button>
            <button type="button" class="filter-chip" data-filter-group="trend" data-filter-value="flat" aria-pressed="false" data-i18n="filter_flat">→ Flat</button>
            <button type="button" class="filter-chip" data-filter-group="trend" data-filter-value="falling" aria-pressed="false" data-i18n="filter_falling">↓ Falling</button>
          </div>
          <div class="filter-group" role="group" aria-label="Threshold">
            <button type="button" class="filter-chip" data-filter-group="thresholds" data-filter-value="composite_pos" aria-pressed="false" data-i18n="filter_composite_pos">Composite &gt; 0</button>
            <button type="button" class="filter-chip" data-filter-group="thresholds" data-filter-value="top5" aria-pressed="false" data-i18n="filter_top5">Top 5</button>
            <button type="button" class="filter-chip" data-filter-group="thresholds" data-filter-value="change_pos" aria-pressed="false" data-i18n="filter_change_pos">Positive change</button>
          </div>
        </div>
      </details>
    </div>
    {#- Visible text rather than aria-label on a bare glyph: an aria-label would
        override the visible name for AT, and a control that silently re-ranks
        the board should say so on its face. -#}
    {#- Sentiment is alpha, so the control that blends it into the ranking is not
        rendered at all (build.SENTIMENT_RANKING_ENABLED). Not merely hidden: the
        wiring below early-returns when the control is absent, which is what
        stops a reader who once enabled it from having it silently re-applied
        from localStorage. A `display:none` would leave that path live. -#}
    {% if sentiment_ranking_enabled %}
    <details class="rank-settings">
      <summary><span class="rs-glyph" aria-hidden="true">⚙</span><span data-i18n="rank_settings">Ranking</span></summary>
      <div id="sentiment-control" class="sentiment-control">
        <label>
          <input type="checkbox" id="sentiment-toggle"> <span data-i18n="includeSentiment">Include sentiment in ranking</span>
        </label>
        <span class="sw-weight">
          <span data-i18n="weight">Weight:</span> <input type="number" id="sentiment-weight" min="0" max="100" step="1" value="30" disabled>%
        </span>
      </div>
    </details>
    {% endif %}
    <button type="button" class="tab-guide-btn" data-guide="guide_body_leaderboard" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div id="scan-digest-banner" class="digest-collapsed" style="display:none">
    <span class="digest-cluster" data-cluster="entries">
      <span data-i18n="digest_new_top5">New in Top 5:</span>
      <span class="digest-chips" id="digest-chips-entries"></span>
    </span>
    <span class="digest-toggle" role="button" tabindex="0" onclick="this.closest('#scan-digest-banner').classList.toggle('digest-collapsed'); this.textContent = this.textContent === 'more ▾' ? 'less ▴' : 'more ▾'" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}">more ▾</span>
    <span class="digest-cluster" data-cluster="up">
      <span data-i18n="digest_gains">Biggest gains:</span>
      <span class="digest-chips" id="digest-chips-up"></span>
    </span>
    <span class="digest-cluster" data-cluster="down">
      <span data-i18n="digest_drops">Biggest drops:</span>
      <span class="digest-chips" id="digest-chips-down"></span>
    </span>
  </div>
  <div id="scan-history-banner" style="display:none">
    <span class="scan-history-text" data-i18n="scan_viewing" data-en-prefix="Viewing scan #">Viewing scan #</span>
    <a href="javascript:void(0)" onclick="restoreLatest()" data-i18n="scan_back_to_latest">Back to latest</a>
  </div>
  <div class="table-wrap">
    <table id="leaderboard-table">
      <thead>
        <tr>
          {#- "Data" was dropped 2026-08-12 (with sentiment weighted 0 by default
              the composite IS the data score); "Sentiment" was dropped 2026-08-19
              with the 6-column restructure — sentiment is alpha and excluded from
              the ranking, so the column was "—" in every row. Level and Change
              merged into one stacked-bar cell in the same change. -#}
          <th scope="col" onclick="sortTable(0)" data-col="0" tabindex="0" data-i18n="col_rank">#</th>
          <th scope="col" onclick="sortTable(1)" data-col="1" tabindex="0" data-i18n="col_sector">Theme</th>
          <th scope="col" onclick="sortTable(2)" data-col="2" tabindex="0" data-i18n="col_composite">Composite</th>
          <th scope="col" onclick="sortTable(3)" data-col="3" tabindex="0" data-i18n="col_levelchange">Level / Change</th>
          <th scope="col" onclick="sortTable(4)" data-col="4" tabindex="0" data-i18n="col_rankdelta">Rank Δ</th>
        </tr>
      </thead>
      <tbody>
        {% for row in leaderboard_rows %}
        <tr class="leaderboard-row" data-sector-key="{{ row.key }}" data-sector-id="{{ row.sector_id }}" data-region="{{ row.region }}" data-sector="{{ row.sector }}" data-setup="{{ row.setup or '' }}" data-trend="{{ row.trajectory_state }}"{% if row.unbuyable %} data-unbuyable="1"{% endif %}
            data-composite="{{ row._raw_composite if row._raw_composite is not none else '' }}"
            data-change="{{ row._raw_change if row._raw_change is not none else '' }}"
            data-level="{{ row._raw_level if row._raw_level is not none else '' }}"
            data-rank="{{ row.rank }}"
            tabindex="0" aria-expanded="false">
          <td class="rank-cell{% if row.in_buy_band %} in-band-rail{% endif %}">
            <span class="rank-badge{% if row.in_buy_band %} in-buy-band{% endif %}{% if row.rank == 1 %} rank-1{% endif %}">{{ row.rank }}</span>
          </td>
          {#- Never "hold": the build has no reader and so no holdings. When the
              badge is gated, row.setup is None for everyone and applyHorizonBadges()
              writes the real badge once the session and holdings are known. -#}
          {#- Whitespace-controlled so the spans are emitted back-to-back with no
              text nodes between them: .theme-cell spaces them with margin alone
              (see _tables.css.j2), and a stray space would widen just the pairs
              this template happens to separate, leaving the baked rows spaced
              differently from the auth.js / scan-history.js ones. -#}
          <td class="theme-cell"
            >{#- -#}<span class="theme-name">{{ row.sector }}</span>{#-
            -#}{% if row.ticker %}<span class="theme-ticker">{{ row.ticker }}</span>{% endif %}{#-
            -#}{% if row.unbuyable %}<span class="unbuyable-badge" data-i18n="badge_unbuyable" data-i18n-title="unbuyable_tip" title="No UCITS equivalent exists, so this cannot be bought from an EU account. It is still scored because it shapes how every other theme ranks.">⊘ not buyable in EU</span>{% endif %}{#-
            -#}{% if row.setup == "entry" %}<span class="setup-badge entry" data-i18n="badge_entry">▲ Enter</span>{% elif row.setup == "exit" %}<span class="setup-badge exit" data-i18n="badge_exit">▼ Exit</span>{% endif %}{#-
            -#}<span class="traj-badge traj-{{ row.trajectory_state }}" data-i18n-title="trend_tip" title="Rank slope over last 3–5 scans"><span class="traj-glyph">{{ row.trajectory_label }}</span> <span class="traj-word">{{ row.trajectory_word }}</span></span>{#-
          -#}</td>
          <td class="composite-cell">{{ row.composite_bar | safe }}</td>
          <td data-sort-value="{{ row._raw_level if row._raw_level is not none else '' }}">{{ row.level_change_bars | safe }}</td>
          <td class="delta-cell">
            {% if row.arrow %}<span class="arrow {{ row.arrow_class }}">{{ row.arrow }}</span> {% endif %}{{ row.delta_rank }}
          </td>
        </tr>
        <tr class="breakdown-row" id="bd-{{ row.sector_id }}">
          <td colspan="5">{{ row.breakdown_html | safe }}</td>
        </tr>
        {% endfor %}
        {% if not has_any_rows %}
        <tr><td colspan="5" style="text-align:center;padding:24px;color:var(--fg4)" data-i18n="leaderboard_empty">No data available yet.</td></tr>
        {% endif %}
        <tr id="filter-no-match" style="display:none">
          <td colspan="5" style="text-align:center;padding:24px;color:var(--fg4)" data-i18n="filter_no_match">No themes match the filters.</td>
        </tr>
      </tbody>
    </table>
    {#- Populated client-side by renderMobileCards() from the table's own live
        DOM state — never baked, so it starts empty. See that function for
        why: a fourth independently-built row format (alongside rows.py,
        auth.js, scan-history.js) would need its own sort/filter/band-cut
        logic to stay working on mobile; reading the table instead needs
        none. -#}
    <div class="leaderboard-cards" id="leaderboard-cards" aria-hidden="true"></div>
  </div>
</section>

<!-- ============================================================
     Tab: RRG
     ============================================================ -->
<section id="tab-rrg" class="tab-panel" role="tabpanel">
  <p class="tab-note" data-i18n="note_sentiment">Sentiment weighting affects the leaderboard ranking only.</p>
  <div class="utility-row">
    <button type="button" class="tab-guide-btn" data-guide="guide_body_rrg" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div class="chart-container" id="rrg-chart" style="height:520px"></div>
</section>

<!-- ============================================================
     Tab: Drill-down
     ============================================================ -->
<section id="tab-drilldown" class="tab-panel" role="tabpanel">
  <div class="utility-row">
    <button type="button" class="tab-guide-btn" data-guide="guide_body_drilldown" data-i18n="guide_summary">How to read this tab</button>
  </div>
  <div class="drilldown-controls">
    <label for="sector-select">Theme:</label>
    <!-- Options are populated by JS (_populateDrilldownSelect) from
         COHORT_CHARTS[activeCohort].keys — the set of sector keys is
         per-cohort now, so a static Jinja loop can only ever render one
         cohort's options. -->
    <select class="sector-select" id="sector-select" onchange="updateDrilldown()"></select>
  </div>

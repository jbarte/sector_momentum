<!-- Tab guides. One modal, one body per tab, shown by data-guide key.
     Bodies live inside the modal (not cloned in on demand) so the i18n pass
     still finds every [data-i18n-html] node in the DOM at load and can swap
     EN/SV on all of them. -->
<div class="guide-overlay" id="guide-modal" hidden>
  <div class="guide-modal" role="dialog" aria-modal="true" aria-labelledby="guide-modal-title">
    <button type="button" class="guide-close" id="guide-close" aria-label="Close">&times;</button>
    {% include "_guide_illo.html.j2" %}
    <h2 id="guide-modal-title" data-i18n="guide_summary">How to read this tab</h2>
    {% include "_guide_market_context.html.j2" %}
    <div class="tab-guide-body" data-guide-body="guide_body_leaderboard" hidden data-i18n-html="guide_body_leaderboard">
            <p>Themes are ranked strongest to weakest. Everything is measured
               <strong>against the other themes today</strong>, not against zero — so
               rank 1 means &ldquo;best of these {{ leaderboard_rows | length }} right now&rdquo;, which in a bad week
               can still mean losing money.</p>

            <h3>Reading the Composite column</h3>
            <p>The composite blends how strong a theme is now with whether it is getting
               stronger. It is a <strong>z-score</strong>, which just measures
               unusualness:</p>
            <ul>
              <li><strong>0</strong> — dead average for the group.</li>
              <li><strong>+1.0</strong> — a standard deviation above average; roughly
                  better than 5 of 6 themes.</li>
              <li><strong>−1.0</strong> — the same distance below.</li>
            </ul>
            <p>Level and Change are the two halves. High Level with negative Change is a
               theme that has run and is now tiring. Low Level with positive Change is one
               that is still weak but turning up.</p>

            <h3>Horizon — start here</h3>
            <p>The <strong>Horizon</strong> selector at the top decides how patient the
               dashboard is. It changes which themes get flagged; it never changes the
               scores or the order.</p>
            <p>Both options review monthly; they differ in how much drift they
               tolerate. <strong>Medium</strong> holds 4 themes and sells once one
               leaves the top half of the universe. <strong>Long</strong> holds 5 and
               tolerates a much deeper fall before selling, so it trades about half as
               often — roughly 13 trades a year against 7. Long is not slower to react;
               it is more forgiving, and slightly more spread out. If you are unsure,
               leave it on Medium.</p>

            <h3>Enter, Hold, Exit — and no badge at all</h3>
            <p><strong>Badges are a signed-in feature.</strong> They combine the band with
               the holdings you have marked, so they say what there is to <em>do</em>
               rather than only where a theme sits:</p>
            <ul>
              <li><span class="signal-hi">▲ Enter</span> — inside the buy band for your
                  horizon, and you do not own it.</li>
              <li><strong>● Hold</strong> — you own it and it is still inside the band.
                  <strong>Do nothing.</strong> On a full book this is the most common
                  badge; a theme drifting a rank or two is normal noise, not a signal.</li>
              <li><span class="signal-lo">▼ Exit</span> — you own it and it has dropped
                  clearly out of the band. Not a wobble.</li>
              <li><strong>No badge</strong> — nothing to do. Either it is not in the buy
                  band and you do not own it, or it has fallen out of the band and you
                  never owned it.</li>
            </ul>
            <p>Mark what you hold with the ☆ beside a theme's name. Until you do, every
               theme in the buy band shows <span class="signal-hi">▲ Enter</span> — which
               is correct, because as far as the board knows you own nothing.</p>
            <p>The gap between Enter and Exit is deliberate. Without it, a theme bouncing
               between 5th and 6th place would have you buying and selling the same fund
               for no reason. Silence is the point.</p>
            <p><strong>An important quirk:</strong> the badge describes the band, not
               health. A theme falling hard but still ranked first shows
               <span class="signal-hi">▲ Enter</span>, because it is still the strongest
               thing on the board. That is what the Trend column is for.</p>

            <h3>Trend — the health check</h3>
            <p>The slope of a theme's rank over the last few scans. A falling rank
               <em>number</em> means it is climbing.</p>
            <ul>
              <li><span class="signal-hi">↑↑ Rising fast</span> / <span class="signal-hi">↑ Rising</span> — climbing the board.</li>
              <li>→ Flat — going nowhere in particular.</li>
              <li><span class="signal-lo">↓ Falling</span> / <span class="signal-lo">↓↓ Falling fast</span> — losing ground, even if the rank is still high.</li>
            </ul>
            <p>Read Trend <em>with</em> the badge. Enter plus ↑ is a theme arriving.
               Hold plus ↓↓ is one on its way out that has not fallen far enough to
               trigger an Exit yet.</p>

            {#- The "Market context chips" section moved to
                _guide_market_context.html.j2 on 2026-08-14: the chips render in the
                shared header, so their explanation had to be reachable from the
                Sentiment page too, and it is now opened by tapping the chips
                themselves. Kept as a pointer rather than duplicated copy. -#}
            <h3>Market context chips</h3>
            <p>The <strong>Live</strong>, <strong>SPY</strong> and <strong>VIX</strong>
               chips in the header describe the whole market, not any theme. They change
               no scores &mdash; they tell you how much to trust the board.
               <strong>Tap them</strong> for the full explanation.</p>

            <h3>Getting more detail</h3>
            <p>Click any row to expand it — you get every underlying signal, and the
               European (UCITS) fund that corresponds to the US ETF being scored.</p>
          </div>
    <div class="tab-guide-body" data-guide-body="guide_body_rrg" hidden data-i18n-html="guide_body_rrg">
            <p>Themes are plotted by <strong>relative strength vs benchmark</strong> (x-axis) and whether that relative strength is <strong>accelerating or decelerating</strong> (y-axis). Both axes are centred at 100.</p>
            <h3>Four quadrants</h3>
            <ul>
              <li><strong>Leading (top-right):</strong> Outperforming AND accelerating. Currently strong — but watch for rotation into Weakening.</li>
              <li><strong>Weakening (bottom-right):</strong> Outperforming but decelerating. <span class="signal-lo">Prime exit / reduce signal.</span></li>
              <li><strong>Lagging (bottom-left):</strong> Underperforming AND decelerating. Avoid.</li>
              <li><strong>Improving (top-left):</strong> Underperforming but accelerating. <span class="signal-hi">Prime entry signal</span> — themes typically rotate counter-clockwise from here into Leading.</li>
            </ul>
            <h3>How to use</h3>
            <p>Themes rotate Leading → Weakening → Lagging → Improving → Leading. Buy in <span class="signal-hi">Improving</span> before the move to Leading; sell in <span class="signal-lo">Weakening</span> before the drop to Lagging. Dotted tail lines show the last 3 scan positions — the direction of the tail matters more than the current position.</p>
            <p><em>Note: current axes are composite-based proxies. True JdK RS-Ratio/Momentum requires daily price data relative to a benchmark.</em></p>
          </div>
    <div class="tab-guide-body" data-guide-body="guide_body_drilldown" hidden data-i18n-html="guide_body_drilldown">
            <p>Select a theme to see its score component history across all stored scans.</p>
            <h3>Key patterns</h3>
            <ul>
              <li><span class="signal-hi">Composite rising + Change score rising:</span> sustained acceleration. Highest-conviction entry setup.</li>
              <li><span class="signal-lo">Composite near peak + Change score turning negative:</span> the theme is topping. Reduce or exit.</li>
              <li>Composite falling but Change score rising: bottoming process. Watch for a second consecutive scan confirming before entering.</li>
              <li>Level score and Change score diverging: momentum structure is breaking down — treat with caution.</li>
            </ul>
            <h3>How to use</h3>
            <p>Pair with the leaderboard Trend badge. A theme showing <span class="signal-hi">↑</span> on the leaderboard that also has rising composite and change_score in the drill-down is the highest-conviction setup. A theme with a high rank but flat or falling change_score is likely to slip in the next scan.</p>
          </div>
    <div class="tab-guide-body" data-guide-body="guide_body_movers" hidden data-i18n-html="guide_body_movers">
            <p>Rank change between the two most recent scans. <span class="signal-hi">Green bars</span> = themes that climbed the leaderboard; <span class="signal-lo">terracotta bars</span> = themes that slipped.</p>
            <h3>How to use</h3>
            <ul>
              <li>A single large positive move can be a data event rather than sustained momentum — confirm in the Drill-down tab before acting.</li>
              <li>Themes with 2+ consecutive large positive moves in the History tab carry more conviction than single-scan jumps.</li>
              <li><span class="signal-lo">Red flag:</span> a top-ranked theme with a large negative bar here is an early topping signal. Check the leaderboard Trend badge — if it shows <span class="signal-lo">↓</span> or <span class="signal-lo">↓↓</span>, the reversal is likely real.</li>
            </ul>
          </div>
    <div class="tab-guide-body" data-guide-body="guide_body_history" hidden data-i18n-html="guide_body_history">
            <p>Composite score trend across all stored scans for every theme. The composite is a cross-sectional z-score — 0 = cohort-average for that scan.</p>
            <h3>Key patterns</h3>
            <ul>
              <li><span class="signal-hi">Consistent upward slope:</span> quality momentum. The theme has been outperforming for multiple scans — this is the highest-quality signal.</li>
              <li><span class="signal-lo">Sharp spike then reversal:</span> likely a one-time data event, not sustainable momentum. Treat with caution.</li>
              <li>Gradual recovery from negative territory: potential emerging opportunity — cross-check the leaderboard Trend badge for confirmation.</li>
              <li>Flat around zero: theme in line with average; no edge.</li>
            </ul>
            <h3>How to use</h3>
            <p>Use as context for current rank. A theme ranked #1 after steadily rising for 10 scans is a different risk profile from one that jumped from #8 last scan. Long, smooth uptrends are the entries worth holding; V-shaped reversals are the ones to trade quickly or skip.</p>
          </div>
    <div class="tab-guide-body" data-guide-body="guide_body_backtest" hidden data-i18n-html="guide_body_backtest">
          <p>This asks a &ldquo;what if&rdquo; question: <em>had you followed these rules
             since 2008, what would have happened?</em> At each rebalance date the
             simulation buys the top-ranked themes, holds them under the band rule, and
             compares the result against the benchmark.</p>
          <p>It only ever uses information that existed on the day &mdash; no peeking at
             what came next.</p>

          <h3>The two rows</h3>
          <p>Each of the two rows is one horizon. Read the <strong>Trades/yr</strong> and
             <strong>Median hold</strong> columns next to the return, never on their own
             &mdash; a higher return that requires trading twice as often is not
             obviously better, and every trade costs something.</p>
          <ul>
            <li><strong>Strategy CAGR</strong> &mdash; the annual growth rate the rules
                produced. Compare it to <strong>Bench CAGR</strong> beside it; beating the
                benchmark is the whole point.</li>
            <li><strong>Sharpe</strong> &mdash; return earned per unit of bumpiness.
                Higher is better. It is the fairest single column for comparing rows,
                because it does not reward taking wild risks.</li>
            <li><strong>Max DD</strong> &mdash; the worst peak-to-trough fall along the
                way. A number like &minus;38% means that at some point this strategy was
                down 38% from its high. Ask yourself honestly whether you would have kept
                going.</li>
            <li><strong>Trades/yr</strong> and <strong>Median hold</strong> &mdash; how
                much work it is, and how long a position typically lasted.</li>
          </ul>

          <h3>What the chart shows</h3>
          <p>Growth of 1.0 &mdash; a single unit of money, tracked over time. The solid
             line is the strategy, the dashed line the benchmark. It follows whichever
             horizon you have selected. What matters is the <em>shape</em>: where the
             lines separate, and how deep the dips get.</p>

          <h3>Three reasons to discount these numbers</h3>
          <p>All three make the past look better than the future is likely to be:</p>
          <ul>
            <li><strong>The universe was chosen with hindsight.</strong> The simulation
                replays today&rsquo;s 18 themes backwards. Several of these ETFs did not
                exist in 2008, so the early years rest on fewer themes &mdash; and the
                list was picked knowing which ideas turned out to matter.</li>
            <li><strong>The settings were tuned on this same history.</strong> Many
                combinations were tested and good ones kept. Some of that edge is fitted
                to the past and will not repeat.</li>
            <li><strong>It assumes a perfect investor.</strong> Rules followed exactly,
                rebalances never missed, no second-guessing during a 38% drawdown.</li>
          </ul>
          <p>The honest use of this tab is <strong>comparing the horizons to each
             other</strong> &mdash; that comparison is fair, because both ran on the
             same data with the same biases. Treat the absolute returns as optimistic.</p>
        </div>
    <div class="tab-guide-body" data-guide-body="guide_body_correlation" hidden data-i18n-html="guide_body_correlation">
          <p>This grid answers one question: <strong>when one theme moves, do the others
             move with it?</strong> Every theme is compared against every other over the
             last 60 trading days.</p>
          <ul>
            <li><span class="signal-lo">Red</span> — these two move together. Owning both
                is close to owning one twice.</li>
            <li><span class="signal-hi">Blue / pale</span> — these two move independently.
                Owning both spreads your risk.</li>
          </ul>
          <p>The diagonal is always deep red: every theme is perfectly correlated with
             itself.</p>

          <h3>Why it matters</h3>
          <p>Holding five different-sounding themes feels diversified. If those five all
             glow red against each other, you effectively hold one position at five times
             the size — and a bad week for that trade hits all of it at once.</p>
          <p>This universe has a known cluster: the AI, semiconductor, quantum-computing
             and data-centre themes are largely the same trade under four names. They
             often appear near the top together, which is exactly when this tab is worth
             a look.</p>

          <h3>How to use it</h3>
          <ul>
            <li><strong>Bold labels</strong> mark the current top 5. Look at where bold
                rows and bold columns cross — that is your actual concentration.</li>
            <li>A red block among your top picks means the ranking is offering you the
                same bet several times.</li>
            <li>Pale cells between top picks mean genuinely different drivers.</li>
          </ul>
          <p>Correlation is backward-looking and <strong>rises in a crisis</strong> —
             when markets fall hard, most things fall together and the blue cells go red.
             Treat this as a normal-conditions guide, not a guarantee of protection when
             you most want it.</p>
          <p>One more limit: two themes can be uncorrelated and <em>both</em> be poor. Low
             correlation tells you they move differently, not that either is worth
             holding.</p>
        </div>
  </div>
</div>

<script>
{#- The canonical include on this page: _footer.html.j2 (alerts modal) and
    _methodology.html.j2 (methodology + tab-guide modals), both included
    later in this page, rely on window.SMModal already existing rather than
    re-including this partial themselves. Keep this include ahead of both in
    document order if either moves. -#}
{% include "_modal.js.j2" %}
/* Tab guides: one modal, bodies pre-rendered inside it and toggled by key.
   The bodies stay in the DOM (rather than being cloned in on open) so the i18n
   pass still sees every [data-i18n-html] node and can swap EN/SV on all of
   them, including guides for tabs the reader has not opened. */
(function () {
  var overlay = document.getElementById("guide-modal");
  if (!overlay) { return; }
  var modal = window.SMModal.bind(overlay, {
    closeBtn: document.getElementById("guide-close"),
  });
  if (!modal) { return; }

  var bodies = overlay.querySelectorAll("[data-guide-body]");
  var title = document.getElementById("guide-modal-title");

  function show(key, label) {
    Array.prototype.forEach.call(bodies, function (b) {
      b.hidden = b.getAttribute("data-guide-body") !== key;
    });
    // Mirror the trigger's own wording, so the sentiment page's "How is the
    // sentiment score calculated?" does not open a dialog titled "How to read
    // this tab". Falls back to the baked heading when a trigger has no label.
    if (title && label) { title.textContent = label; }
    modal.open();
  }

  document.addEventListener("click", function (e) {
    var btn = e.target.closest ? e.target.closest(".tab-guide-btn") : null;
    if (!btn) { return; }
    e.preventDefault();
    // data-guide-label wins over the trigger's text: the market-context chips
    // are a trigger whose visible text is live data ("SPY +10.1% VIX 14.6"),
    // which made a nonsense dialog heading. Text remains the default so every
    // existing "How to read this tab" / "How is the sentiment score
    // calculated?" button keeps mirroring its own wording.
    var labelEl = btn.querySelector ? btn.querySelector(".cc-label") : null;
    var label = labelEl ? labelEl.textContent.trim()
                        : (btn.textContent || "").trim();
    show(btn.getAttribute("data-guide"), label);
  });
})();
</script>


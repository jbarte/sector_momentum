<!DOCTYPE html>
<html lang="en">
<head>
{% include "_theme_init.html.j2" %}
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>ETF Momentum — Sentiment</title>
<script src="{{ plotly_bundle }}"></script>
<script src="assets/theme.js"></script>
<style>
{% include "_style.html.j2" %}
</style>
</head>
<body>

<a href="#main-content" class="skip-link" data-i18n="skip_to_content">Skip to content</a>

{#- FinBERT news-sentiment table (sectors only). -#}
{% macro sentiment_table(rows) %}
<div style="overflow-x:auto">
  <table>
    <thead>
      <tr>
        <th data-i18n="sent_col_sector">Theme</th>
        <th data-i18n="sent_col_news_polarity">Polarity</th>
        <th data-i18n="sent_col_news_count">Articles</th>
        <th data-i18n="sent_col_news_pos">Pos%</th>
        <th data-i18n="sent_col_news_neg">Neg%</th>
      </tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td>{{ r.sector }}</td>
        <td class="{% if r.news_polarity != '—' %}{% if r.news_polarity.startswith('+') %}signal-hi{% elif r.news_polarity.startswith('-') %}signal-lo{% endif %}{% endif %}">{{ r.news_polarity }}</td>
        <td>{{ r.news_count }}</td>
        <td>{{ r.news_positive_pct }}</td>
        <td>{{ r.news_negative_pct }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{#- Scatter footnote. -#}
{% macro scatter_footnote() %}
<p style="color:var(--fg4);font-size:0.8rem;padding:8px 0 0 4px" data-i18n-html="sentiment_footnote">
  Bottom-right quadrant (data ahead of sentiment) is the early-rotation zone.
  Hollow points = no news sentiment this scan (source unavailable).
  Sentiment is a confirming signal — noisy and news-driven.
  This is analytical tooling, not investment advice.
</p>
{% endmacro %}

<!-- Header -->
{% set active_segment = "sentiment" %}
{% include '_header.html.j2' %}

<main id="main-content" tabindex="-1">
<div class="card">
<section class="tab-panel active">
  {#- Was "Sentiment weighting affects the leaderboard ranking only", which
      stopped being true when the blend control was withdrawn: sentiment now
      affects nothing. -#}
  <p class="tab-note alpha-note" data-i18n-html="note_sentiment"><strong>Alpha.</strong>
     These readings are experimental and have not been validated. They are
     <strong>excluded from the composite score and from the ranking</strong> &mdash;
     nothing on the Themes board moves because of anything on this page. Shown for
     research only.</p>

  <div class="utility-row">
  <button type="button" class="tab-guide-btn" data-guide="guide_body_sentiment" data-i18n="guide_summary_sentiment">How is the sentiment score calculated?</button>
  </div>

  {% if sentiment_available %}
  <div class="chart-container" id="sentiment-scatter" style="height:560px"></div>
  {{ scatter_footnote() }}
  {% else %}
  <div class="chart-container" style="padding:48px 32px;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center">
    <p style="font-weight:600;color:var(--fg2);margin:0 0 8px" data-i18n="sentiment_empty_title">No news sentiment for this snapshot</p>
    <p style="color:var(--fg4);font-size:0.9rem;max-width:52ch;margin:0 auto" data-i18n="sentiment_empty_body">The news source (GDELT / FinBERT) recorded no sentiment for any theme in this scan — usually a temporary source outage or rate limit. Sentiment returns automatically once the source is reachable again; the leaderboard and other tabs are unaffected.</p>
  </div>
  {% endif %}
  {% if sentiment_signal_rows %}
  <h2 style="margin:24px 0 8px 4px" data-i18n="sent_news_heading">News sentiment</h2>
  {{ sentiment_table(sentiment_signal_rows) }}
  {% endif %}
</section>
</div>
</main>

<script>
var SENTIMENT_DATA = {{ sentiment_scatter_json | js_json }};

// Light->dark hex map for the baked Plotly figures (Task 7 consumes this).
var CHART_DARK = {{ chart_dark_json | js_json }};
window.CHART_DARK = CHART_DARK;

// Plot the scatter once the container is laid out.
(function () {
  if (!window.Plotly) return;
  var el = document.getElementById('sentiment-scatter');
  if (!el) return;
  SMTheme.smPlot(el, SENTIMENT_DATA);

  document.addEventListener('sm:theme-changed', function () {
    SMTheme.smPlot(el, SENTIMENT_DATA);
  });
})();

if (window.SMTheme) { window.SMTheme.initControl(); }

{% include "_i18n.html.j2" %}
</script>


<!-- Tab guides. One modal, one body per tab, shown by data-guide key.
     Bodies live inside the modal (not cloned in on demand) so the i18n pass
     still finds every [data-i18n-html] node in the DOM at load and can swap
     EN/SV on all of them. -->
<div class="guide-overlay" id="guide-modal" hidden>
  <div class="guide-modal" role="dialog" aria-modal="true" aria-labelledby="guide-modal-title">
    <button type="button" class="guide-close" id="guide-close" aria-label="Close">&times;</button>
    {% include "_guide_illo.html.j2" %}
    <h2 id="guide-modal-title" data-i18n="guide_summary">How to read this tab</h2>
    {% include "_guide_market_context.html.j2" %}
    <div class="tab-guide-body" data-guide-body="guide_body_sentiment" hidden data-i18n-html="guide_body_sentiment">
          <h3>Source — FinBERT news sentiment</h3>
          <p>The <strong>sentiment score</strong> is built from recent financial
             news. For each theme we fetch the latest 24&nbsp;hours of
             English-language headlines from the <strong>GDELT</strong> global news
             index (up to 250 per theme, matched on that theme&rsquo;s own keyword
             set). Each headline is scored by <strong>ProsusAI/finbert</strong>, a
             finance-tuned BERT model that classifies text as positive, negative or
             neutral with a confidence score. The per-theme <em>mean signed
             polarity</em> (positive&nbsp;=&nbsp;+score,
             negative&nbsp;=&nbsp;&minus;score, neutral&nbsp;=&nbsp;0) is then
             z-scored across the themes:
             <span class="signal-hi">positive = more bullish news vs peers</span>,
             <span class="signal-lo">negative = more bearish</span>.
             If FinBERT or GDELT is unavailable, the score is left blank for that
             scan.</p>
          <h3>Table columns</h3>
          <ul>
            <li><strong>Polarity</strong> — mean signed sentiment from recent news
                headlines. Green = bullish, red = bearish.</li>
            <li><strong>Articles</strong> — number of headlines scored.</li>
            <li><strong>Pos%</strong> — fraction classified as positive.</li>
            <li><strong>Neg%</strong> — fraction classified as negative.</li>
          </ul>
          <h3>It does not drive the ranking by default</h3>
          <p>The leaderboard composite is built from price/momentum signals only.
             Sentiment changes the ranking <em>only</em> when you enable the
             <strong>Sentiment toggle</strong>, at the weight you choose. Treat it as
             a confirmer, not a driver — news sentiment is noisy and can lag price.</p>
        </div>
  </div>
</div>

<script>
{% include "_modal.js.j2" %}
/* Tab guides: one modal, bodies pre-rendered inside it and toggled by key.
   The bodies stay in the DOM (rather than being cloned in on open) so the i18n
   pass still sees every [data-i18n-html] node and can swap EN/SV on all of
   them, including guides for tabs the reader has not opened. */
(function () {
  var overlay = document.getElementById("guide-modal");
  if (!overlay) { return; }
  var modal = window.SMModal.bind(overlay, {
    closeBtn: document.getElementById("guide-close"),
  });
  if (!modal) { return; }

  var bodies = overlay.querySelectorAll("[data-guide-body]");
  var title = document.getElementById("guide-modal-title");

  function show(key, label) {
    Array.prototype.forEach.call(bodies, function (b) {
      b.hidden = b.getAttribute("data-guide-body") !== key;
    });
    // Mirror the trigger's own wording, so the sentiment page's "How is the
    // sentiment score calculated?" does not open a dialog titled "How to read
    // this tab". Falls back to the baked heading when a trigger has no label.
    if (title && label) { title.textContent = label; }
    modal.open();
  }

  document.addEventListener("click", function (e) {
    var btn = e.target.closest ? e.target.closest(".tab-guide-btn") : null;
    if (!btn) { return; }
    e.preventDefault();
    // data-guide-label wins over the trigger's text: the market-context chips
    // are a trigger whose visible text is live data ("SPY +10.1% VIX 14.6"),
    // which made a nonsense dialog heading. Text remains the default so every
    // existing "How to read this tab" / "How is the sentiment score
    // calculated?" button keeps mirroring its own wording.
    var labelEl = btn.querySelector ? btn.querySelector(".cc-label") : null;
    var label = labelEl ? labelEl.textContent.trim()
                        : (btn.textContent || "").trim();
    show(btn.getAttribute("data-guide"), label);
  });
})();
</script>

{% include '_footer.html.j2' %}
{% include '_methodology.html.j2' %}

</body>
</html>
